---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { collections, getLatestNotes, notes } from '../data/notes';
import CarnetCTA from '../components/article/CarnetCTA.astro';

const latestNotes = getLatestNotes(4);

const collectionCount = (collectionId: string) =>
	notes.filter((note) => note.collectionId === collectionId).length;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`Notes de terrain | ${SITE_TITLE}`}
			description="Articles et retours d’expérience terrain autour du Vulnerability Management, de l’Endpoint Security et du Security Platform Engineering."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="page-hero">
				<div class="hero-content">
					<div class="hero-text">
						<p class="section-tag">NOTES DE TERRAIN</p>

						<h1>
							Retours d’expérience<br />
							cybersécurité
						</h1>

						<p class="intro">
							Des notes issues du terrain : programmes de Vulnerability Management,
							gestion de l’exposition, priorisation du risque, opérations de sécurité
							et environnements MSSP / RUN.
						</p>
					</div>
				</div>
			</section>

			<section class="stats-section" aria-label="Statistiques des Notes de Terrain">
				<div class="stats-grid">
					<div class="stat-card">
						<strong>{notes.length}</strong>
						<span>Notes de Terrain</span>
					</div>

					<div class="stat-card">
						<strong>{collections.length}</strong>
						<span>Collections thématiques</span>
					</div>

					<div class="stat-card">
						<strong>1</strong>
						<span>Nouvel article par semaine</span>
					</div>
				</div>
			</section>

			<section class="collections-section">
				<div class="section-header">
					<div>
						<p class="section-kicker">COLLECTIONS</p>
						<h2>Explorer par domaine</h2>
					</div>

					<p>
						Chaque collection développe un même sujet au fil de plusieurs
						observations et retours d’expérience.
					</p>
				</div>

				<div class="collections-grid">
					{
						collections.map((collection) => (
							<a
								href={`/notes-de-terrain/${collection.id}/`}
								class={`collection-card ${collection.className}`}
							>
								<div class="collection-image">
									<img src={collection.image} alt="" loading="lazy" />
								</div>

								<div class="collection-content">
									<div class="collection-heading">
										<h3>{collection.name}</h3>
										<span class="collection-count">
											{collectionCount(collection.id)} articles
										</span>
									</div>

									<p>{collection.description}</p>

									<span class="collection-link">
										Explorer la collection <span aria-hidden="true">→</span>
									</span>
								</div>
							</a>
						))
					}
				</div>
			</section>

			<section class="latest-section">
				<div class="section-header">
					<div>
						<p class="section-kicker">DERNIÈRES PUBLICATIONS</p>
						<h2>Les dernières Notes de Terrain</h2>
					</div>

					<p>
						Les publications les plus récentes, toutes collections confondues.
					</p>
				</div>

				<div class="latest-list">
					{
						latestNotes.map((note, index) => {
							const collection = collections.find(
								(item) => item.id === note.collectionId,
							);

							return (
								<a
									href={note.href}
									class={`latest-row ${collection?.className ?? ''}`}
								>
									<div class="note-id">
										<span>NOTE</span>
										<strong>{note.id.replace('NT-', '')}</strong>
									</div>

									<div class="latest-content">
										<div class="latest-title-line">
											<h3>{note.title}</h3>
											{index === 0 && <span class="latest-badge">Dernière note</span>}
										</div>

										<p>{note.description}</p>
									</div>

									<div class="latest-meta">
										<span>{collection?.shortName}</span>
										<span>{note.readTime} • {note.date}</span>
									</div>

									<span class="latest-arrow" aria-hidden="true">→</span>
								</a>
							);
						})
					}
				</div>
			</section>
			<CarnetCTA />
		</main>

		<Footer />
	</body>
</html>

<style>
	body {
		background: #f8fafc;
	}

	main {
		width: min(1500px, calc(100% - 4rem));
		margin: 0 auto;
		padding: 0 0 5rem;
	}

	.page-hero {
		margin-top: 2rem;
		margin-bottom: 2.25rem;
		padding: 5rem;
		border-radius: 32px;
		background:
			linear-gradient(rgba(2, 8, 23, 0.78), rgba(2, 8, 23, 0.78)),
			url('/Images/fondsite.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		color: white;
		box-shadow: 0 25px 60px rgba(2, 8, 23, 0.2);
		overflow: hidden;
	}

	.section-tag,
	.section-kicker {
		color: #60a5fa;
		font-weight: 800;
		font-size: 0.85rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 1000px;
		margin: 1rem 0 2rem;
		color: white;
		font-size: 5rem;
		line-height: 0.95;
		letter-spacing: -0.05em;
	}

	.intro {
		max-width: 900px;
		color: #dbeafe;
		font-size: 1.3rem;
		line-height: 1.8;
	}

	.stats-section {
		margin-bottom: 3.25rem;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.stat-card {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 1.5rem 1.75rem;
		background: white;
		border: 1px solid #e5e7eb;
		border-radius: 20px;
		box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
	}

	.stat-card strong {
		color: #0f172a;
		font-size: 2.4rem;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.stat-card span {
		color: #64748b;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.collections-section {
		margin-bottom: 3.5rem;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 2rem;
		margin-bottom: 1.6rem;
	}

	.section-header h2 {
		margin: 0.35rem 0 0;
		font-size: 3rem;
		letter-spacing: -0.04em;
	}

	.section-header > p {
		max-width: 480px;
		margin: 0;
		color: #64748b;
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.collections-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
	}

	.collection-card,
	.latest-row {
		--category-color: #2563eb;
		--category-background: rgba(37, 99, 235, 0.1);
		--category-border: rgba(37, 99, 235, 0.24);
		--category-shadow: rgba(37, 99, 235, 0.16);
	}

	.collection-card {
		display: flex;
		flex-direction: column;
		min-height: 410px;
		overflow: hidden;
		background: white;
		border: 1px solid #e5e7eb;
		border-radius: 24px;
		color: inherit;
		text-decoration: none;
		box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.collection-card:hover {
		transform: translateY(-4px);
		border-color: var(--category-border);
		box-shadow:
			0 20px 50px rgba(15, 23, 42, 0.12),
			0 12px 30px var(--category-shadow);
	}

	.collection-image {
		height: 180px;
		overflow: hidden;
		background: #020817;
	}

	.collection-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.collection-card:hover .collection-image img {
		transform: scale(1.025);
	}

	.collection-content {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.5rem;
	}

	.collection-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.15rem;
	}

	.collection-heading h3 {
		display: inline-flex;
		width: fit-content;
		margin: 0;
		padding: 0.55rem 0.95rem;
		border: 1px solid var(--category-border);
		border-radius: 999px;
		background: var(--category-background);
		color: var(--category-color);
		font-size: 0.78rem;
		font-weight: 900;
		line-height: 1;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.collection-count {
		color: #64748b;
		font-size: 0.78rem;
		font-weight: 800;
		white-space: nowrap;
	}

	.collection-card p {
		margin: 0 0 1.5rem;
		color: #475569;
		line-height: 1.65;
	}

	.collection-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: auto;
		color: var(--category-color);
		font-size: 0.88rem;
		font-weight: 850;
	}

	.latest-list {
		overflow: hidden;
		background: white;
		border: 1px solid #e5e7eb;
		border-radius: 24px;
		box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
	}

	.latest-row {
		display: grid;
		grid-template-columns: 3.25rem minmax(0, 1fr) auto auto;
		align-items: center;
		gap: 1.25rem;
		min-height: 104px;
		padding: 1.05rem 1.4rem;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid #eef2f7;
		transition: background 0.2s ease;
	}

	.latest-row:last-child {
		border-bottom: 0;
	}

	.latest-row:hover {
		background: #f8fbff;
	}

	.note-id {
		display: grid;
		place-items: center;
		align-content: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 13px;
		color: var(--category-color);
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.96), var(--category-background));
		border: 1px solid var(--category-border);
		line-height: 1;
	}

	.note-id span {
		font-size: 0.52rem;
		font-weight: 900;
		letter-spacing: 0.1em;
	}

	.note-id strong {
		margin-top: 0.18rem;
		font-size: 0.9rem;
		font-weight: 900;
	}

	.latest-title-line {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.latest-content h3 {
		margin: 0;
		color: #0f172a;
		font-size: 1.1rem;
		line-height: 1.35;
	}

	.latest-content p {
		margin: 0.4rem 0 0;
		color: #64748b;
		font-size: 0.84rem;
		line-height: 1.5;
	}

	.latest-badge {
		display: inline-flex;
		padding: 0.28rem 0.55rem;
		border: 1px solid var(--category-border);
		border-radius: 999px;
		background: var(--category-background);
		color: var(--category-color);
		font-size: 0.58rem;
		font-weight: 900;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.latest-meta {
		display: grid;
		gap: 0.25rem;
		min-width: 150px;
		color: #64748b;
		text-align: right;
		font-size: 0.78rem;
		font-weight: 700;
	}

	.latest-arrow {
		color: var(--category-color);
		font-size: 1.25rem;
		font-weight: 900;
		transition: transform 0.2s ease;
	}

	.latest-row:hover .latest-arrow {
		transform: translateX(4px);
	}

	.category-vm {
		--category-color: #2563eb;
		--category-background: rgba(37, 99, 235, 0.1);
		--category-border: rgba(37, 99, 235, 0.24);
		--category-shadow: rgba(37, 99, 235, 0.18);
	}

	.category-endpoint {
		--category-color: #dc2626;
		--category-background: rgba(220, 38, 38, 0.1);
		--category-border: rgba(220, 38, 38, 0.24);
		--category-shadow: rgba(220, 38, 38, 0.18);
	}

	.category-engineering {
		--category-color: #7c3aed;
		--category-background: rgba(124, 58, 237, 0.1);
		--category-border: rgba(124, 58, 237, 0.24);
		--category-shadow: rgba(124, 58, 237, 0.18);
	}

	@media (max-width: 1100px) {
		.collections-grid {
			grid-template-columns: 1fr;
		}

		.collection-card {
			display: grid;
			grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
			min-height: 0;
		}

		.collection-image {
			height: 100%;
			min-height: 260px;
		}
	}

	@media (max-width: 768px) {
		main {
			width: min(100% - 2rem, 1500px);
		}

		.page-hero {
			padding: 3rem 2rem;
		}

		h1 {
			font-size: 3rem;
		}

		.stats-grid {
			grid-template-columns: 1fr;
		}

		.section-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.collection-card {
			display: flex;
		}

		.collection-image {
			height: 200px;
			min-height: 0;
		}

		.latest-row {
			grid-template-columns: 3.25rem minmax(0, 1fr) auto;
		}

		.latest-meta {
			display: none;
		}
	}

	@media (max-width: 520px) {
		.page-hero {
			margin-bottom: 1.75rem;
		}

		.latest-row {
			grid-template-columns: 3.25rem minmax(0, 1fr);
		}

		.latest-arrow {
			display: none;
		}

		.latest-content p {
			display: none;
		}
	}
</style>

---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import platformHeroImage from '../../assets/home/plateforme-figee.png';
import vmHeroImage from '../../assets/collections/remediation-vm.png';
import endpointHeroImage from '../../assets/collections/edr-console-angles-morts.png';
import {
	collections,
	getNotesByCollection,
	type NoteCollection,
	type TerrainNote,
} from '../../data/notes';

export function getStaticPaths() {
	return collections.map((collection) => ({
		params: { collection: collection.id },
		props: {
			collection,
			notes: getNotesByCollection(collection.id),
		},
	}));
}

interface Props {
	collection: NoteCollection;
	notes: TerrainNote[];
}

const { collection, notes } = Astro.props;

const collectionHeroAssets: Record<string, ImageMetadata> = {
    'security-platform-engineering': platformHeroImage,
    'vulnerability-management': vmHeroImage,
    'endpoint-security': endpointHeroImage,
};

const heroSource = collectionHeroAssets[collection.id];

const optimizedHero = await getImage({
    src: heroSource,
    width: 1320,
    quality: 82,
    format: 'webp',
});
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`${collection.name} | Notes de terrain | ${SITE_TITLE}`}
			description={collection.longDescription}
		/>
	</head>

	<body>
		<Header />

		<main class={collection.className}>
			<nav class="breadcrumb" aria-label="Fil d’Ariane">
				<a href="/notes-de-terrain/">Notes de Terrain</a>
				<span aria-hidden="true">→</span>
				<span>{collection.name}</span>
			</nav>

			<section
				class="collection-hero"
				style={`--collection-hero-image: url('${optimizedHero.src}')`}
			>
				<div class="collection-hero-overlay" aria-hidden="true"></div>

				<div class="collection-hero-content">
					<p class="eyebrow">COLLECTION</p>
					<h1>{collection.name}</h1>
					<p>{collection.longDescription}</p>

					<div class="collection-meta">
						<strong>{notes.length}</strong>
						<span>{notes.length > 1 ? 'Notes de Terrain' : 'Note de Terrain'}</span>
					</div>
				</div>
			</section>

			<section class="notes-section">
				<div class="section-header">
					<div>
						<p class="section-kicker">PUBLICATIONS</p>
						<h2>Toutes les Notes de la collection</h2>
					</div>

					<a href="/notes-de-terrain/" class="all-collections">
						Voir toutes les collections →
					</a>
				</div>

				<div class="notes-list">
					{
						notes.map((note, index) => (
							<a href={note.href} class="note-row">
								<div class="note-id">
									<span>NOTE</span>
									<strong>{note.id.replace('NT-', '')}</strong>
								</div>

								<div class="note-content">
									<div class="note-title-line">
										<h3>{note.title}</h3>
										{index === 0 && <span class="latest-badge">Plus récente</span>}
									</div>

									<p>{note.description}</p>
								</div>

								<div class="note-meta">
									<span>{note.readTime}</span>
									<span>{note.date}</span>
								</div>

								<span class="note-arrow" aria-hidden="true">→</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="collection-navigation">
				<p>Explorer une autre collection</p>

				<div class="collection-links">
					{
						collections
							.filter((item) => item.id !== collection.id)
							.map((item) => (
								<a
									href={`/notes-de-terrain/${item.id}/`}
									class={item.className}
								>
									<span>{item.name}</span>
									<strong>→</strong>
								</a>
							))
					}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	body {
		background: #f8fafc;
	}

	main {
		--category-color: #2563eb;
		--category-background: rgba(37, 99, 235, 0.1);
		--category-border: rgba(37, 99, 235, 0.24);
		width: min(1320px, calc(100% - 4rem));
		margin: 0 auto;
		padding: 2rem 0 5rem;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 1.5rem;
		color: #64748b;
		font-size: 0.84rem;
		font-weight: 700;
	}

	.breadcrumb a {
		color: #475569;
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--category-color);
	}

	.collection-hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 430px;
		overflow: hidden;
		margin-bottom: 4rem;
		padding: 4.75rem;
		border-radius: 32px;
		background:
			linear-gradient(90deg, rgba(2, 8, 23, 0.98) 0%, rgba(2, 8, 23, 0.94) 44%, rgba(2, 8, 23, 0.66) 72%, rgba(2, 8, 23, 0.82) 100%),
			var(--collection-hero-image);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		color: white;
		box-shadow: 0 25px 60px rgba(2, 8, 23, 0.2);
	}

	.collection-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 78% 45%, color-mix(in srgb, var(--category-color) 22%, transparent), transparent 38%),
			linear-gradient(180deg, transparent 0%, rgba(2, 8, 23, 0.22) 100%);
		pointer-events: none;
	}

	.collection-hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(2, 8, 23, 0.16), transparent 55%),
			linear-gradient(180deg, rgba(2, 8, 23, 0.06), rgba(2, 8, 23, 0.28));
		pointer-events: none;
	}

	.collection-hero-content {
		position: relative;
		z-index: 1;
		max-width: 760px;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: #60a5fa;
		font-size: 0.76rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.85rem 0 1.3rem;
		color: white;
		font-size: 4.5rem;
		line-height: 0.98;
		letter-spacing: -0.05em;
	}

	.collection-hero-content > p:not(.eyebrow) {
		margin: 0;
		max-width: 760px;
		color: #dbeafe;
		font-size: 1.08rem;
		line-height: 1.85;
	}

	.collection-meta {
		display: flex;
		align-items: baseline;
		gap: 0.65rem;
		width: fit-content;
		margin-top: 2rem;
		padding: 0.75rem 1rem;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid color-mix(in srgb, var(--category-color) 55%, rgba(255, 255, 255, 0.18));
		border-radius: 16px;
		color: white;
		backdrop-filter: blur(10px);
	}

	.collection-meta strong {
		font-size: 1.65rem;
	}

	.collection-meta span {
		font-size: 0.8rem;
		font-weight: 800;
	}

	.section-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 1.5rem;
	}

	.section-header h2 {
		margin: 0.35rem 0 0;
		color: #0f172a;
		font-size: 2.65rem;
		letter-spacing: -0.04em;
	}

	.all-collections {
		color: #64748b;
		font-size: 0.84rem;
		font-weight: 800;
		text-decoration: none;
	}

	.all-collections:hover {
		color: var(--category-color);
	}

	.notes-list {
		overflow: hidden;
		background: white;
		border: 1px solid #e5e7eb;
		border-radius: 24px;
		box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
	}

	.note-row {
		display: grid;
		grid-template-columns: 3.25rem minmax(0, 1fr) auto auto;
		align-items: center;
		gap: 1.25rem;
		min-height: 112px;
		padding: 1.2rem 1.4rem;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid #eef2f7;
		transition: background 0.2s ease;
	}

	.note-row:last-child {
		border-bottom: 0;
	}

	.note-row:hover {
		background: #f8fbff;
	}

	.note-id {
		display: grid;
		place-items: center;
		align-content: center;
		width: 3.25rem;
		height: 3.25rem;
		border: 1px solid var(--category-border);
		border-radius: 13px;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.96), var(--category-background));
		color: var(--category-color);
		line-height: 1;
	}

	.note-id span {
		font-size: 0.52rem;
		font-weight: 900;
		letter-spacing: 0.1em;
	}

	.note-id strong {
		margin-top: 0.18rem;
		font-size: 0.9rem;
		font-weight: 900;
	}

	.note-title-line {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.note-content h3 {
		margin: 0;
		color: #0f172a;
		font-size: 1.12rem;
		line-height: 1.35;
	}

	.note-content p {
		margin: 0.4rem 0 0;
		color: #64748b;
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.latest-badge {
		display: inline-flex;
		padding: 0.28rem 0.55rem;
		border: 1px solid var(--category-border);
		border-radius: 999px;
		background: var(--category-background);
		color: var(--category-color);
		font-size: 0.58rem;
		font-weight: 900;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.note-meta {
		display: grid;
		gap: 0.25rem;
		min-width: 90px;
		color: #64748b;
		text-align: right;
		font-size: 0.78rem;
		font-weight: 700;
	}

	.note-arrow {
		color: var(--category-color);
		font-size: 1.25rem;
		font-weight: 900;
		transition: transform 0.2s ease;
	}

	.note-row:hover .note-arrow {
		transform: translateX(4px);
	}

	.collection-navigation {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid #e5e7eb;
	}

	.collection-navigation > p {
		margin: 0 0 1rem;
		color: #64748b;
		font-size: 0.82rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.collection-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.collection-links a {
		--category-color: #2563eb;
		--category-background: rgba(37, 99, 235, 0.1);
		--category-border: rgba(37, 99, 235, 0.24);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--category-border);
		border-radius: 16px;
		background: white;
		color: var(--category-color);
		text-decoration: none;
		font-weight: 850;
	}

	.category-vm {
		--category-color: #2563eb;
		--category-background: rgba(37, 99, 235, 0.1);
		--category-border: rgba(37, 99, 235, 0.24);
	}

	.category-endpoint {
		--category-color: #dc2626;
		--category-background: rgba(220, 38, 38, 0.1);
		--category-border: rgba(220, 38, 38, 0.24);
	}

	.category-engineering {
		--category-color: #7c3aed;
		--category-background: rgba(124, 58, 237, 0.1);
		--category-border: rgba(124, 58, 237, 0.24);
	}

	@media (max-width: 900px) {
		.collection-hero {
			min-height: 390px;
			padding: 3.5rem;
			background-position: center;
		}

		h1 {
			font-size: 3.5rem;
		}
	}

	@media (max-width: 720px) {
		main {
			width: min(100% - 2rem, 1320px);
		}

		.collection-hero {
			min-height: 360px;
			padding: 2.5rem 2rem;
		}

		.collection-hero-content {
			max-width: 100%;
		}

		.section-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.note-row {
			grid-template-columns: 3.25rem minmax(0, 1fr) auto;
		}

		.note-meta {
			display: none;
		}

		.collection-links {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 520px) {
		h1 {
			font-size: 2.7rem;
		}

		.note-row {
			grid-template-columns: 3.25rem minmax(0, 1fr);
		}

		.note-arrow,
		.note-content p {
			display: none;
		}
	}
</style>

---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`Bienvenue dans le Carnet de Terrain | ${SITE_TITLE}`}
			description="Votre inscription au Carnet de Terrain est confirmée."
		/>
		<meta name="robots" content="noindex, follow" />
	</head>

	<body>
		<Header />

		<main>
			<section class="welcome-hero">
				<div class="hero-copy">
					<p class="eyebrow">LE CARNET DE TERRAIN</p>

					<h1>Bienvenue.</h1>

					<p class="hero-lead">
						Votre inscription est maintenant confirmée.
					</p>

					<p class="hero-text">
						Chaque semaine, je partagerai ce que le terrain m’a appris :
						des retours d’expérience, des analyses techniques et des
						réflexions d’ingénieur.
					</p>

					<div class="hero-actions">
						<a href="/notes-de-terrain/" class="primary">
							Découvrir les Notes de Terrain
							<span aria-hidden="true">→</span>
						</a>

						<a href="/" class="secondary">Retour à l’accueil</a>
					</div>
				</div>

				<div class="hero-visual" aria-hidden="true">
					<img
						src="/Images/carnet-de-terrain.png"
						alt=""
						width="1024"
						height="1024"
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
			</section>

			<section class="closing-section">
				<h2>
					La prochaine édition du Carnet de Terrain arrivera bientôt dans votre boîte mail.
				</h2>

				<p class="closing-text">
					En attendant, découvrez les dernières Notes de Terrain.
				</p>

				<div class="closing-signature">
					<span>À très bientôt,</span>
					<strong>Marc</strong>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background: #f8fafc;
	}

	main {
		width: min(1320px, calc(100% - 4rem));
		margin: 0 auto;
		padding: 2rem 0 5rem;
	}

	.welcome-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
		align-items: center;
		min-height: 540px;
		overflow: hidden;
		padding: 4.75rem;
		color: #ffffff;
		background:
			radial-gradient(circle at 76% 46%, rgba(37, 99, 235, 0.24), transparent 34%),
			linear-gradient(135deg, #020817 0%, #06142d 48%, #031b4d 100%);
		border-radius: 32px;
		box-shadow: 0 25px 60px rgba(2, 8, 23, 0.2);
	}

	.welcome-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: linear-gradient(to right, transparent 10%, black 64%, black);
		pointer-events: none;
	}

	.hero-copy,
	.hero-visual {
		position: relative;
		z-index: 1;
	}

	.hero-copy {
		max-width: 720px;
	}

	.eyebrow {
		margin: 0;
		color: #60a5fa;
		font-size: 0.76rem;
		font-weight: 900;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	h1 {
		margin: 1rem 0 1.35rem;
		color: white;
		font-size: clamp(4rem, 8vw, 6.6rem);
		line-height: 0.92;
		letter-spacing: -0.065em;
	}

	.hero-lead {
		margin: 0;
		color: #ffffff;
		font-size: 1.14rem;
		font-weight: 820;
	}

	.hero-text {
		max-width: 650px;
		margin: 1.1rem 0 0;
		color: #dbeafe;
		font-size: 1rem;
		line-height: 1.8;
	}

	.hero-actions {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}

	.hero-actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 48px;
		padding: 0.85rem 1.1rem;
		font-size: 0.84rem;
		font-weight: 850;
		text-decoration: none;
		border-radius: 12px;
		transition:
			transform 0.18s ease,
			background 0.18s ease,
			border-color 0.18s ease;
	}

	.hero-actions a:hover {
		transform: translateY(-1px);
	}

	.hero-actions .primary {
		color: #ffffff;
		background: #2563eb;
		border: 1px solid #2563eb;
		box-shadow: 0 12px 24px rgba(37, 99, 235, 0.22);
	}

	.hero-actions .primary:hover {
		background: #1d4ed8;
		border-color: #1d4ed8;
	}

	.hero-actions .secondary {
		color: #e2e8f0;
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.28);
	}

	.hero-actions .secondary:hover {
		color: white;
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.5);
	}

	.hero-visual {
		display: grid;
		place-items: center;
		min-width: 0;
	}

	.hero-visual img {
		display: block;
		width: min(100%, 470px);
		height: auto;
		filter: drop-shadow(0 28px 60px rgba(0, 0, 0, 0.38));
		transform: translateX(1.5rem);
	}

	.closing-section {
		margin-top: 2rem;
		padding: 3.25rem 2rem;
		text-align: center;
		background:
			linear-gradient(180deg, #ffffff 0%, #fcfdff 100%);
		border: 1px solid #e7edf7;
		border-radius: 24px;
		box-shadow: 0 12px 32px rgba(15, 23, 42, 0.045);
	}

	.closing-section h2 {
	max-width: 860px;
	margin: 0 auto;
	color: #0f172a;
	font-size: clamp(1.65rem, 3vw, 2.35rem);
	font-weight: 800;
	line-height: 1.2;
	letter-spacing: -0.025em;
}

	.closing-text {
		max-width: 760px;
		margin: 1rem auto 0;
		color: #64748b;
		font-size: 1rem;
		line-height: 1.7;
	}

	.closing-signature {
		display: grid;
		gap: 0.25rem;
		margin-top: 1.5rem;
		color: #64748b;
		font-size: 1rem;
		line-height: 1.25;
	}

	.closing-signature strong {
		color: #0f172a;
		font-size: 1.05rem;
		font-weight: 700;
	}

	@media (max-width: 980px) {
		.welcome-hero {
			grid-template-columns: 1fr;
			min-height: 0;
		}

		.hero-visual {
			margin-top: 2.5rem;
		}

		.hero-visual img {
			width: min(100%, 420px);
			transform: none;
		}
	}

	@media (max-width: 620px) {
		main {
			width: min(100% - 2rem, 1320px);
			padding: 1rem 0 3rem;
		}

		.welcome-hero {
			padding: 2.75rem 2rem;
			border-radius: 24px;
		}

		h1 {
			font-size: clamp(3.6rem, 18vw, 5rem);
		}

		.hero-actions {
			flex-direction: column;
		}

		.hero-actions a {
			width: 100%;
		}

		.hero-visual {
			display: none;
		}

		.closing-section {
			margin-top: 1.25rem;
			padding: 2.5rem 1.5rem;
			border-radius: 20px;
		}

		.closing-section h2 {
	font-size: clamp(1.5rem, 7vw, 1.9rem);
}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-actions a {
			transition: none;
		}

		.hero-actions a:hover {
			transform: none;
		}
	}
</style>

---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/labs/ioc/Hero.astro';
import ResultLayout from '../../components/labs/ioc/ResultLayout.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead
      title={`MM IOC Analyzer | ${SITE_TITLE}`}
      description="Extrayez, normalisez et structurez des IOC localement pour accélérer vos investigations de sécurité."
    />
  </head>
  <body>
    <Header />
    <main class="ioc-page">
      <Hero />
      <ResultLayout />
    </main>
    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    color: #f8fafc;
    background:
      radial-gradient(circle at 16% 0%, rgba(37, 99, 235, 0.1), transparent 31rem),
      linear-gradient(180deg, #030712 0%, #020611 100%);
  }

  .ioc-page {
    position: relative;
    width: min(1440px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 2.5rem 0 5rem;
  }

  .ioc-page::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    pointer-events: none;
    opacity: 0.24;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.018) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 68%);
  }

  @media (max-width: 700px) {
    .ioc-page {
      width: calc(100% - 1rem);
      padding-top: 1rem;
    }
  }
</style>

<style is:global>
  :root { color-scheme: dark; }
  [data-result-content]:not([hidden]) > * {
    animation: iocReveal 0.42s cubic-bezier(.2,.7,.2,1) both;
  }
  [data-result-content]:not([hidden]) > *:nth-child(2) { animation-delay: .05s; }
  [data-result-content]:not([hidden]) > *:nth-child(3) { animation-delay: .10s; }
  [data-result-content]:not([hidden]) > *:nth-child(4) { animation-delay: .15s; }
  @keyframes iocReveal {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-result-content]:not([hidden]) > * { animation: none !important; }
  }
</style>

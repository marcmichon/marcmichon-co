---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SuiteIdentity from '../../components/labs/SuiteIdentity.astro';
import PasswordGenerator from '../../components/labs/password/PasswordGenerator.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`Password Generator | ${SITE_TITLE}`}
			description="Générez localement des mots de passe robustes et des passphrases à l’aide d’un générateur cryptographique."
		/>
	</head>

	<body>
		<Header />

		<main class="password-page">
			<section class="utility-hero">
				<SuiteIdentity mode="Utility" tone="blue" />

				<h1>
					<span>MM </span>Password Generator
				</h1>

				<p>
					Générez des mots de passe robustes ou des passphrases sécurisées
					avec une source aléatoire cryptographique.
				</p>

				<div class="method-box">
					<span>Méthode de génération</span>
					<strong>Le navigateur utilise <code>crypto.getRandomValues()</code>.</strong>
					<p>Aucune donnée n’est transmise, stockée ou conservée dans un historique.</p>
				</div>
			</section>

			<PasswordGenerator />
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
	}

	body {
		margin: 0;
		background: #f8fafc;
		color: #0f172a;
	}

	.password-page {
		width: min(1180px, calc(100% - 4rem));
		margin: 0 auto;
		padding: 3rem 0 5rem;
	}

	.utility-hero {
		position: relative;
		width: 100%;
		max-width: none;
		box-sizing: border-box;
		margin-bottom: 2.5rem;
		padding: 4rem;
		overflow: hidden;
		border-radius: 34px;
		color: white;
		background:
			radial-gradient(circle at 80% 0%, rgba(37, 99, 235, 0.28), transparent 35%),
			linear-gradient(135deg, #020817 0%, #06142d 55%, #031b4d 100%);
		box-shadow: 0 25px 70px rgba(2, 8, 23, 0.2);
	}

	.utility-hero::after {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: .1;
		background-image:
			linear-gradient(rgba(255, 255, 255, .05) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, .05) 1px, transparent 1px);
		background-size: 44px 44px;
		mask-image: linear-gradient(to right, black, transparent 78%);
	}

	.utility-hero > * {
		position: relative;
		z-index: 1;
	}

	.utility-hero h1 {
		margin: 1rem 0 .8rem;
		color: #ffffff !important;
		-webkit-text-fill-color: #ffffff !important;
		font-size: clamp(2.35rem, 5vw, 4.35rem);
		line-height: .98;
		letter-spacing: -.055em;
	}

	.utility-hero h1 span {
		color: #3b82f6 !important;
		-webkit-text-fill-color: #3b82f6 !important;
	}

	.utility-hero > p {
		max-width: 760px;
		margin: 0;
		color: #ffffff;
		font-size: .95rem;
		font-weight: 600;
		line-height: 1.65;
	}

	.method-box {
		max-width: 850px;
		margin-top: 1.75rem;
		padding: 1rem 1.2rem;
		border: 1px solid rgba(147, 197, 253, 0.28);
		border-left: 4px solid #60a5fa;
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.07);
		backdrop-filter: blur(10px);
	}

	.method-box span {
		display: block;
		color: #93c5fd;
		font-size: .66rem;
		font-weight: 900;
		letter-spacing: .08em;
		text-transform: uppercase;
	}

	.method-box strong {
		display: block;
		margin-top: .45rem;
		color: #ffffff;
		font-size: .78rem;
	}

	.method-box p {
		margin: .3rem 0 0;
		color: #dbeafe;
		font-size: .72rem;
		line-height: 1.5;
	}

	.method-box code {
		padding: 0;
		background: transparent !important;
		color: #93c5fd !important;
		-webkit-text-fill-color: #93c5fd !important;
		font-size: inherit;
		box-shadow: none !important;
	}

	@media (max-width: 900px) {
		.password-page {
			width: min(100% - 2rem, 1180px);
		}

		.utility-hero {
			padding: 2.75rem 2rem;
			border-radius: 26px;
		}
	}

	@media (max-width: 640px) {
		.password-page {
			width: min(100% - 1.25rem, 1180px);
			padding-top: 1.5rem;
		}

		.utility-hero {
			padding: 2.25rem 1.35rem;
			border-radius: 22px;
		}
	}
</style>

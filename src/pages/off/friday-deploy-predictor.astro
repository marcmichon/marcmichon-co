---
import OffLayout from '../../layouts/OffLayout.astro';
import OffBackLink from '../../components/off/OffBackLink.astro';
import OffBadge from '../../components/off/OffBadge.astro';
---

<OffLayout
	title="Friday Deploy Predictor | EN OFF"
	description="Évalue objectivement tes chances de passer un week-end tranquille."
>
	<OffBackLink />

	<section class="predictor-shell">
		<header class="predictor-heading">
			<div>
				<p class="eyebrow">EN OFF · #002</p>
				<h1>Friday Deploy Predictor</h1>
				<p class="lead">
					Évalue objectivement tes chances de passer un week-end tranquille.
				</p>
			</div>

			<OffBadge label="OFFICIALLY UNSUPPORTED" variant="orange" />
		</header>

		<div class="predictor-grid">
			<form class="control-panel" id="predictor-form">
				<div class="panel-meta">
					<span>DEPLOY VARIABLES</span>
					<span>CHANGE · FRIDAY</span>
				</div>

				<div class="field-grid">
					<label class="field">
						<span>Jour</span>
						<select id="day" name="day">
							<option value="monday">Lundi</option>
							<option value="tuesday">Mardi</option>
							<option value="wednesday">Mercredi</option>
							<option value="thursday">Jeudi</option>
							<option value="friday" selected>Vendredi</option>
						</select>
					</label>

					<label class="field">
						<span>Heure</span>
						<input id="time" name="time" type="time" value="16:42" />
					</label>

					<label class="field">
						<span>Environnement</span>
						<select id="environment" name="environment">
							<option value="dev">DEV</option>
							<option value="rec">REC</option>
							<option value="preprod">PREPROD</option>
							<option value="prod" selected>PROD</option>
						</select>
					</label>

					<label class="field">
						<span>Dernier backup</span>
						<select id="backup" name="backup">
							<option value="yes">Oui</option>
							<option value="unknown" selected>Je crois</option>
							<option value="nas">C’est sur le NAS</option>
							<option value="no">Non</option>
						</select>
					</label>
				</div>

				<div class="toggle-grid">
					<label class="toggle-card">
						<input id="boss-online" type="checkbox" checked />
						<span>
							<strong>Chef connecté sur Teams</strong>
							<small>Il a déjà demandé « où on en est ».</small>
						</span>
					</label>

					<label class="toggle-card">
						<input id="five-minutes" type="checkbox" checked />
						<span>
							<strong>« Ça prendra 5 minutes »</strong>
							<small>Prononcé avec une confiance préoccupante.</small>
						</span>
					</label>

					<label class="toggle-card">
						<input id="rollback-tested" type="checkbox" />
						<span>
							<strong>Rollback testé</strong>
							<small>Pas juste documenté dans un ancien ticket.</small>
						</span>
					</label>

					<label class="toggle-card">
						<input id="change-approved" type="checkbox" />
						<span>
							<strong>Changement approuvé</strong>
							<small>Par quelqu’un d’autre que toi.</small>
						</span>
					</label>
				</div>

				<div class="slider-field">
					<div>
						<span>Personnes dans le call</span>
						<strong id="call-size-value">8</strong>
					</div>
					<input id="call-size" type="range" min="1" max="20" value="8" />
				</div>

				<fieldset class="buzzwords">
					<legend>Mots déjà prononcés</legend>

					<label><input type="checkbox" value="quick-win" /> Quick win</label>
					<label><input type="checkbox" value="small-change" checked /> Petit changement</label>
					<label><input type="checkbox" value="no-impact" checked /> Sans impact</label>
					<label><input type="checkbox" value="normally" checked /> Normalement</label>
					<label><input type="checkbox" value="easy-rollback" /> Rollback facile</label>
				</fieldset>

				<button class="primary-action" id="analyze-button" type="submit">
					Analyser le destin
					<span aria-hidden="true">→</span>
				</button>
			</form>

			<section class="result-panel" aria-live="polite">
				<div class="panel-meta">
					<span>WEEK-END SURVIVAL</span>
					<span id="risk-label">RISK · CRITICAL</span>
				</div>

				<div class="score-block">
					<p>Probabilité de passer un week-end tranquille</p>
					<strong id="score">4%</strong>
				</div>

				<div class="gauge" aria-hidden="true">
					<span id="gauge-fill" style="width: 4%"></span>
				</div>

				<div class="analysis-state" id="analysis-state" hidden>
					<p id="analysis-line">Analyse des variables…</p>
				</div>

				<div class="verdict-card" id="verdict-card">
					<span>VERDICT</span>
					<p id="verdict">
						Tu vas probablement découvrir une nouvelle fonctionnalité de Teams.
					</p>
				</div>

				<p class="family-warning" id="family-warning">
					Pense à prévenir tes proches.
				</p>

				<div class="risk-factors">
					<p class="risk-title">Facteurs aggravants détectés</p>
					<ul id="risk-factors">
						<li>Vendredi après 16 h</li>
						<li>Production</li>
						<li>Backup conceptuel</li>
						<li>« Normalement » prononcé</li>
					</ul>
				</div>
			</section>
		</div>

		<aside class="disclaimer">
			<strong>Prédiction sans valeur contractuelle.</strong>
			<span>Murphy conserve un droit de veto permanent.</span>
		</aside>

		<script is:inline>
			const form = document.querySelector('#predictor-form');
			const day = document.querySelector('#day');
			const time = document.querySelector('#time');
			const environment = document.querySelector('#environment');
			const backup = document.querySelector('#backup');
			const bossOnline = document.querySelector('#boss-online');
			const fiveMinutes = document.querySelector('#five-minutes');
			const rollbackTested = document.querySelector('#rollback-tested');
			const changeApproved = document.querySelector('#change-approved');
			const callSize = document.querySelector('#call-size');
			const callSizeValue = document.querySelector('#call-size-value');
			const buzzwordInputs = Array.from(document.querySelectorAll('.buzzwords input'));
			const scoreElement = document.querySelector('#score');
			const gaugeFill = document.querySelector('#gauge-fill');
			const verdictElement = document.querySelector('#verdict');
			const riskFactorsElement = document.querySelector('#risk-factors');
			const familyWarning = document.querySelector('#family-warning');
			const riskLabel = document.querySelector('#risk-label');
			const analysisState = document.querySelector('#analysis-state');
			const analysisLine = document.querySelector('#analysis-line');
			const analyzeButton = document.querySelector('#analyze-button');

			const analysisMessages = [
				'Analyse des variables…',
				'Consultation du Change Advisory Board…',
				'Vérification du karma Git…',
				'Synchronisation avec Murphy…',
				'Calcul du coefficient DevOps…',
				'Résultat obtenu.',
			];

			const verdicts = {
				critical: [
					'Tu viens officiellement de sacrifier ton samedi.',
					'Le rollback va devenir ton activité du week-end.',
					'Préviens déjà ta famille. Et peut-être l’astreinte.',
					'Tu n’es plus en déploiement. Tu es en aventure.',
					'On se revoit lundi. Enfin… normalement.',
				],
				high: [
					'Le week-end reste théoriquement possible.',
					'Garde ton téléphone chargé et ton VPN ouvert.',
					'Tu peux réserver le restaurant, mais près d’une prise électrique.',
					'Le changement est maîtrisé. Le destin beaucoup moins.',
				],
				medium: [
					'Ça peut passer. C’est exactement ce qui est inquiétant.',
					'Tu disposes d’une fenêtre raisonnable pour regretter.',
					'Le risque est modéré, contrairement à ta confiance.',
					'Prépare le rollback juste pour ne pas avoir à l’utiliser.',
				],
				low: [
					'Tu peux presque réserver ton resto.',
					'Le week-end semble accessible sans bastion.',
					'Déploiement raisonnable détecté. C’est suspect.',
					'Tu as fait les choses correctement. Profite de cet instant rare.',
				],
			};

			const pick = (items) => items[Math.floor(Math.random() * items.length)];

			const getHour = () => {
				const [hour = '0', minute = '0'] = time.value.split(':');
				return Number(hour) + Number(minute) / 60;
			};

			const calculate = () => {
				let score = 92;
				const factors = [];
				const hour = getHour();

				if (day.value === 'friday') {
					score -= 28;
					factors.push('Vendredi');
				} else if (day.value === 'thursday') {
					score -= 8;
					factors.push('Jeudi qui se prend pour vendredi');
				}

				if (hour >= 16) {
					score -= 22;
					factors.push('Déploiement après 16 h');
				} else if (hour >= 14) {
					score -= 10;
					factors.push('Fenêtre de changement ambitieuse');
				}

				if (environment.value === 'prod') {
					score -= 26;
					factors.push('Production');
				} else if (environment.value === 'preprod') {
					score -= 8;
					factors.push('PREPROD étonnamment réaliste');
				}

				const backupPenalties = {
					yes: 0,
					unknown: 15,
					nas: 22,
					no: 30,
				};

				score -= backupPenalties[backup.value];

				if (backup.value === 'unknown') factors.push('Backup conceptuel');
				if (backup.value === 'nas') factors.push('Backup « sur le NAS »');
				if (backup.value === 'no') factors.push('Absence de backup assumée');

				if (bossOnline.checked) {
					score -= 8;
					factors.push('Chef connecté sur Teams');
				}

				if (fiveMinutes.checked) {
					score -= 15;
					factors.push('« Ça prendra 5 minutes »');
				}

				if (rollbackTested.checked) {
					score += 18;
				} else {
					factors.push('Rollback non testé');
				}

				if (changeApproved.checked) {
					score += 10;
				} else {
					factors.push('Validation encore émotionnelle');
				}

				const people = Number(callSize.value);

				if (people >= 12) {
					score -= 18;
					factors.push(`${people} personnes dans le call`);
				} else if (people >= 8) {
					score -= 10;
					factors.push(`${people} personnes dans le call`);
				} else if (people >= 5) {
					score -= 5;
				}

				const checkedBuzzwords = buzzwordInputs.filter((input) => input.checked);

				score -= checkedBuzzwords.length * 6;

				checkedBuzzwords.forEach((input) => {
					const labels = {
						'quick-win': 'Quick win',
						'small-change': '« Petit changement »',
						'no-impact': '« Sans impact »',
						'normally': '« Normalement » prononcé',
						'easy-rollback': '« Rollback facile »',
					};

					factors.push(labels[input.value]);
				});

				score += Math.floor(Math.random() * 7) - 3;
				score = Math.max(1, Math.min(99, score));

				return { score, factors };
			};

			const renderResult = ({ score, factors }) => {
				let level = 'low';

				if (score <= 15) level = 'critical';
				else if (score <= 35) level = 'high';
				else if (score <= 65) level = 'medium';

				scoreElement.textContent = `${score}%`;
				gaugeFill.style.width = `${score}%`;
				gaugeFill.dataset.level = level;
				verdictElement.textContent = pick(verdicts[level]);
				riskFactorsElement.replaceChildren(
					...factors.slice(0, 4).map((factor) => {
						const item = document.createElement('li');
						item.textContent = factor;
						return item;
					}),
				);

				familyWarning.hidden = score > 8;

				const labels = {
					critical: 'RISK · CRITICAL',
					high: 'RISK · HIGH',
					medium: 'RISK · MODERATE',
					low: 'RISK · ACCEPTABLE',
				};

				riskLabel.textContent = labels[level];
			};

			const runAnalysis = async () => {
				analyzeButton.disabled = true;
				analysisState.hidden = false;

				for (const message of analysisMessages) {
					analysisLine.textContent = message;
					await new Promise((resolve) => setTimeout(resolve, 220));
				}

				renderResult(calculate());
				analysisState.hidden = true;
				analyzeButton.disabled = false;
			};

			callSize.addEventListener('input', () => {
				callSizeValue.textContent = callSize.value;
			});

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				await runAnalysis();
			});
		</script>
	</section>
</OffLayout>

<style>
	.predictor-shell {
		padding: 1rem 1.15rem 0.8rem;
		background:
			radial-gradient(circle at 92% 8%, rgba(234, 88, 12, 0.08), transparent 26%),
			#ffffff;
		border: 1px solid #dbe4ef;
		border-radius: 22px;
		box-shadow: 0 18px 44px rgba(15, 23, 42, 0.065);
	}

	.predictor-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.eyebrow {
		margin: 0;
		color: #2563eb;
		font-size: 0.64rem;
		font-weight: 900;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.28rem 0 0;
		color: #0f172a;
		font-size: clamp(2.1rem, 4.25vw, 3.8rem);
		line-height: 0.96;
		letter-spacing: -0.055em;
	}

	.lead {
		margin: 0.4rem 0 0;
		color: #64748b;
		font-size: 0.92rem;
		line-height: 1.35;
	}

	.predictor-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
		align-items: stretch;
		gap: 0.8rem;
		margin-top: 0.85rem;
	}

	.control-panel,
	.result-panel {
		min-height: 100%;
		padding: 0.86rem;
		border-radius: 16px;
	}

	.control-panel {
		display: flex;
		flex-direction: column;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
	}

	.result-panel {
		display: flex;
		flex-direction: column;
		color: #e2e8f0;
		background:
			linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
			linear-gradient(135deg, #020817 0%, #07142c 100%);
		background-size: 40px 40px, 40px 40px, auto;
		border: 1px solid rgba(96, 165, 250, 0.1);
	}

	.panel-meta {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		color: #60a5fa;
		font-size: 0.59rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.field-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
		margin-top: 0.65rem;
	}

	.field {
		display: grid;
		gap: 0.26rem;
	}

	.field > span,
	.slider-field span,
	.buzzwords legend {
		color: #475569;
		font-size: 0.64rem;
		font-weight: 850;
	}

	.field select,
	.field input {
		width: 100%;
		min-height: 38px;
		padding: 0.52rem 0.62rem;
		color: #0f172a;
		font: inherit;
		font-size: 0.74rem;
		font-weight: 750;
		background: #ffffff;
		border: 1px solid #dbe4ef;
		border-radius: 9px;
	}

	.toggle-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.45rem;
		margin-top: 0.5rem;
	}

	.toggle-card {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		padding: 0.5rem 0.55rem;
		cursor: pointer;
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
	}

	.toggle-card input {
		margin-top: 0.12rem;
		accent-color: #2563eb;
	}

	.toggle-card span {
		display: grid;
		gap: 0.12rem;
	}

	.toggle-card strong {
		color: #0f172a;
		font-size: 0.68rem;
		line-height: 1.2;
	}

	.toggle-card small {
		color: #64748b;
		font-size: 0.58rem;
		line-height: 1.25;
	}

	.slider-field {
		margin-top: 0.5rem;
		padding: 0.5rem 0.6rem;
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
	}

	.slider-field > div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.slider-field strong {
		color: #2563eb;
		font-size: 0.74rem;
	}

	.slider-field input {
		width: 100%;
		margin-top: 0.3rem;
		accent-color: #2563eb;
	}

	.buzzwords {
		display: flex;
		flex-wrap: wrap;
		gap: 0.36rem;
		margin: 0.5rem 0 0;
		padding: 0.5rem;
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
	}

	.buzzwords legend {
		padding: 0 0.25rem;
	}

	.buzzwords label {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.25rem 0.38rem;
		color: #475569;
		font-size: 0.6rem;
		font-weight: 750;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 7px;
	}

	.buzzwords input {
		accent-color: #ea580c;
	}

	.primary-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		width: 100%;
		min-height: 42px;
		margin-top: 0.5rem;
		padding: 0.65rem 0.9rem;
		color: #ffffff;
		font: inherit;
		font-size: 0.74rem;
		font-weight: 850;
		cursor: pointer;
		background: #ea580c;
		border: 1px solid #ea580c;
		border-radius: 9px;
		transition:
			background 0.16s ease,
			transform 0.16s ease;
	}

	.primary-action:hover {
		transform: translateY(-1px);
		background: #c2410c;
	}

	.primary-action:disabled {
		cursor: wait;
		opacity: 0.72;
	}

	.score-block {
		margin-top: 0.8rem;
		text-align: center;
	}

	.score-block p {
		margin: 0;
		color: #94a3b8;
		font-size: 0.75rem;
	}

	.score-block strong {
		display: block;
		margin-top: 0.18rem;
		color: #ffffff;
		font-size: clamp(3rem, 6.5vw, 4.8rem);
		font-weight: 900;
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.gauge {
		height: 8px;
		margin-top: 0.7rem;
		overflow: hidden;
		background: rgba(148, 163, 184, 0.18);
		border-radius: 99px;
	}

	.gauge span {
		display: block;
		height: 100%;
		background: #ef4444;
		border-radius: inherit;
		transition: width 0.35s ease;
	}

	.gauge span[data-level='high'] {
		background: #f97316;
	}

	.gauge span[data-level='medium'] {
		background: #eab308;
	}

	.gauge span[data-level='low'] {
		background: #22c55e;
	}

	.analysis-state {
		margin-top: 0.65rem;
		padding: 0.58rem 0.65rem;
		color: #93c5fd;
		font-size: 0.74rem;
		text-align: center;
		background: rgba(37, 99, 235, 0.1);
		border: 1px solid rgba(96, 165, 250, 0.2);
		border-radius: 9px;
	}

	.analysis-state p {
		margin: 0;
	}

	.verdict-card {
		margin-top: 0.65rem;
		padding: 0.72rem 0.76rem;
		background: rgba(37, 99, 235, 0.08);
		border: 1px solid rgba(96, 165, 250, 0.2);
		border-radius: 11px;
	}

	.verdict-card span,
	.risk-title {
		color: #60a5fa;
		font-size: 0.59rem;
		font-weight: 900;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.verdict-card p {
		margin: 0.3rem 0 0;
		color: #ffffff;
		font-size: 0.94rem;
		font-weight: 800;
		line-height: 1.28;
	}

	.family-warning {
		margin: 0.55rem 0 0;
		padding: 0.55rem;
		color: #fecaca;
		font-size: 0.72rem;
		font-weight: 850;
		text-align: center;
		background: rgba(239, 68, 68, 0.1);
		border: 1px solid rgba(248, 113, 113, 0.22);
		border-radius: 9px;
	}

	.risk-factors {
		flex: 1;
		margin-top: 0.6rem;
		padding-top: 0.58rem;
		border-top: 1px solid rgba(148, 163, 184, 0.18);
	}

	.risk-title {
		margin: 0;
	}

	.risk-factors ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.3rem 0.75rem;
		margin: 0.42rem 0 0;
		padding: 0;
		list-style: none;
	}

	:global(.risk-factors li) {
		color: #cbd5e1;
		font-size: 0.72rem;
		font-weight: 650;
		line-height: 1.28;
	}

	:global(.risk-factors li::before) {
		content: '•';
		margin-right: 0.32rem;
		color: #f97316;
	}

	.family-warning[hidden],
	.analysis-state[hidden] {
		display: none;
	}

	.disclaimer {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 0.5rem;
		padding-top: 0.45rem;
		color: #64748b;
		font-size: 0.69rem;
		border-top: 1px solid #e2e8f0;
	}

	.disclaimer strong {
		color: #334155;
	}

	@media (max-width: 900px) {
		.predictor-grid {
			grid-template-columns: 1fr;
		}

		.result-panel {
			min-height: auto;
		}

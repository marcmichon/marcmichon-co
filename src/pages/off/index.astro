---
import OffLayout from '../../layouts/OffLayout.astro';
import OffToolCard from '../../components/off/OffToolCard.astro';
import { offTools } from '../../data/off';
---

<OffLayout
	title="EN OFF"
	description="Parce qu’il n’y a pas que les projets sérieux. Bienvenue dans le reste."
>
	<section class="off-hero">
		<div class="hero-copy">
			<p class="eyebrow">UNE AUTRE PARTIE DU SITE</p>
			<h1>EN OFF</h1>
		</div>

		<div class="hero-message">
			<p>Parce qu’il n’y a pas que les projets sérieux.</p>
			<strong>Bienvenue dans le reste ...</strong>
		</div>
	</section>

	<section class="tools-section" aria-labelledby="tools-title">
		<div class="section-heading">
			<p class="section-kicker">LA COLLECTION</p>
			<h2 id="tools-title">Des outils volontairement décalés.</h2>
		</div>

		<div class="tools-grid">
			{offTools.map((tool) => <OffToolCard tool={tool} />)}
		</div>
	</section>
</OffLayout>

<style>
	.off-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
		align-items: end;
		gap: clamp(2rem, 5vw, 5rem);
		min-height: 230px;
		padding: clamp(1.65rem, 4vw, 3rem);
		overflow: hidden;
		color: #ffffff;
		background:
			radial-gradient(circle at 78% 22%, rgba(124, 58, 237, 0.18), transparent 28%),
			radial-gradient(circle at 96% 92%, rgba(37, 99, 235, 0.2), transparent 28%),
			linear-gradient(135deg, #020817 0%, #07142c 58%, #11113a 100%);
		border-radius: 24px;
		box-shadow: 0 20px 48px rgba(2, 8, 23, 0.16);
	}

	.off-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
		background-size: 44px 44px;
		mask-image: linear-gradient(to right, transparent, black);
		pointer-events: none;
	}

	.off-hero > * {
		position: relative;
		z-index: 1;
	}

	.eyebrow {
		margin: 0;
		color: #60a5fa;
		font-size: 0.64rem;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.48rem 0 0;
		color: #ffffff;
		font-size: clamp(3.6rem, 8vw, 6.8rem);
		line-height: 0.86;
		letter-spacing: -0.075em;
	}

	.hero-message {
		padding-bottom: 0.15rem;
	}

	.hero-message p {
		margin: 0;
		color: #cbd5e1;
		font-size: clamp(1rem, 1.8vw, 1.28rem);
		font-weight: 720;
		line-height: 1.3;
	}

	.hero-message strong {
		display: block;
		margin-top: 0.3rem;
		color: #ffffff;
		font-size: clamp(1.35rem, 2.6vw, 2rem);
		font-weight: 860;
		line-height: 1.12;
		letter-spacing: -0.03em;
	}

	.tools-section {
		margin-top: 1.35rem;
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}

	.section-kicker {
		margin: 0 0 0.25rem;
		color: #2563eb;
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.section-heading h2 {
	max-width: 650px;
	margin: 0;
	color: #0f172a;
	font-size: clamp(1.55rem, 2.8vw, 2.2rem);
	line-height: 1.05;
	letter-spacing: -0.04em;
}

	.tools-grid {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	align-items: stretch;
	gap: 0.65rem;
	margin-top: 0.7rem;
}

	@media (max-width: 980px) {
		.off-hero {
			grid-template-columns: 1fr;
			align-items: start;
			gap: 1rem;
			min-height: 0;
		}

		.tools-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 680px) {
		.off-hero {
			padding: 1.25rem;
			border-radius: 20px;
		}

		h1 {
			font-size: clamp(3.4rem, 20vw, 5rem);
		}

		.tools-section {
			margin-top: 1rem;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.2rem;
		}

		.tools-grid {
			grid-template-columns: 1fr;
			gap: 0.65rem;
			margin-top: 0.75rem;
		}
	}
</style>

---
import OffLayout from '../../../layouts/OffLayout.astro';
import OffBackLink from '../../../components/off/OffBackLink.astro';

const officialSite = 'https://doubaille-university.com/';
const title = 'Université de Doubaille | EN OFF';
const description = 'Une idée absurde devenue une université fictive : neuf professeurs, neuf publications, des laboratoires et un rectorat. Découvrez Doubaille University.';

const stages = [
  { number: '01', label: 'Une question absurde' },
  { number: '02', label: 'Un premier traité' },
  { number: '03', label: 'Une institution entière' },
  { number: '04', label: 'Un site indépendant' },
];

const discoveries = [
  { number: '01', name: 'Le corps professoral', description: 'Neuf universitaires qui enseignent le DNS, HTTP, la métaphysique et désormais la complaisance.' },
  { number: '02', name: 'Les publications', description: 'Neuf traités : des protocoles, des crises existentielles et une conformité auto-certifiée.' },
  { number: '03', name: 'La recherche', description: 'Trois laboratoires officiels et une unité confidentielle dont le rectorat ne confirme pas l’existence.' },
  { number: '04', name: 'Le campus', description: 'Quatre cursus, une Gazette, un BDE, des Alumni et toujours aucun étudiant.' },
];
---

<OffLayout title={title} description={description}>
  <OffBackLink />
  <article class="doubaille-story">
    <header class="story-hero" aria-labelledby="story-title">
      <div class="story-hero-copy">
        <p class="eyebrow">EN OFF · ESCAPED · ÉTABLISSEMENT NON RECONNU</p>
        <span class="story-status">ESCAPED</span>
        <h1 id="story-title">Université <em>de Doubaille.</em></h1>
        <p class="hero-lead">L’excellence académique à l’état <strong>parfaitement inutile.</strong></p>
        <p class="hero-intro">À l’origine, c’était une question absurde. Puis les traités sont arrivés. Aujourd’hui, l’université a son rectorat, ses formations et son propre site.</p>
        <a class="hero-link" href={officialSite} target="_blank" rel="noopener noreferrer">Découvrir le site officiel <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="hero-figure">
        <img src="/Images/off/universite-doubaille-sceau.webp" width="1254" height="1254" alt="Sceau fictif de l’Université de Doubaille, fondée en 127.0.0.1" decoding="async" fetchpriority="high" />
        <figcaption>FONDÉE EN 127.0.0.1 · COGITO ERGO PING.</figcaption>
      </figure>
    </header>

    <div class="academic-register" aria-label="Registre institutionnel fictif">
      <div class="register-label"><span class="register-index">DU / 127.0.0.1</span><strong>REGISTRE DU RECTORAT</strong></div>
      <dl class="register-stats">
        <div><dt>09</dt><dd>Universitaires</dd></div>
        <div><dt>09</dt><dd>Publications</dd></div>
        <div><dt>04</dt><dd>Cursus</dd></div>
        <div><dt>00</dt><dd>Étudiant</dd></div>
      </dl>
      <span class="register-validation" aria-label="Statut d’accréditation fictif">AUTO-ACCRÉDITÉE<span>✳</span></span>
    </div>

    <section class="editorial-section origin" aria-labelledby="origin-title">
      <div class="editorial-main">
        <p class="section-kicker">LE PROJET</p>
        <h2 id="origin-title">Un établissement qui <em>n’aurait jamais dû exister.</em></h2>
        <p>Tout est parti d’une interrogation parfaitement légitime : pourquoi Spinoza, Descartes ou Sartre n’auraient-ils rien à dire sur un proxy, un ticket informatique ou un VLAN ?</p>
        <p>Une première réflexion s’est transformée en traité. Puis il a fallu un auteur, un doyen, un corps professoral, une administration et un sceau digne des plus anciennes institutions.</p>
        <p>La suite aurait raisonnablement dû s’arrêter là.</p>
      </div>
      <aside class="origin-quote" aria-label="Principe fondateur">
        <p class="aside-kicker">PRINCIPE FONDATEUR</p>
        <blockquote>« La rigueur de la forme ne saurait être compromise par l’absurdité du fond. »</blockquote>
        <span>— Doctrine du rectorat, jamais soumise à une revue contradictoire</span>
      </aside>
    </section>

    <section class="editorial-section expansion" aria-labelledby="expansion-title">
      <p class="section-kicker">L’ESCALADE</p>
      <h2 id="expansion-title">Le problème, <em>c’est qu’on a continué.</em></h2>
      <div class="expansion-body">
        <div class="expansion-copy">
          <p>Un traité a appelé un second traité. Puis des biographies, une gouvernance, des cursus, des laboratoires, des traditions académiques, un BDE, des Alumni et naturellement une procédure d’admission sans candidat.</p>
          <p>À force de prendre la plaisanterie beaucoup trop au sérieux, Doubaille s’est affranchie de la rubrique EN OFF pour obtenir son propre site : <strong>doubaille-university.com</strong>.</p>
          <p>Neuf universitaires travaillent aujourd’hui sur des questions que personne n’avait eu le courage — ou le besoin — de poser. Le dernier arrivé a même certifié son propre recrutement.</p>
        </div>
        <ol class="story-timeline" aria-label="L’évolution du projet">
          {stages.map(stage => <li><span>{stage.number}</span><strong>{stage.label}</strong></li>)}
        </ol>
      </div>
    </section>

    <section class="editorial-section discovery" aria-labelledby="discovery-title">
      <p class="section-kicker">CE QUE VOUS ALLEZ Y TROUVER</p>
      <h2 id="discovery-title">Une véritable université. <em>À ceci près.</em></h2>
      <div class="discovery-grid">
        {discoveries.map(item =>
          <div class="discovery-item">
            <span class="discovery-number">{item.number}</span>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </div>
        )}
      </div>
    </section>

    <aside class="fiction-note" aria-label="Information sur le caractère fictif">
      <span aria-hidden="true">!</span>
      <div><strong>Tout ce que vous allez découvrir est fictif.</strong><p>L’Université de Doubaille n’est pas un établissement d’enseignement réel. Ses diplômes, admissions et travaux sont satiriques ; aucun diplôme reconnu n’est délivré.</p></div>
    </aside>

    <section class="editorial-section meaning" aria-labelledby="meaning-title">
      <div class="meaning-copy">
        <p class="section-kicker">POURQUOI ?</p>
        <h2 id="meaning-title">Parce que l’absurde méritait <em>une institution.</em></h2>
        <p>Dans l’informatique, certaines procédures acquièrent une importance qui dépasse largement le problème qu’elles étaient censées résoudre. Doubaille pousse ce mécanisme à son terme : des certitudes immenses, des commissions impeccables et une utilité obstinément discutable.</p>
        <p>C’est une satire, mais aussi un hommage affectueux à celles et ceux qui maintiennent les systèmes debout entre deux comités de validation.</p>
      </div>
      <aside class="rectorate-opinion" aria-label="Avis officiel fictif du rectorat">
        <div class="rectorate-opinion-top"><span>ACTE ACADÉMIQUE · N° 001</span><span aria-hidden="true">✳</span></div>
        <p class="rectorate-quote">« L'établissement est reconnu par lui-même. Son autorité ne saurait être contestée par des étudiants inexistants. »</p>
        <div class="rectorate-signature"><span>APPROUVÉ SANS CONTRADICTEUR</span><strong>Le rectorat de Doubaille</strong></div>
      </aside>
    </section>

    <section class="official-site" aria-labelledby="official-title">
      <div>
        <p class="section-kicker">LE SITE OFFICIEL</p>
        <h2 id="official-title">Découvrir l’univers <em>Doubaille.</em></h2>
        <p>Le site indépendant rassemble neuf publications, neuf universitaires, quatre formations, des laboratoires, une Gazette et une vie étudiante qui ne manque que d’étudiants. Le rectorat promet un enseignement d’une qualité incontestable. Aucun étudiant n’a été interrogé.</p>
      </div>
      <a class="official-cta" href={officialSite} target="_blank" rel="noopener noreferrer">
        <span><small>VISITER LE SITE OFFICIEL</small><strong>doubaille-university.com</strong></span>
        <span aria-hidden="true">→</span>
      </a>
    </section>
    <p class="endnote">Fondée en 127.0.0.1. Toujours aucune inscription. <em>Cogito ergo ping.</em></p>
  </article>
</OffLayout>

<style>
  .doubaille-story{--midnight:#071327;--navy:#112b47;--gold:#c8a56b;--light-gold:#e9d4a5;--ink:#14233a;--muted:#596a80;--hairline:#e4dfd6;color:var(--ink);max-width:100%}
  .doubaille-story *, .doubaille-story *::before, .doubaille-story *::after{box-sizing:border-box}
  .doubaille-story h1,.doubaille-story h2,.doubaille-story h3{font-family:Georgia,'Times New Roman',serif}
  .story-hero{display:grid;grid-template-columns:minmax(0,1.38fr) minmax(205px,.72fr);gap:clamp(1.4rem,3vw,3rem);align-items:center;min-height:315px;padding:clamp(1.5rem,3.1vw,2.5rem);background:radial-gradient(circle at 90% 18%,#c8a56b24,transparent 42%),linear-gradient(118deg,#071327,#122b49 70%,#1a3b59);color:#fff;border-radius:19px;overflow:hidden}
  .story-hero-copy{min-width:0}
  .eyebrow,.section-kicker{margin:0;color:#b18a53;font-size:.66rem;font-weight:900;letter-spacing:.15em;line-height:1.5}
  .story-hero .eyebrow{color:var(--light-gold)}
  .story-status{display:inline-block;margin:.9rem 0 0;padding:.35rem .6rem;background:#e0c08a20;border:1px solid #e3c38777;border-radius:4px;color:#f0d8aa;font-size:.6rem;letter-spacing:.13em;font-weight:900}
  .story-hero h1{margin:.6rem 0 .8rem;color:#fff;font-size:clamp(2.35rem,4vw,4.25rem);line-height:1.05;letter-spacing:-.055em}
  .story-hero h1 em{display:block;color:#e7c990;font-style:italic;font-weight:400}
  .hero-lead{margin:0;color:#f0d4a0;font-size:clamp(1.12rem,1.7vw,1.42rem);line-height:1.35;font-weight:750}
  .hero-lead strong{color:#fff}
  .hero-intro{max-width:590px;margin:.65rem 0 1rem;color:#d1dce7;font-size:.9rem;line-height:1.6}
  .hero-link{display:inline-flex;align-items:center;gap:.65rem;min-height:43px;padding:.73rem 1.1rem;text-decoration:none;background:var(--gold);color:#071327;font-size:.81rem;font-weight:900;border-radius:7px}
  .hero-link:hover{background:#e1c389}
  .hero-figure{min-width:0;display:flex;flex-direction:column;align-items:center;gap:.6rem;margin:0}
  .hero-figure img{display:block;width:min(100%,242px);height:auto;filter:drop-shadow(0 16px 24px #0005)}
  .hero-figure figcaption{max-width:280px;text-align:center;color:#d6c49d;font-size:.57rem;font-weight:850;letter-spacing:.1em;line-height:1.55}
  .editorial-section{padding:clamp(1.85rem,3vw,2.8rem) clamp(.4rem,2vw,1.25rem);border-bottom:1px solid var(--hairline)}
  .editorial-section h2,.official-site h2{max-width:800px;margin:.45rem 0 1rem;color:var(--ink);font-size:clamp(1.9rem,3vw,2.8rem);font-weight:500;letter-spacing:-.042em;line-height:1.12}
  .editorial-section h2 em,.official-site h2 em{color:#a9824c;font-weight:400}
  .editorial-section p:not(.section-kicker),.official-site p:not(.section-kicker){color:var(--muted);font-size:.93rem;line-height:1.7}
  .origin{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(240px,.7fr);gap:clamp(1.3rem,3.2vw,3rem);align-items:center}
  .origin .editorial-main p:not(.section-kicker){max-width:66ch;margin:.48rem 0}
  .origin-quote{padding:1.5rem 1.45rem;background:#f3efe6;border-left:3px solid var(--gold)}
  .origin-quote .aside-kicker{margin:0;color:#9a774b;font-size:.64rem;font-weight:900;letter-spacing:.13em}
  .origin-quote blockquote{margin:.7rem 0;color:#203752;font:italic clamp(1.2rem,2vw,1.6rem)/1.48 Georgia,serif}
  .origin-quote>span{display:block;color:#77808b;font-size:.75rem;line-height:1.6}
  .expansion-body{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.9fr);gap:clamp(1.5rem,3.2vw,3rem);align-items:start}
  .expansion-copy p{max-width:62ch;margin:.5rem 0}
  .expansion-copy strong{color:var(--ink)}
  .story-timeline{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;margin:0;padding:1px;list-style:none;background:#dfd8cb;border:1px solid #dfd8cb}
  .story-timeline li{display:grid;gap:.55rem;min-height:92px;padding:1rem 1.1rem;align-content:center;background:#faf8f4}
  .story-timeline li>span{color:#a7804b;font-size:.75rem;font-weight:900;letter-spacing:.12em}
  .story-timeline li>strong{color:#203854;font-size:.92rem;line-height:1.4}
  .discovery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin-top:1.2rem;border-block:1px solid #ddd6ca}
  .discovery-item{min-width:0;padding:1.35rem 1rem 1.3rem 1.15rem;border-right:1px solid #ddd6ca}
  .discovery-item:first-child{padding-left:0}.discovery-item:last-child{border:0}
  .discovery-number{color:#b08c55;font:500 1.7rem Georgia,serif}
  .discovery-item h3{margin:.65rem 0 .42rem;color:#182f4b;font-size:1.28rem;font-weight:500;line-height:1.2}
  .discovery-item p{margin:0;color:#5f6b7e;font-size:.84rem!important;line-height:1.7!important}
  .fiction-note{display:flex;gap:1rem;align-items:center;padding:1.15rem 1.3rem;background:#f4f0e8;border-top:2px solid #c8a56b}
  .fiction-note>span{font:500 2.5rem Georgia,serif;color:#af8a55}
  .fiction-note strong{color:#192d48;font-size:.97rem}
  .fiction-note p{margin:.25rem 0 0;color:#5b6676;font-size:.84rem;line-height:1.65}
  .meaning{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(240px,.82fr);gap:clamp(1.5rem,3.2vw,3rem);align-items:center}
  .meaning-copy p:not(.section-kicker){max-width:64ch;margin:.5rem 0}
  .official-site{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(265px,.7fr);align-items:center;gap:1.6rem;margin-top:1.4rem;padding:clamp(1.45rem,2.5vw,2.15rem);background:#f3efe6;border:1px solid #e4d9ca}
  .official-site h2{margin-bottom:.7rem}
  .official-site p:not(.section-kicker){margin:.5rem 0 0;max-width:62ch}
  .official-cta{display:flex;align-items:center;justify-content:space-between;gap:1.2rem;padding:1.2rem 1.15rem;background:#0c233d;color:#fff;text-decoration:none;min-width:0}
  .official-cta:hover{background:#193956}
  .official-cta>span:first-child{display:grid;gap:.28rem;min-width:0}
  .official-cta small{color:#e4c58c;font-size:.59rem;font-weight:900;letter-spacing:.13em}
  .official-cta strong{font-size:.98rem;overflow-wrap:anywhere}
  .official-cta>span:last-child{color:#e7c78d;font-size:1.5rem}
  .endnote{padding:.95rem .5rem 0;color:#778493;text-align:center;font-size:.78rem}
  .endnote em{color:#9f7b49}
  /* Registre du rectorat : le detail institutionnel de la passerelle. */
  .academic-register{display:flex;align-items:center;gap:1.2rem;flex-wrap:wrap;margin:.7rem 0 0;padding:1.05rem 1.3rem;border:1px solid #e1d6c5;background:linear-gradient(105deg,#f8f5ef,#f2ebdf);color:var(--ink)}
  .register-label{display:grid;gap:.2rem;min-width:160px;margin-right:auto}
  .register-index{color:#a17b47;font-size:.57rem;font-weight:900;letter-spacing:.14em}
  .register-label strong{font-size:.67rem;letter-spacing:.1em}
  .register-stats{display:flex;gap:clamp(.8rem,2.6vw,2rem);align-items:center;margin:0}
  .register-stats>div{display:flex;align-items:baseline;gap:.3rem;white-space:nowrap}
  .register-stats dt{font:500 1.5rem Georgia,serif;color:#173452}
  .register-stats dd{margin:0;font-size:.7rem;color:#6d6d71}
  .register-validation{display:flex;align-items:center;gap:.45rem;margin-left:auto;padding:.42rem .7rem;border:1px solid #c7a56c;color:#8b683c;font-size:.57rem;font-weight:900;letter-spacing:.1em;white-space:nowrap;transform:rotate(-2deg)}
  .register-validation span{font-size:1.2rem;line-height:1}
  .rectorate-opinion{padding:1.35rem 1.5rem;border:1px solid #d9cbb5;background:#f6f2eb}
  .rectorate-opinion-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ded3c1;padding-bottom:.65rem;color:#967044;font-size:.62rem;letter-spacing:.12em;font-weight:900}
  .rectorate-opinion-top span:last-child{font-size:1.4rem}
  .rectorate-quote{margin:1.2rem 0!important;color:#243d58!important;font:italic 1.36rem/1.52 Georgia,serif!important}
  .rectorate-signature{border-top:1px solid #ded3c1;padding-top:.75rem;display:grid;gap:.35rem}
  .rectorate-signature span{color:#9a784b;font-size:.58rem;letter-spacing:.1em;font-weight:900}
  .rectorate-signature strong{font:italic .95rem Georgia,serif;color:#253c56}
  @media(max-width:1180px){.academic-register{justify-content:space-between}.register-label{margin-right:0}.register-validation{margin-left:0}}
  @media(max-width:990px){.story-hero{grid-template-columns:minmax(0,1fr) 225px}.hero-figure img{width:206px}.origin,.expansion-body,.meaning,.official-site{grid-template-columns:1fr}.discovery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.discovery-item:nth-child(2){border:0}.discovery-item:nth-child(n+3){border-top:1px solid #ddd6ca}.official-cta{max-width:460px}}
  @media(max-width:990px){.academic-register{justify-content:center}.register-label{width:100%;text-align:center}.register-stats{justify-content:center;flex-wrap:wrap}.register-validation{margin-left:0}.rectorate-opinion{max-width:520px}}
  @media(max-width:680px){.story-hero{grid-template-columns:1fr;gap:1.35rem;padding:1.55rem 1.3rem;border-radius:14px}.hero-figure img{width:176px}.story-hero h1{font-size:clamp(2.4rem,10vw,3.2rem)}.hero-figure figcaption{font-size:.52rem}.editorial-section{padding:1.65rem .3rem}.origin-quote{padding:1.3rem 1.15rem}.expansion-body{gap:1.4rem}.discovery-item{padding:1.3rem .7rem}.discovery-item:first-child{padding-left:.5rem}.discovery-item h3{font-size:1.15rem}.fiction-note{align-items:flex-start;padding:1.2rem}.official-site{padding:1.35rem;gap:1rem}.official-cta{width:100%}}
  @media(max-width:680px){.academic-register{padding:.9rem .8rem;gap:.65rem}.register-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%;gap:.6rem 1rem}.register-stats>div{justify-content:center}.register-stats dd{font-size:.66rem}.register-validation{margin:.1rem auto}.rectorate-quote{font-size:1.18rem!important}}
  @media(max-width:390px){.discovery-grid{grid-template-columns:1fr}.discovery-item{padding:1.3rem .6rem!important;border:0;border-top:1px solid #ddd6ca}.discovery-item:first-child{border-top:0}.story-timeline li{padding:.85rem .8rem;min-height:88px}.hero-link{width:100%;justify-content:center}}
  @media(prefers-reduced-motion:reduce){.hero-link,.official-cta{transition:none}}
</style>

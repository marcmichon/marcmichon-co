---
import OffLayout from '../../../layouts/OffLayout.astro';

const title = 'Université de Doubaille — Les grandes pensées de l’informatique';
const description = 'Les grandes pensées de l’informatique : des traités philosophiques très sérieux sur des problèmes informatiques qui ne le sont pas.';

const publications = [
	{
		number: 'I',
		title: 'Le libre arbitre existe-t-il derrière un proxy ?',
		subtitle: 'Spinoza, Sartre et la tragédie de l’URL bloquée.',
		status: 'PUBLIÉ',
		href: '/off/universite-de-doubaille/libre-arbitre-proxy/',
	},
	{
		number: 'II',
		title: 'Je crée un ticket, donc je suis.',
		subtitle: 'Descartes et la démonstration ontologique de Jira.',
		status: 'PUBLIÉ',
		href: '/off/universite-de-doubaille/je-cree-un-ticket-donc-je-suis/',
	},
	{
		number: 'III',
		title: 'L’enfer, c’est les autres VLAN.',
		subtitle: 'Jean-Paul Sartre et la solitude du réseau segmenté.',
		status: 'À PARAÎTRE',
		href: null,
	},
	{
		number: 'IV',
		title: 'Le serveur de production a-t-il une âme ?',
		subtitle: 'Heidegger et l’angoisse du redémarrage obligatoire.',
		status: 'À PARAÎTRE',
		href: null,
	},
];
---

<OffLayout title={title} description={description}>
	<nav class="breadcrumbs" aria-label="Fil d’Ariane">
		<a href="/off/">En Off</a>
		<span aria-hidden="true">/</span>
		<span>Université de Doubaille</span>
	</nav>

	<header class="university-hero">
		<div class="hero-main">
			<p class="eyebrow">EN OFF 010 <span>·</span> ÉTABLISSEMENT D’ENSEIGNEMENT SUPÉRIEUREMENT INUTILE</p>
			<h1>Les grandes pensées <em>de l’informatique.</em></h1>
			<p class="hero-description">Des réflexions complètement absurdes, présentées avec le sérieux académique d’un colloque de philosophie à la Sorbonne.</p>
			<div class="hero-bottom">
				<span>Revue de métaphysique appliquée aux infrastructures numériques</span>
				<span class="hero-dot" aria-hidden="true"></span>
				<span>ISSN : 127.0.0.1</span>
			</div>
		</div>
		<div class="seal-area">
			<img
				class="university-seal"
				src="/Images/off/universite-doubaille-sceau.webp"
				alt="Sceau de l’Université de Doubaille — Cogito ergo ping, fondée en 127.0.0.1"
				width="1254"
				height="1254"
				decoding="async"
			/>
		</div>
	</header>

	<section class="manifesto" aria-label="Présentation de la faculté">
		<div class="manifesto-heading">
			<p class="kicker">ÉDITORIAL DU DÉPARTEMENT</p>
			<h2>Penser l’impensable.<br /><span>Et surtout l’inutile.</span></h2>
		</div>
		<div class="manifesto-copy">
			<p>Depuis des siècles, les philosophes interrogent l’être, la liberté et la condition humaine. Pourtant, aucune grande école de pensée n’a sérieusement répondu à cette question : <strong>un paquet rejeté par le firewall a-t-il néanmoins existé ?</strong></p>
			<p>L’Université de Doubaille se propose de combler cette lacune. Nos chercheurs analysent les grandes tragédies informatiques avec une méthode éprouvée : des références prestigieuses, une assurance absolue et une compréhension généralement approximative du problème.</p>
			<p class="manifesto-quote">« La rigueur de la forme ne saurait être compromise par l’absurdité du fond. »</p>
		</div>
	</section>

	<section class="academic-institution" aria-labelledby="institution-title">
		<div class="institution-heading">
			<div>
				<p class="kicker">GOUVERNANCE ACADÉMIQUE · ORGANIGRAMME OFFICIEL</p>
				<h2 id="institution-title">Une institution.<br /><span>Deux autorités incontestables.</span></h2>
			</div>
			<p>La gouvernance de l’Université de Doubaille repose sur une organisation volontairement resserrée. Ce choix garantit une prise de décision rapide et limite considérablement les risques de contradiction.</p>
		</div>

		<div class="org-chart" aria-label="Organigramme de l’Université de Doubaille">
			<article class="org-person org-dean">
				<div class="org-mark" aria-hidden="true">RD</div>
				<div class="org-description">
					<p class="org-rank">01 · AUTORITÉ SUPRÊME DE RÉSOLUTION</p>
					<h3>Robert-Louis Dehainesse</h3>
					<p class="org-position">Doyen de la Faculté des Sciences Inutiles et de Métaphysique Informatique</p>
					<p class="org-detail">Responsable de l’orientation scientifique, de la propagation institutionnelle et des décisions qui ne nécessitent aucun consensus.</p>
				</div>
				<div class="org-label" aria-hidden="true">DOYEN</div>
			</article>
			<p class="org-subheading">SOUS L’AUTORITÉ DU DÉCANAT</p>
			<div class="org-lower">
				<article class="org-person org-professor">
					<div class="org-mark" aria-hidden="true">JM</div>
					<div class="org-description">
						<p class="org-rank">02 · DIRECTION DES TRAVAUX INUTILES</p>
						<h3>Jean-Michel Técépai-Hipet</h3>
						<p class="org-position">Professeur titulaire de la chaire de métaphysique des réseaux et de philosophie du changement non approuvé</p>
						<p class="org-detail">Auteur des traités fondamentaux et spécialiste des libertés conditionnées par les politiques de filtrage.</p>
					</div>
				</article>
				<article class="org-laboratory">
					<p class="org-rank">STRUCTURE RATTACHÉE À LA CHAIRE</p>
					<div class="lab-acronym">LEEFNA</div>
					<h3>Laboratoire d’Études sur l’Existence des Flux Non Autorisés</h3>
					<p>Unité de recherche fondamentale. Ses travaux portent sur les paquets disparus, les permissions révoquées et les questions auxquelles les logs refusent de répondre.</p>
					<span>Statut : scientifiquement invérifiable</span>
				</article>
			</div>
		</div>

		<div class="biography-heading">
			<div>
				<p class="kicker">ANNUAIRE DU CORPS PROFESSORAL</p>
				<h2>Les autorités intellectuelles.</h2>
			</div>
			<p>Deux parcours exemplaires. Une réputation internationale dont les sources demeurent indisponibles.</p>
		</div>

		<div class="biographies">
			<article class="biography-card" aria-labelledby="bio-dehainesse">
				<div class="bio-topline"><span>BIOGRAPHIE OFFICIELLE 001</span><span>DOYEN</span></div>
				<h3 id="bio-dehainesse">Robert-Louis Dehainesse</h3>
				<p class="bio-subtitle">Doyen · Docteur en ontologie du nom mal propagé</p>
				<p>Robert-Louis Dehainesse dirige la Faculté des Sciences Inutiles avec une exigence intellectuelle unanimement reconnue, quoique difficilement mesurable. Spécialiste des problèmes d’identité, de résolution et de propagation institutionnelle, il a consacré l’essentiel de sa carrière à cette interrogation : <strong>une entité peut-elle réellement exister si personne ne parvient à résoudre son nom ?</strong></p>
				<p>Docteur en épistémologie des systèmes distribués, il défend une conception rigoureuse de la recherche : la méthode doit rester irréprochable, même lorsque l’objet d’étude ne présente aucun intérêt. Sous son autorité, Doubaille a développé un enseignement supérieur qui ne dépend d’aucune reconnaissance extérieure, celle-ci ayant régulièrement échoué à trouver l’établissement.</p>
				<div class="bio-works">
					<p>TRAVAUX DE RÉFÉRENCE</p>
					<ul>
						<li><cite>Qui suis-je, où suis-je, et pourquoi personne ne me résout ?</cite></li>
						<li><cite>Être joignable : une illusion propagée</cite></li>
						<li><cite>De la dignité d’un établissement sans reconnaissance officielle</cite></li>
					</ul>
				</div>
				<p class="bio-quote">« Une institution peut exister sans être résolue. Elle sera simplement très difficile à joindre. »</p>
			</article>

			<article class="biography-card" aria-labelledby="bio-tecepai">
				<div class="bio-topline"><span>BIOGRAPHIE OFFICIELLE 002</span><span>PROFESSEUR TITULAIRE</span></div>
				<h3 id="bio-tecepai">Jean-Michel Técépai-Hipet</h3>
				<p class="bio-subtitle">Chaire de métaphysique des réseaux · Docteur <em>honoris causa</em> en tickets sans réponse</p>
				<p>Jean-Michel Técépai-Hipet est l’un des principaux représentants de la philosophie informatique contemporaine non sollicitée. Ses travaux explorent les conditions d’existence de l’individu au sein d’environnements techniques contraints : filtrage, contrôle d’accès, journalisation et validation managériale.</p>
				<p>À la tête du LEEFNA, il a démontré que <strong>l’homme peut être libre de penser sans nécessairement être libre de sortir</strong>. Il poursuit également ses recherches sur l’existence statistique des incidents non déclarés, un domaine dans lequel les directions informatiques lui témoignent un intérêt qu’elles contestent formellement.</p>
				<div class="bio-works">
					<p>PUBLICATIONS MAJEURES</p>
					<ul>
						<li><cite>Le libre arbitre existe-t-il derrière un proxy ?</cite></li>
						<li><cite>Je crée un ticket, donc je suis.</cite></li>
						<li><cite>Critique de la raison filtrante</cite></li>
					</ul>
				</div>
				<p class="bio-quote">« L’existence précède l’authentification. Sauf dans Active Directory. »</p>
			</article>
		</div>

		<aside class="academic-council" aria-labelledby="council-title">
			<div class="council-icon" aria-hidden="true">§</div>
			<div>
				<p class="kicker">PROCÈS-VERBAL Nº 127.0.0.1 · INSTANCE PERMANENTE</p>
				<h3 id="council-title">Le Conseil académique</h3>
				<p>Composé du doyen, du professeur titulaire et, lorsque sa messagerie fonctionne, d’un membre extérieur non identifié, le Conseil académique garantit l’indépendance des recherches de Doubaille. Ses dernières délibérations ont abouti à une décision unanime, prise en l’absence de tout quorum clairement défini.</p>
				<p class="council-footnote">Prochaine séance : dès réception de la convocation. Envoi suspendu pour erreur DNS.</p>
			</div>
			<div class="council-stamp" aria-hidden="true">AVIS<br />FAVORABLE*</div>
		</aside>
	</section>

	<section class="publications" aria-labelledby="publications-title">
		<div class="publication-intro">
			<div>
				<p class="kicker">ANNALES DE LA FACULTÉ · VOLUME 01</p>
				<h2 id="publications-title">Les traités fondamentaux</h2>
			</div>
			<p>Une publication rigoureusement évaluée par un comité scientifique dont la composition demeure confidentielle, essentiellement faute de membres.</p>
		</div>
		<div class="publications-list">
			{publications.map((publication) => (
				<article class:list={['publication', { forthcoming: !publication.href }]}>
					<div class="publication-number">TRAITÉ <strong>{publication.number}</strong></div>
					<div class="publication-content">
						<p class="publication-status">{publication.status}</p>
						<h3>{publication.title}</h3>
						<p>{publication.subtitle}</p>
					</div>
					{publication.href ? (
						<a class="publication-link" href={publication.href} aria-label={`Lire : ${publication.title}`}>Lire le traité <span aria-hidden="true">↗</span></a>
					) : (
						<span class="publication-pending" aria-label="À paraître">En expertise</span>
					)}
				</article>
			))}
		</div>
	</section>

	<section class="disclaimer" aria-label="Avis du comité scientifique">
		<div class="disclaimer-icon" aria-hidden="true">§</div>
		<div>
			<p class="kicker">AVIS DU COMITÉ SCIENTIFIQUE</p>
			<h2>Une pensée irréfutable, faute de contradicteurs habilités.</h2>
			<p>Les publications de cette faculté sont fictives, satiriques et formellement déconseillées pour la rédaction d’un dossier d’architecture. Toute ressemblance avec un comité de validation existant serait regrettable mais statistiquement plausible.</p>
		</div>
	</section>
</OffLayout>

<style>
	.breadcrumbs { display:flex; align-items:center; gap:.65rem; margin: .35rem 0 1rem; color:#64748b; font-size:.78rem; font-weight:700; }
	.breadcrumbs a { color:#4f46e5; text-decoration:none; }
	.breadcrumbs a:hover { text-decoration:underline; }
	.university-hero { display:grid; grid-template-columns:minmax(0, 1.24fr) minmax(340px, .76fr); gap:2rem; align-items:center; position:relative; overflow:hidden; min-height:395px; padding:clamp(1.5rem, 4vw, 3.5rem); background:radial-gradient(circle at 85% 18%,rgba(129,140,248,.21),transparent 26rem),linear-gradient(125deg,#050a1b 0%,#111c3a 52%,#24174e 100%); color:white; border-radius:24px; box-shadow:0 24px 70px rgba(14,17,46,.19); }
	.university-hero::before { content:''; pointer-events:none; position:absolute; inset:0; opacity:.17; background-image:linear-gradient(rgba(255,255,255,.14) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.14) 1px,transparent 1px); background-size:38px 38px; mask-image:linear-gradient(90deg, transparent, black); }
	.hero-main,.seal-area { position:relative; z-index:1; }
	.eyebrow,.kicker { margin:0; color:#6366f1; font-weight:900; font-size:.65rem; letter-spacing:.16em; line-height:1.55; }
	.eyebrow {color:#a5b4fc;} .eyebrow span {padding:0 .25rem; color:#94a3b8;}
	.university-hero h1 { max-width:750px; margin:1rem 0 1.2rem; color:white; font-size:clamp(2.25rem,4.65vw,4.4rem); letter-spacing:-.065em; line-height:1.02; }
	.university-hero h1 em { color:#c4b5fd; font-style:normal; }
	.hero-description { max-width:610px; margin:0; color:#dbeafe; font-size:clamp(.98rem,1.4vw,1.18rem); line-height:1.65; }
	.hero-bottom { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem; margin-top:2.1rem; color:#a5b4fc; font-size:.72rem; letter-spacing:.02em; }
	.hero-dot { width:3px; height:3px; border-radius:50%; background:#a5b4fc; }
	.seal-area { display:flex; align-items:center; justify-content:center; min-width:0; }
	.university-seal { display:block; width:min(100%,340px); height:auto; filter:drop-shadow(0 12px 24px rgba(2,8,23,.28)); }
	.manifesto { display:grid; grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr); gap:clamp(1.25rem,3vw,2.8rem); padding:clamp(1.4rem,2.8vw,2.3rem) .5rem; }
	.manifesto h2,.publications h2,.faculty h2,.disclaimer h2 { margin:.5rem 0 0; color:#0f172a; letter-spacing:-.045em; line-height:1.12; }
	.manifesto h2 { font-size:clamp(1.65rem,3vw,2.7rem); }
	.manifesto h2 span { color:#6355ae; }
	.manifesto-copy p { margin:0 0 .8rem; color:#475569; font-size:.98rem; line-height:1.68; }
	.manifesto-copy strong { color:#0f172a; }
	.manifesto-copy .manifesto-quote { margin:1rem 0 0; color:#4338ca; font-family:Georgia,serif; font-size:1.08rem; font-style:italic; font-weight:700; }
	.academic-institution { padding:clamp(1rem,2.2vw,1.8rem) 0; }
	.institution-heading,.biography-heading {display:flex;justify-content:space-between;align-items:end;gap:1.5rem;margin-bottom:1.1rem;padding:0 .5rem;}
	.institution-heading h2,.biography-heading h2 {margin:.6rem 0 0;color:#0f172a;font-size:clamp(1.65rem,3vw,2.6rem);line-height:1.15;letter-spacing:-.045em;}
	.institution-heading h2 span {color:#6153ad;}
	.institution-heading > p,.biography-heading > p {width:min(100%,410px);margin:0;color:#64748b;font-size:.88rem;line-height:1.65;}
	.org-chart {padding:1.25rem;background:linear-gradient(125deg,#f5f3ff 0%,#eef4ff 100%);border:1px solid #ddd6fe;border-radius:21px;}
	.org-person {position:relative;display:grid;grid-template-columns:82px 1fr;align-items:center;gap:1.1rem;padding:1.2rem 1.4rem;background:#fff;border:1px solid #e2e8f0;border-radius:15px;box-shadow:0 8px 30px rgba(15,23,42,.04);}
	.org-dean {width:min(100%,800px);margin:0 auto;border-color:#c4b5fd;box-shadow:0 12px 28px rgba(99,102,241,.075);}
	.org-mark {display:grid;place-items:center;width:77px;height:77px;border-radius:50%;background:#f5f3ff;border:2px solid #ddd6fe;color:#4c1d95;font:700 1.65rem Georgia,serif;}
	.org-rank {margin:0 0 .45rem;color:#7c3aed;font-size:.62rem;font-weight:900;letter-spacing:.13em;}
	.org-person h3 {margin:0;color:#0f172a;font-size:clamp(1.25rem,2vw,1.8rem);letter-spacing:-.04em;line-height:1.18;}
	.org-position {margin:.45rem 0 0;color:#4c1d95;font-size:.87rem;line-height:1.5;font-weight:800;}
	.org-detail {margin:.6rem 0 0;color:#475569;font-size:.85rem;line-height:1.6;}
	.org-label {position:absolute;right:1.1rem;top:1.1rem;color:#a78bfa;font-weight:900;font-size:.62rem;letter-spacing:.1em;}
	.org-subheading {margin:.95rem 0 .65rem;text-align:center;color:#7565b1;font-size:.61rem;font-weight:900;letter-spacing:.14em;}
	.org-lower {display:grid;grid-template-columns:1fr 1fr;gap:.85rem;}
	.org-professor {align-items:start;grid-template-columns:64px minmax(0,1fr);gap:.9rem;}
	.org-professor .org-mark {width:60px;height:60px;font-size:1.25rem;}
	.org-laboratory {padding:1.2rem 1.4rem;background:#101a37;color:#e0e7ff;border-radius:15px;min-width:0;}
	.org-laboratory .org-rank {color:#c4b5fd;}
	.lab-acronym {margin:.5rem 0;color:#f5f3ff;font:700 clamp(1.7rem,3vw,2.4rem) Georgia,serif;letter-spacing:.04em;}
	.org-laboratory h3 {margin:0;color:#fff;font-size:1.01rem;line-height:1.4;}
	.org-laboratory > p:not(.org-rank) {color:#cbd5e1;margin:.65rem 0;font-size:.84rem;line-height:1.6;}
	.org-laboratory > span {display:inline-block;margin-top:.4rem;padding:.4rem .65rem;border:1px solid rgba(196,181,253,.35);border-radius:99px;color:#ddd6fe;font-size:.7rem;}
	.biography-heading {margin-top:2rem;}
	.biographies {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem;}
	.biography-card {display:flex;flex-direction:column;min-width:0;padding:clamp(1.2rem,2.2vw,1.55rem);background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 10px 32px rgba(15,23,42,.035);}
	.bio-topline {display:flex;justify-content:space-between;gap:1rem;margin-bottom:.75rem;color:#7c3aed;font-size:.61rem;font-weight:900;letter-spacing:.11em;}
	.bio-topline span:last-child {color:#64748b;text-align:right;}
	.biography-card h3 {margin:0;color:#0f172a;font-size:clamp(1.45rem,2.3vw,2rem);letter-spacing:-.045em;line-height:1.16;}
	.bio-subtitle {margin:.4rem 0 .85rem!important;color:#5b42a3!important;font-weight:800;font-size:.86rem!important;line-height:1.5!important;}
	.biography-card > p:not(.bio-subtitle):not(.bio-quote) {margin:0 0 .75rem;color:#475569;font-size:.86rem;line-height:1.65;}
	.biography-card strong {color:#0f172a;}
	.bio-works {margin-top:auto;padding:.8rem 0 .55rem;border-top:1px solid #e2e8f0;}
	.bio-works > p {margin:0 0 .6rem;color:#6d28d9;font-size:.62rem;font-weight:900;letter-spacing:.12em;}
	.bio-works ul {margin:0;padding-left:1.1rem;color:#334155;font-size:.83rem;line-height:1.65;}
	.bio-works li+li {margin-top:.2rem;}
	.bio-quote {margin:.8rem 0 0!important;padding:.8rem;border-radius:10px;background:#f5f3ff;color:#4c1d95;font:italic 700 1rem/1.6 Georgia,serif;}
	.academic-council {position:relative;display:grid;grid-template-columns:66px minmax(0,1fr);gap:1rem;align-items:start;overflow:hidden;margin-top:.85rem;padding:1.2rem 1.5rem;border:1px solid #ddd6fe;border-radius:16px;background:#f8f7ff;}
	.council-icon {font:3.3rem Georgia,serif;line-height:1;color:#8b5cf6;}
	.academic-council h3 {margin:.5rem 0;color:#0f172a;font-size:1.45rem;letter-spacing:-.03em;}
	.academic-council p:not(.kicker) {max-width:850px;margin:.4rem 0 0;color:#475569;font-size:.87rem;line-height:1.65;}
	.academic-council .council-footnote {margin-top:.6rem!important;color:#6d28d9!important;font-weight:700;}
	.council-stamp {position:absolute;right:-8px;bottom:14px;padding:.3rem .7rem;transform:rotate(-12deg);border:2px solid rgba(124,58,237,.19);color:rgba(124,58,237,.22);font-size:.68rem;font-weight:900;letter-spacing:.1em;line-height:1.15;text-align:center;pointer-events:none;}

	.publications { padding:clamp(1.4rem,2.5vw,2.2rem) 0; }
	.publication-intro {display:flex; justify-content:space-between; align-items:end; gap:1.5rem; padding:0 .5rem .95rem;}
	.publication-intro h2 {font-size:clamp(1.7rem,3vw,2.5rem);} .publication-intro > p {max-width:370px; margin:0; color:#64748b; font-size:.81rem; line-height:1.55;}
	.publications-list { display:grid; gap:.5rem; }
	.publication {display:grid; grid-template-columns:100px minmax(0,1fr) auto; align-items:center; gap:1.1rem; padding:1rem 1.25rem; border:1px solid #e2e8f0; border-radius:14px; background:white; box-shadow:0 6px 20px rgba(15,23,42,.025);}
	.publication:first-child {border-color:#c4b5fd; box-shadow:0 8px 24px rgba(99,102,241,.075);}
	.publication-number {padding-right:1rem; border-right:1px solid #e2e8f0; color:#64748b; font-size:.58rem; font-weight:900; letter-spacing:.1em; text-align:center;}
	.publication-number strong {display:block; color:#4c1d95; font-family:Georgia,serif; font-size:2.5rem; font-weight:500; letter-spacing:0; line-height:1.2;}
	.publication-status {margin:0 0 .35rem!important; color:#7c3aed!important; font-size:.6rem!important; font-weight:900; letter-spacing:.1em;}

---
import OffLayout from '../../../layouts/OffLayout.astro';

const title = 'Université de Doubaille — Les grandes pensées de l’informatique';
const description = 'Les grandes pensées de l’informatique : des traités philosophiques très sérieux sur des problèmes informatiques qui ne le sont pas.';

const publications = [
	{
		number: 'I',
		title: 'Le libre arbitre existe-t-il derrière un proxy ?',
		subtitle: 'Spinoza, Sartre et la tragédie de l’URL bloquée.',
		status: 'PUBLIÉ',
		href: '/off/universite-de-doubaille/libre-arbitre-proxy/',
	},
	{
		number: 'II',
		title: 'Je crée un ticket, donc je suis.',
		subtitle: 'Descartes et la démonstration ontologique de Jira.',
		status: 'PUBLIÉ',
		href: '/off/universite-de-doubaille/je-cree-un-ticket-donc-je-suis/',
	},
	{
		number: 'III',
		title: 'L’enfer, c’est les autres VLAN.',
		subtitle: 'Jean-Paul Sartre et la solitude du réseau segmenté.',
		status: 'À PARAÎTRE',
		href: null,
	},
	{
		number: 'IV',
		title: 'Le serveur de production a-t-il une âme ?',
		subtitle: 'Heidegger et l’angoisse du redémarrage obligatoire.',
		status: 'À PARAÎTRE',
		href: null,
	},
];
---

<OffLayout title={title} description={description}>
	<nav class="breadcrumbs" aria-label="Fil d’Ariane">
		<a href="/off/">En Off</a>
		<span aria-hidden="true">/</span>
		<span>Université de Doubaille</span>
	</nav>

	<header class="university-hero">
		<div class="hero-main">
			<p class="eyebrow">EN OFF 010 <span>·</span> ÉTABLISSEMENT D’ENSEIGNEMENT SUPÉRIEUREMENT INUTILE</p>
			<h1>Les grandes pensées <em>de l’informatique.</em></h1>
			<p class="hero-description">Des réflexions complètement absurdes, présentées avec le sérieux académique d’un colloque de philosophie à la Sorbonne.</p>
			<div class="hero-bottom">
				<span>Revue de métaphysique appliquée aux infrastructures numériques</span>
				<span class="hero-dot" aria-hidden="true"></span>
				<span>ISSN : 127.0.0.1</span>
			</div>
		</div>
		<div class="seal-area">
			<img
				class="university-seal"
				src="/Images/off/universite-doubaille-sceau.webp"
				alt="Sceau de l’Université de Doubaille — Cogito ergo ping, fondée en 127.0.0.1"
				width="1254"
				height="1254"
				decoding="async"
			/>
		</div>
	</header>

	<section class="manifesto" aria-label="Présentation de la faculté">
		<div class="manifesto-heading">
			<p class="kicker">ÉDITORIAL DU DÉPARTEMENT</p>
			<h2>Penser l’impensable.<br /><span>Et surtout l’inutile.</span></h2>
		</div>
		<div class="manifesto-copy">
			<p>Depuis des siècles, les philosophes interrogent l’être, la liberté et la condition humaine. Pourtant, aucune grande école de pensée n’a sérieusement répondu à cette question : <strong>un paquet rejeté par le firewall a-t-il néanmoins existé ?</strong></p>
			<p>L’Université de Doubaille se propose de combler cette lacune. Nos chercheurs analysent les grandes tragédies informatiques avec une méthode éprouvée : des références prestigieuses, une assurance absolue et une compréhension généralement approximative du problème.</p>
			<p class="manifesto-quote">« La rigueur de la forme ne saurait être compromise par l’absurdité du fond. »</p>
		</div>
	</section>

	<section class="faculty-teaser" aria-labelledby="faculty-teaser-title">
		<div class="faculty-teaser-heading">
			<div><p class="kicker">LA FACULTÉ · GOUVERNANCE ACADÉMIQUE</p><h2 id="faculty-teaser-title">Huit esprits brillants.<br /><span>Aucun étudiant.</span></h2></div>
			<p>Le corps professoral de Doubaille réunit les plus grandes autorités de la philosophie réseau, des identités dynamiques, de la segmentation, de l’intégrité relationnelle, de la confiance conditionnelle, des architectures en couches et de l’ontologie HTTP.</p>
		</div>
		<div class="faculty-teaser-panel">
			<div class="faculty-dean"><img class="teaser-photo" src="/Images/off/professeurs/robert-louis-dehainesse.webp" alt="" width="60" height="60" loading="lazy" decoding="async" /><span class="faculty-initial">RD</span><div><p>LE DOYEN</p><strong>Robert-Louis Dehainesse</strong><small>Autorité suprême de résolution · Légitimité en cours de propagation</small></div></div>
			<p class="faculty-group-caption">CORPS PROFESSORAL</p>
			<div class="faculty-teaser-grid">
				<div><img class="teaser-photo" src="/Images/off/professeurs/jean-michel-tecepai-hipet.webp" alt="" width="54" height="54" loading="lazy" decoding="async" /><span>JT</span><strong>Jean-Michel Técépai-Hipet</strong><small>Réseaux et libre arbitre</small></div>
				<div><img class="teaser-photo" src="/Images/off/professeurs/roger-albert-deachessepet.webp" alt="" width="54" height="54" loading="lazy" decoding="async" /><span>RD</span><strong>Roger-Albert Déachessépet</strong><small>Identité dynamique</small></div>
				<div><img class="teaser-photo" src="/Images/off/professeurs/jean-eude-velane.webp" alt="" width="54" height="54" loading="lazy" decoding="async" /><span>JV</span><strong>Jean-Eude Vélane</strong><small>Segmentation</small></div>
				<div><img class="teaser-photo" src="/Images/off/professeurs/emmanuelle-seguelane.webp" alt="" width="54" height="54" loading="lazy" decoding="async" /><span>ES</span><strong>Emmanuelle Séguelane</strong><small>Relations et bases de données</small></div>
				<div><img class="teaser-photo" src="/Images/off/professeurs/valerie-pequahi.webp" alt="" width="54" height="54" loading="lazy" decoding="async" /><span>VP</span><strong>Valérie Péquahi</strong><small>Confiance et certificats</small></div>
                <div><img class="teaser-photo" src="/Images/off/professeurs/charles-hausi.webp" alt="" width="54" height="54" loading="lazy" decoding="async" /><span>CH</span><strong>Charles Hausi</strong><small>Philosophie des sept couches</small></div>
                <div><img class="teaser-photo" src="/Images/off/professeurs/augustin-achete-taipe.webp" alt="" width="54" height="54" loading="lazy" decoding="async" /><span>AA</span><strong>Augustin Acheté-Taipé</strong><small>Métaphysique HTTP</small></div>
			</div>
			<div class="faculty-action"><span>Le conseil académique siège désormais à huit. Son quorum reste introuvable.</span><a href="/off/universite-de-doubaille/corps-professoral/">Découvrir le corps professoral <span aria-hidden="true">↗</span></a></div>
		</div>
	</section>


  <section class="administration-teaser" aria-labelledby="administration-teaser-title">
    <div class="admin-teaser-copy">
      <p class="kicker">SERVICES CENTRAUX · VIE UNIVERSITAIRE</p>
      <h2 id="administration-teaser-title">L’administration <span>au sommet de son art.</span></h2>
      <p>Une assistante du doyen qui fait confiance à tous les expéditeurs. Un CPE qui refuse toute conversation sans tunnel sécurisé. Deux piliers essentiels à la bonne marche d’une université sans étudiants.</p>
      <a href="/off/universite-de-doubaille/administration/">Découvrir l’administration et la vie universitaire <span aria-hidden="true">↗</span></a>
    </div>
    <div class="admin-teaser-people" aria-label="Membres de l’administration">
      <div><img class="teaser-photo" src="/Images/off/professeurs/martine-phishing.webp" alt="" width="54" height="54" loading="lazy" decoding="async" /><span>MP</span><strong>Martine Phishing</strong><small>Secrétariat du décanat</small></div>
      <div><img class="teaser-photo" src="/Images/off/professeurs/edgar-ipesec.webp" alt="" width="54" height="54" loading="lazy" decoding="async" /><span>EI</span><strong>Edgar Ipésec</strong><small>Vie universitaire et discipline</small></div>
    </div>
  </section>
	<section class="publications" aria-labelledby="publications-title">
		<div class="publication-intro">
			<div>
				<p class="kicker">ANNALES DE LA FACULTÉ · VOLUME 01</p>
				<h2 id="publications-title">Les traités fondamentaux</h2>
			</div>
			<p>Une publication rigoureusement évaluée par un comité scientifique dont la composition demeure confidentielle, essentiellement faute de membres.</p>
		</div>
		<div class="publications-list">
			{publications.map((publication) => (
				<article class:list={['publication', { forthcoming: !publication.href }]}>
					<div class="publication-number">TRAITÉ <strong>{publication.number}</strong></div>
					<div class="publication-content">
						<p class="publication-status">{publication.status}</p>
						<h3>{publication.title}</h3>
						<p>{publication.subtitle}</p>
					</div>
					{publication.href ? (
						<a class="publication-link" href={publication.href} aria-label={`Lire : ${publication.title}`}>Lire le traité <span aria-hidden="true">↗</span></a>
					) : (
						<span class="publication-pending" aria-label="À paraître">En expertise</span>
					)}
				</article>
			))}
		</div>
	</section>

	<section class="disclaimer" aria-label="Avis du comité scientifique">
		<div class="disclaimer-icon" aria-hidden="true">§</div>
		<div>
			<p class="kicker">AVIS DU COMITÉ SCIENTIFIQUE</p>
			<h2>Une pensée irréfutable, faute de contradicteurs habilités.</h2>
			<p>Les publications de cette faculté sont fictives, satiriques et formellement déconseillées pour la rédaction d’un dossier d’architecture. Toute ressemblance avec un comité de validation existant serait regrettable mais statistiquement plausible.</p>
		</div>
	</section>
</OffLayout>

<style>
	.breadcrumbs { display:flex; align-items:center; gap:.65rem; margin: .35rem 0 1rem; color:#64748b; font-size:.78rem; font-weight:700; }
	.breadcrumbs a { color:#4f46e5; text-decoration:none; }
	.breadcrumbs a:hover { text-decoration:underline; }
	.university-hero { display:grid; grid-template-columns:minmax(0, 1.24fr) minmax(340px, .76fr); gap:2rem; align-items:center; position:relative; overflow:hidden; min-height:395px; padding:clamp(1.5rem, 4vw, 3.5rem); background:radial-gradient(circle at 85% 18%,rgba(129,140,248,.21),transparent 26rem),linear-gradient(125deg,#050a1b 0%,#111c3a 52%,#24174e 100%); color:white; border-radius:24px; box-shadow:0 24px 70px rgba(14,17,46,.19); }
	.university-hero::before { content:''; pointer-events:none; position:absolute; inset:0; opacity:.17; background-image:linear-gradient(rgba(255,255,255,.14) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.14) 1px,transparent 1px); background-size:38px 38px; mask-image:linear-gradient(90deg, transparent, black); }
	.hero-main,.seal-area { position:relative; z-index:1; }
	.eyebrow,.kicker { margin:0; color:#6366f1; font-weight:900; font-size:.65rem; letter-spacing:.16em; line-height:1.55; }
	.eyebrow {color:#a5b4fc;} .eyebrow span {padding:0 .25rem; color:#94a3b8;}
	.university-hero h1 { max-width:750px; margin:1rem 0 1.2rem; color:white; font-size:clamp(2.25rem,4.65vw,4.4rem); letter-spacing:-.065em; line-height:1.02; }
	.university-hero h1 em { color:#c4b5fd; font-style:normal; }
	.hero-description { max-width:610px; margin:0; color:#dbeafe; font-size:clamp(.98rem,1.4vw,1.18rem); line-height:1.65; }
	.hero-bottom { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem; margin-top:2.1rem; color:#a5b4fc; font-size:.72rem; letter-spacing:.02em; }
	.hero-dot { width:3px; height:3px; border-radius:50%; background:#a5b4fc; }
	.seal-area { display:flex; align-items:center; justify-content:center; min-width:0; }
	.university-seal { display:block; width:min(100%,340px); height:auto; filter:drop-shadow(0 12px 24px rgba(2,8,23,.28)); }
	.manifesto { display:grid; grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr); gap:clamp(1.25rem,3vw,2.8rem); padding:clamp(1.4rem,2.8vw,2.3rem) .5rem; }
	.manifesto h2,.publications h2,.disclaimer h2 { margin:.5rem 0 0; color:#0f172a; letter-spacing:-.045em; line-height:1.12; }
	.manifesto h2 { font-size:clamp(1.65rem,3vw,2.7rem); }
	.manifesto h2 span { color:#6355ae; }
	.manifesto-copy p { margin:0 0 .8rem; color:#475569; font-size:.98rem; line-height:1.68; }
	.manifesto-copy strong { color:#0f172a; }
	.manifesto-copy .manifesto-quote { margin:1rem 0 0; color:#4338ca; font-family:Georgia,serif; font-size:1.08rem; font-style:italic; font-weight:700; }

	.publications { padding:clamp(1.4rem,2.5vw,2.2rem) 0; }
	.publication-intro {display:flex; justify-content:space-between; align-items:end; gap:1.5rem; padding:0 .5rem .95rem;}
	.publication-intro h2 {font-size:clamp(1.7rem,3vw,2.5rem);} .publication-intro > p {max-width:370px; margin:0; color:#64748b; font-size:.81rem; line-height:1.55;}
	.publications-list { display:grid; gap:.5rem; }
	.publication {display:grid; grid-template-columns:100px minmax(0,1fr) auto; align-items:center; gap:1.1rem; padding:1rem 1.25rem; border:1px solid #e2e8f0; border-radius:14px; background:white; box-shadow:0 6px 20px rgba(15,23,42,.025);}
	.publication:first-child {border-color:#c4b5fd; box-shadow:0 8px 24px rgba(99,102,241,.075);}
	.publication-number {padding-right:1rem; border-right:1px solid #e2e8f0; color:#64748b; font-size:.58rem; font-weight:900; letter-spacing:.1em; text-align:center;}
	.publication-number strong {display:block; color:#4c1d95; font-family:Georgia,serif; font-size:2.5rem; font-weight:500; letter-spacing:0; line-height:1.2;}
	.publication-status {margin:0 0 .35rem!important; color:#7c3aed!important; font-size:.6rem!important; font-weight:900; letter-spacing:.1em;}
	.publication h3 {margin:0; color:#0f172a; font-size:1.22rem; line-height:1.25; letter-spacing:-.025em;}
	.publication-content > p:last-child {margin:.3rem 0 0; color:#64748b; font-size:.84rem; line-height:1.4;}
	.publication-link {align-self:center; display:inline-flex; justify-content:center; align-items:center; gap:.6rem; padding:.75rem 1rem; border-radius:9px; background:#4338ca; color:white; white-space:nowrap; text-decoration:none; font-size:.76rem; font-weight:800; transition:background .2s ease,transform .2s ease;}
	.publication-link:hover {background:#312e81;transform:translateY(-2px);}
	.publication-link span {font-size:1rem;}
	.publication-pending {align-self:center; color:#94a3b8; font-size:.75rem; font-style:italic; white-space:nowrap;}
	.disclaimer {display:grid; grid-template-columns:75px 1fr; gap:1.1rem; align-items:start; margin-bottom:1.4rem; padding:1.15rem 1.4rem; background:#f1f5f9; border-left:4px solid #a78bfa; border-radius:0 12px 12px 0;}
	.disclaimer-icon {font:4rem Georgia,serif; line-height:.9; color:#a78bfa;}
	.disclaimer h2 {font-size:1.2rem;} .disclaimer p:last-child {margin:.55rem 0 0; color:#64748b; font-size:.83rem; line-height:1.6;}
	@media (max-width:850px){.university-hero{grid-template-columns:minmax(0,1fr) 215px;gap:1rem}.university-seal{width:215px}.manifesto{grid-template-columns:1fr}}
	@media (max-width:680px){.university-hero{grid-template-columns:1fr;padding:1.65rem;border-radius:18px}.seal-area{display:flex;margin-top:.6rem}.university-seal{width:min(65vw,225px)}.hero-bottom{margin-top:1.5rem}.manifesto{padding:1.5rem .25rem}.publication-intro{display:block}.publication-intro>p{margin-top:.85rem}.publication{grid-template-columns:55px 1fr;gap:.9rem;padding:1rem}.publication-number{padding-right:.5rem;font-size:.47rem}.publication-number strong{font-size:1.95rem}.publication-link,.publication-pending{grid-column:2;justify-self:start}.publication h3{font-size:1.03rem}.disclaimer{grid-template-columns:1fr;padding:1rem}.disclaimer-icon{display:none}}
	@media (prefers-reduced-motion:reduce){.publication-link{transition:none}.publication-link:hover{transform:none}}
	.faculty-teaser{margin:1.25rem 0 1.5rem;}
	.faculty-teaser-heading{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;padding:0 .4rem 1rem;}
	.faculty-teaser-heading h2{margin:.45rem 0 0;color:#0f172a;font-size:clamp(1.65rem,3vw,2.5rem);line-height:1.13;letter-spacing:-.045em;}
	.faculty-teaser-heading h2 span{color:#6252af;}
	.faculty-teaser-heading>p{max-width:500px;margin:0;color:#64748b;font-size:.88rem;line-height:1.6;}
	.faculty-teaser-panel{padding:1.15rem;border:1px solid #ddd6fe;border-radius:19px;background:linear-gradient(120deg,#f5f3ff,#eef4ff);}
	.faculty-dean{display:flex;align-items:center;gap:.9rem;width:min(100%,690px);margin:0 auto;padding:1rem 1.2rem;background:white;border:1px solid #c4b5fd;border-radius:13px;}
	.faculty-initial{display:grid;place-items:center;flex:none;width:54px;height:54px;border-radius:50%;color:#4c1d95;background:#f5f3ff;border:1px solid #ddd6fe;font:700 1.2rem Georgia,serif;}
	.faculty-dean p{margin:0 0 .2rem;color:#7c3aed;letter-spacing:.12em;font-size:.6rem;font-weight:900;}
	.faculty-dean strong{display:block;color:#0f172a;font-size:1.25rem;letter-spacing:-.035em;}
	.faculty-dean small{display:block;margin-top:.25rem;color:#64748b;line-height:1.45;font-size:.78rem;}
	.faculty-group-caption{margin:.95rem 0 .6rem;text-align:center;color:#7565b1;font-size:.61rem;font-weight:900;letter-spacing:.15em;}
	.faculty-teaser-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.6rem;}
	.faculty-teaser-grid>div{min-width:0;padding:.8rem;background:white;border:1px solid #e2e8f0;border-radius:12px;}
	.faculty-teaser-grid span{display:grid;place-items:center;width:34px;height:34px;margin-bottom:.65rem;border-radius:50%;background:#f5f3ff;color:#4c1d95;font:700 .8rem Georgia,serif;}
	.faculty-teaser-grid strong{display:block;color:#0f172a;font-size:.78rem;line-height:1.3;}
	.faculty-teaser-grid small{display:block;margin-top:.3rem;color:#64748b;font-size:.7rem;line-height:1.4;}
	.faculty-action{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:1rem;}
	.faculty-action>span{color:#64748b;font-size:.8rem;}
	.faculty-action a{display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1rem;background:#4338ca;color:white;font-size:.8rem;font-weight:800;text-decoration:none;border-radius:9px;white-space:nowrap;}
	.faculty-action a:hover{background:#312e81;}
	@media(max-width:1100px){.faculty-teaser-grid{grid-template-columns:repeat(3,minmax(0,1fr));}}
	@media(max-width:740px){.faculty-teaser-heading{flex-direction:column;align-items:start;gap:.7rem}.faculty-teaser-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.faculty-action{flex-direction:column;align-items:start}.faculty-action a{white-space:normal;}}
	@media(max-width:440px){.faculty-teaser-grid{grid-template-columns:1fr}.faculty-dean{padding:.8rem}.faculty-teaser-panel{padding:.8rem}.faculty-action a{width:100%;justify-content:center;}}

  .administration-teaser{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:1.4rem;align-items:center;padding:1.4rem 1.6rem;border:1px solid #ddd6fe;border-radius:17px;background:linear-gradient(125deg,#f8f7ff 0%,#eff4ff 100%);margin:0 0 1rem}
  .admin-teaser-copy h2{margin:.45rem 0 .55rem;color:#0f172a;font-size:clamp(1.5rem,2.6vw,2.15rem);letter-spacing:-.04em;line-height:1.18}
  .admin-teaser-copy h2 span{color:#6252af}
  .admin-teaser-copy>p:not(.kicker){max-width:560px;margin:0 0 1rem;color:#475569;font-size:.86rem;line-height:1.65}
  .admin-teaser-copy>a{display:inline-flex;align-items:center;gap:.5rem;padding:.7rem .95rem;background:#4338ca;color:#fff;border-radius:9px;text-decoration:none;font-size:.78rem;font-weight:800}
  .admin-teaser-copy>a:hover{background:#312e81}
  .admin-teaser-people{display:grid;gap:.55rem}
  .admin-teaser-people>div{display:grid;grid-template-columns:44px minmax(0,1fr);column-gap:.7rem;align-items:center;padding:.75rem .85rem;background:white;border:1px solid #e2e8f0;border-radius:11px}
  .admin-teaser-people span{grid-row:span 2;display:grid;place-items:center;width:42px;height:42px;background:#f5f3ff;border:1px solid #ddd6fe;border-radius:50%;color:#4c1d95;font:700 .9rem Georgia,serif}
  .admin-teaser-people strong{color:#0f172a;font-size:.89rem}
  .admin-teaser-people small{color:#64748b;font-size:.72rem}
  @media(max-width:740px){.administration-teaser{grid-template-columns:1fr;padding:1.15rem}.admin-teaser-copy>a{max-width:100%;white-space:normal}}
  .teaser-photo{display:block;width:54px;height:54px;object-fit:cover;background:#eae6e0;border-radius:9px;border:1px solid #ddd6fe;flex-shrink:0}
  .faculty-dean>.teaser-photo{width:60px;height:60px}
  .faculty-teaser-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
  .faculty-teaser-grid>div{display:grid;grid-template-columns:56px minmax(0,1fr);grid-template-rows:auto auto 1fr;column-gap:.65rem;align-items:start}
  .faculty-teaser-grid .teaser-photo{grid-column:1;grid-row:1/4;width:56px;height:74px}
  .faculty-teaser-grid span{grid-column:2;grid-row:1;width:29px;height:29px;margin:0 0 .2rem}
  .faculty-teaser-grid strong{grid-column:2;grid-row:2}
  .faculty-teaser-grid small{grid-column:2;grid-row:3}
  .admin-teaser-people>div{grid-template-columns:54px 35px minmax(0,1fr);column-gap:.55rem;align-items:center}
  .admin-teaser-people .teaser-photo{grid-row:1/3;grid-column:1}
  .admin-teaser-people span{grid-row:1/3;grid-column:2;width:34px;height:34px}

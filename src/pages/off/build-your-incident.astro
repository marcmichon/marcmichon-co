			const pick = (items) => items[Math.floor(Math.random() * items.length)];
			const randomOption = (select) => {
				select.selectedIndex = Math.floor(Math.random() * select.options.length);
			};

			const compatibleScenarios = () => {
				const exact = scenarios.filter((scenario) =>
					scenario.domains.includes(domain.value) &&
					scenario.intents.includes(intent.value)
				);
				if (exact.length) return exact;

				const domainMatches = scenarios.filter((scenario) =>
					scenario.domains.includes(domain.value)
				);
				return domainMatches.length ? domainMatches : fallbackScenarios;
			};

			const renderIncident = () => {
				const scenario = pick(compatibleScenarios());
				const [minChaos, maxChaos] = scenario.chaos;
				const score = Math.floor(minChaos + Math.random() * (maxChaos - minChaos + 1));
				const id = Math.floor(10000 + Math.random() * 89999);

				$('#incident-summary').textContent = scenario.summary.replace('{actor}', actor.value);
				$('#incident-impact').textContent = scenario.impact;
				$('#announced-time').textContent = scenario.announced;
				$('#real-time').textContent = scenario.real;
				$('#root-cause').textContent = scenario.cause;
				$('#lesson-learned').textContent = scenario.lesson;
				$('#chaos-score').textContent = `${score} / 100`;
				$('#incident-id').textContent = `INCIDENT · #${id}`;
			};

			$('#incident-form').addEventListener('submit', (event) => {
				event.preventDefault();
				renderIncident();
			});

			$('#randomize-button').addEventListener('click', () => {
				[actor, domain, intent].forEach(randomOption);
				renderIncident();
			});
		</script>
	</section>
</OffLayout>


---
import OffLayout from '../../layouts/OffLayout.astro';
import OffBackLink from '../../components/off/OffBackLink.astro';
import OffBadge from '../../components/off/OffBadge.astro';
---

<OffLayout
	title="Build Your Incident | EN OFF"
	description="Construisez une catastrophe informatique en quelques secondes."
>
	<OffBackLink />

	<section class="incident-shell">
		<header class="incident-heading">
			<div>
				<p class="eyebrow">EN OFF · #006</p>
				<h1>Build Your Incident</h1>
				<p class="lead">
					Construisez une catastrophe informatique en quelques secondes.
				</p>
			</div>

			<OffBadge label="CHAOS ENGINE" variant="red" />
		</header>

		<div class="incident-layout">
			<form class="builder-panel" id="incident-form">
				<div class="panel-meta">
					<span>INCIDENT VARIABLES</span>
					<span>MODE · SIMPLE CHAOS</span>
				</div>

				<label class="field">
					<span>Qui ?</span>
					<select id="actor">
						<option>Le stagiaire</option>
						<option>Le développeur</option>
						<option>Le RSSI</option>
						<option>Le DSI</option>
						<option>Le consultant</option>
						<option>L’utilisateur</option>
						<option>Le prestataire</option>
						<option>L’administrateur système</option>
						<option>Le chef de projet</option>
						<option>L’alternant</option>
						<option>Le DevOps</option>
						<option>Le support N1</option>
						<option>Le support N2</option>
						<option>Le support N3</option>
						<option>L’expert sécurité</option>
					</select>
				</label>

				<label class="field">
					<span>Sur quoi ?</span>
					<select id="domain">
						<option value="network">Réseau & firewall</option>
						<option value="identity">Identité & MFA</option>
						<option value="production">Production</option>
						<option value="backup">Sauvegarde & stockage</option>
						<option value="endpoint">Postes & utilisateurs</option>
						<option value="cloud">Cloud & DevOps</option>
						<option value="mail">Messagerie & Microsoft 365</option>
						<option value="soc">SOC & SIEM</option>
						<option value="database">Bases de données</option>
						<option value="certificate">Certificats & PKI</option>
					</select>
				</label>

				<label class="field">
					<span>Avec quelle intention ?</span>
					<select id="intent">
						<option value="simplify">Simplifier</option>
						<option value="secure">Sécuriser</option>
						<option value="speed">Gagner du temps</option>
						<option value="test">Tester rapidement</option>
						<option value="cleanup">Faire du ménage</option>
						<option value="help">Aider</option>
						<option value="optimize">Optimiser</option>
						<option value="urgent">Traiter l’urgence</option>
						<option value="planning">Respecter le planning</option>
						<option value="youtube">Faire comme dans le tuto</option>
						<option value="avoid">Éviter une réunion</option>
						<option value="normally">Parce que normalement</option>
					</select>
				</label>

				<div class="action-row">
					<button class="primary-action" type="submit">
						Générer l’incident
						<span aria-hidden="true">→</span>
					</button>

					<button class="secondary-action" id="randomize-button" type="button">
						Chaos aléatoire
						<span aria-hidden="true">↻</span>
					</button>
				</div>
			</form>

			<section class="report-panel" aria-live="polite">
				<div class="panel-meta">
					<span>INCIDENT REPORT</span>
					<span id="incident-id">INCIDENT · #84721</span>
				</div>

				<div class="summary-card">
					<span>RÉSUMÉ</span>
					<p id="incident-summary">
						Le stagiaire a supprimé toutes les règles firewall. Comme ça, il n’y a plus de conflits.
					</p>
				</div>

				<div class="report-grid">
					<div>
						<span>CONSÉQUENCES IMMÉDIATES</span>
						<strong id="incident-impact">Tout passe. Même ce qui n’avait rien demandé.</strong>
					</div>

					<div>
						<span>ESTIMATION DU CONSULTANT</span>
						<strong id="announced-time">Le temps d’un café</strong>
					</div>

					<div>
						<span>RÉALITÉ OBSERVÉE</span>
						<strong id="real-time">jusqu’à ce que quelqu’un lise les logs</strong>
					</div>

					<div>
						<span>Niveau de chaos</span>
						<strong id="chaos-score">92 / 100</strong>
					</div>
				</div>

				<div class="finding-card">
					<span>COMMENT ON EN EST ARRIVÉ LÀ</span>
					<p id="root-cause">
						Le bouton « Supprimer » était plus accessible que la documentation.
					</p>
				</div>

				<div class="finding-card">
					<span>CE QU’ON FERA PROBABLEMENT ENCORE</span>
					<p id="lesson-learned">Créer une nouvelle règle temporaire, mais mieux nommée.</p>
				</div>
			</section>
		</div>

		<aside class="disclaimer">
			<strong>Aucun système n’a été réellement impacté.</strong>
			<span>Le niveau de crédibilité reste néanmoins préoccupant.</span>
		</aside>


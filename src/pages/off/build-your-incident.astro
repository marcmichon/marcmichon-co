					impact: 'Le taux de compression est exceptionnel.',
					announced: 'Une heure',
					real: 'jusqu’à la découverte du fichier vide',
					cause: 'L’objectif de stockage était prioritaire.',
					lesson: 'Mesurer aussi la présence des données.',
					chaos: [88, 99],
				},
				{
					domains: ['endpoint'],
					intents: ['cleanup', 'help'],
					summary: '{actor} a supprimé le dossier Windows. Il prenait presque toute la place sur le disque Windows.',
					impact: 'Le disque C: respire enfin.',
					announced: 'Instantané',
					real: 'jusqu’à la réinstallation du poste et de la confiance',
					cause: 'Une optimisation menée jusqu’au bout.',
					lesson: 'Préinstaller moins de système d’exploitation.',
					chaos: [84, 97],
				},
				{
					domains: ['endpoint'],
					intents: ['speed', 'help'],
					summary: '{actor} a cliqué sur « Autoriser toujours ». « Refuser » semblait trop négatif.',
					impact: 'L’application dispose de plus de droits que l’équipe sécurité.',
					announced: 'Aucun impact',
					real: 'jusqu’à ce que l’EDR pose des questions',
					cause: 'Le bouton vert inspirait confiance.',
					lesson: 'Remplacer « Autoriser » par « J’assume ».',

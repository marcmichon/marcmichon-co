---
import type { JsonLdSchema } from '../../lib/seo/schema';

interface Props {
	schema?: JsonLdSchema | JsonLdSchema[];
}

const { schema } = Astro.props;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Prevent a value containing "</script>" from terminating the JSON-LD block.
const serialize = (value: JsonLdSchema): string =>
	JSON.stringify(value).replace(/</g, '\\u003c');
---

{
	schemas.map((item) => (
		<script
			type="application/ld+json"
			set:html={serialize(item)}
		/>
	))
}

---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<p>© {currentYear} marcmichon.co</p>

		<nav class="legal-links" aria-label="Informations légales">
			<a href="/mentions-legales/">Mentions légales</a>
			<span aria-hidden="true">·</span>
			<a href="/politique-de-confidentialite/">Politique de confidentialité</a>
			<span aria-hidden="true">·</span>
			<a href="/cookies/">Cookies</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		padding: 1.8rem 1rem;
		color: #64748b;
		background: linear-gradient(rgba(229, 233, 240, 0.5), #fff) no-repeat;
		border-top: 1px solid #e5e7eb;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.1rem;
		width: min(1320px, 100%);
		margin: 0 auto;
		text-align: center;
	}

	.footer-inner p {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 750;
	}

	.legal-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.88rem;
		flex-wrap: wrap;
	}

	.legal-links a {
		color: #64748b;
		font-size: 0.76rem;
		font-weight: 750;
		text-decoration: none;
		transition: color 0.18s ease;
	}

	.legal-links a:hover {
		color: #2563eb;
	}

	.legal-links span {
		color: #cbd5e1;
	}

	@media (max-width: 720px) {
		.footer-inner {
			flex-direction: column;
			gap: 0.7rem;
		}
	}
</style>

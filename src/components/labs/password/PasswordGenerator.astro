---
---

<section class="password-tool" data-password-generator>
	<div class="utility-grid">
		<div class="utility-main">
			<section class="panel generator-panel">
				<div class="mode-tabs" role="tablist" aria-label="Mode de génération">
					<button type="button" class="active" data-mode="password" role="tab" aria-selected="true">
						<span aria-hidden="true">▣</span>
						Mot de passe
					</button>
					<button type="button" data-mode="passphrase" role="tab" aria-selected="false">
						<span aria-hidden="true">⌘</span>
						Passphrase
					</button>
				</div>

				<div class="panel-divider"></div>

				<span class="section-label">Résultat généré</span>

				<div class="secret-box">
					<div class="secret-value" aria-live="polite">
						<span data-secret></span>
					</div>

					<button type="button" class="icon-button" data-copy-inline aria-label="Copier le résultat">
						<span aria-hidden="true">▢</span>
					</button>
				</div>

				<div class="secret-actions">
					<button type="button" class="button button-primary" data-copy>
						<span aria-hidden="true">▢</span>
						<span data-copy-label>Copier</span>
					</button>

					<button type="button" class="button button-secondary" data-generate>
						<span aria-hidden="true">↻</span>
						Régénérer
					</button>
				</div>
			</section>

			<section class="panel options-panel" data-password-options>
				<div class="panel-heading">
					<div>
						<span class="section-label">Options de génération</span>
						<h2>Configurer le mot de passe</h2>
					</div>
					<strong><span data-length-value>24</span> caractères</strong>
				</div>

				<label class="range-control">
					<span>Longueur : <strong><span data-length-copy>24</span> caractères</strong></span>
					<input type="range" min="8" max="128" value="24" data-length />
					<div class="range-bounds"><small>8</small><small>128</small></div>
				</label>

				<div class="option-grid">
					<label><input type="checkbox" data-lowercase checked /><span>Minuscules</span></label>
					<label><input type="checkbox" data-uppercase checked /><span>Majuscules</span></label>
					<label><input type="checkbox" data-numbers checked /><span>Chiffres</span></label>
					<label><input type="checkbox" data-symbols checked /><span>Symboles</span></label>
					<label class="wide"><input type="checkbox" data-ambiguous checked /><span>Exclure les caractères ambigus</span><i title="Évite 0/O, 1/l/I et caractères visuellement proches.">i</i></label>
					<label class="wide"><input type="checkbox" data-repeated checked /><span>Éviter les répétitions consécutives</span><i title="Évite deux caractères identiques consécutifs.">i</i></label>
				</div>

				<div class="ambiguous-box">
					<span>Caractères ambigus exclus</span>
					<div>
						<code>0 / O</code>
						<code>1 / l / I</code>
						<code>| / `</code>
						<code>' / "</code>
					</div>
				</div>
			</section>

			<section class="panel options-panel" data-passphrase-options hidden>
				<div class="panel-heading">
					<div>
						<span class="section-label">Options de génération</span>
						<h2>Configurer la passphrase</h2>
					</div>
					<strong><span data-word-count-value>5</span> mots</strong>
				</div>

				<label class="range-control">
					<span>Nombre de mots : <strong><span data-word-count-copy>5</span></strong></span>
					<input type="range" min="3" max="10" value="5" data-word-count />
					<div class="range-bounds"><small>3</small><small>10</small></div>
				</label>

				<div class="passphrase-grid">
					<label>
						<span>Séparateur</span>
						<select data-separator>
							<option value="-">Tiret —</option>
							<option value=".">Point .</option>
							<option value="_">Underscore _</option>
							<option value=" ">Espace</option>
						</select>
					</label>
					<label class="toggle"><input type="checkbox" data-capitalize /><span>Majuscule initiale</span></label>
					<label class="toggle"><input type="checkbox" data-append-number checked /><span>Ajouter un nombre</span></label>
				</div>
			</section>

			<p class="error" data-error hidden></p>
		</div>

		<aside class="utility-side">
			<section class="panel privacy-panel">
				<div class="shield-icon" aria-hidden="true">✓</div>
				<div>
					<span class="section-label">100 % local</span>
					<p>Aucune donnée n’est transmise.</p>
					<p>Aucun stockage. Aucun historique.</p>
					<p>Le navigateur utilise <code>crypto.getRandomValues()</code>.</p>
				</div>
			</section>

			<section class="panel assessment-panel">
				<span class="section-label">Évaluation de robustesse</span>

				<div class="strength-title">
					<div class="shield-icon small" aria-hidden="true">✓</div>
					<div>
						<h2 data-strength>Très robuste</h2>
						<p>Entropie estimée</p>
						<strong data-entropy>0 bits</strong>
					</div>
				</div>

				<div class="strength-segments" aria-hidden="true">
					<span></span><span></span><span></span><span></span><span></span>
				</div>

				<div class="metric-grid">
					<div><span>Longueur</span><strong data-size-metric>0</strong></div>
					<div><span>Entropie</span><strong data-entropy-metric>0 bits</strong></div>
					<div><span>RNG cryptographique</span><strong>Activé</strong></div>
				</div>
			</section>

			<section class="panel reason-panel">
				<span class="section-label">Pourquoi ce résultat ?</span>
				<ul data-details></ul>
			</section>

			<section class="panel suitable-panel">
				<span class="section-label">Adapté pour</span>
				<div class="suitable-grid" data-suitable></div>
			</section>
		</aside>
	</div>

	<section class="best-practices">
		<strong>Bonnes pratiques</strong>
		<span>Utilisez un gestionnaire de mots de passe pour stocker et générer vos secrets.</span>
		<span>Activez l’authentification multifacteur dès que possible.</span>
	</section>
</section>

<script>
	import {
		generatePassphrase,
		generatePassword,
	} from '../../../lib/password/generator';

	import type { GeneratedSecret, PasswordMode } from '../../../types/password';

	const root = document.querySelector<HTMLElement>('[data-password-generator]');

	if (!root) {
		throw new Error('MM Password Generator introuvable.');
	}

	const query = <T extends Element>(selector: string): T => {
		const element = root.querySelector<T>(selector);
		if (!element) throw new Error(`Élément introuvable : ${selector}`);
		return element;
	};

	let mode: PasswordMode = 'password';
	let currentSecret: GeneratedSecret | null = null;

	const secretOutput = query<HTMLElement>('[data-secret]');
	const error = query<HTMLElement>('[data-error]');
	const copyLabel = query<HTMLElement>('[data-copy-label]');

	function generate(): void {
		error.hidden = true;

		try {
			currentSecret = mode === 'password'
				? generatePassword({
						length: Number(query<HTMLInputElement>('[data-length]').value),
						lowercase: query<HTMLInputElement>('[data-lowercase]').checked,
						uppercase: query<HTMLInputElement>('[data-uppercase]').checked,
						numbers: query<HTMLInputElement>('[data-numbers]').checked,
						symbols: query<HTMLInputElement>('[data-symbols]').checked,
						excludeAmbiguous: query<HTMLInputElement>('[data-ambiguous]').checked,
						avoidRepeated: query<HTMLInputElement>('[data-repeated]').checked,
					})
				: generatePassphrase({
						wordCount: Number(query<HTMLInputElement>('[data-word-count]').value),
						separator: query<HTMLSelectElement>('[data-separator]').value as '-' | '.' | '_' | ' ',
						capitalizeWords: query<HTMLInputElement>('[data-capitalize]').checked,
						appendNumber: query<HTMLInputElement>('[data-append-number]').checked,
					});

			render(currentSecret);
		} catch (cause) {
			currentSecret = null;
			secretOutput.textContent = 'Configuration invalide';
			error.textContent = cause instanceof Error ? cause.message : 'Impossible de générer le secret.';
			error.hidden = false;
		}
	}

	function render(secret: GeneratedSecret): void {
		secretOutput.textContent = secret.value;
		query<HTMLElement>('[data-strength]').textContent = secret.strength;
		query<HTMLElement>('[data-entropy]').textContent = `${secret.entropyBits} bits`;
		query<HTMLElement>('[data-entropy-metric]').textContent = `${secret.entropyBits} bits`;
		query<HTMLElement>('[data-size-metric]').textContent = `${secret.value.length} caractères`;

		const segmentCount = secret.entropyBits >= 110 ? 4 : secret.entropyBits >= 75 ? 3 : secret.entropyBits >= 50 ? 2 : 1;
		root.querySelectorAll<HTMLElement>('.strength-segments span').forEach((segment, index) => {
			segment.classList.toggle('active', index < segmentCount);
		});

		query<HTMLElement>('[data-details]').innerHTML = secret.details
			.map((detail) => `<li>${escapeHtml(detail)}</li>`)
			.join('');

		query<HTMLElement>('[data-suitable]').innerHTML = secret.suitableFor
			.map((item) => `<div><span aria-hidden="true">✓</span><strong>${escapeHtml(item)}</strong></div>`)
			.join('');
	}

	function escapeHtml(value: string): string {
		return value.replace(/[&<>"']/g, (character) => ({
			'&': '&amp;',
			'<': '&lt;',
			'>': '&gt;',
			'"': '&quot;',
			"'": '&#039;',
		})[character] ?? character);
	}

	async function copySecret(): Promise<void> {
		if (!currentSecret) return;

		try {
			await navigator.clipboard.writeText(currentSecret.value);
			copyLabel.textContent = 'Copié ✓';
			window.setTimeout(() => {
				copyLabel.textContent = 'Copier';
			}, 1800);
		} catch {
			error.textContent = 'La copie automatique est indisponible dans ce navigateur.';
			error.hidden = false;
		}
	}

	for (const button of root.querySelectorAll<HTMLButtonElement>('[data-mode]')) {
		button.addEventListener('click', () => {
			mode = button.dataset.mode as PasswordMode;

			for (const candidate of root.querySelectorAll<HTMLButtonElement>('[data-mode]')) {
				const active = candidate === button;
				candidate.classList.toggle('active', active);
				candidate.setAttribute('aria-selected', String(active));
			}

			query<HTMLElement>('[data-password-options]').hidden = mode !== 'password';
			query<HTMLElement>('[data-passphrase-options]').hidden = mode !== 'passphrase';
			generate();
		});
	}

	query<HTMLInputElement>('[data-length]').addEventListener('input', (event) => {
		const value = (event.currentTarget as HTMLInputElement).value;
		query<HTMLElement>('[data-length-value]').textContent = value;
		query<HTMLElement>('[data-length-copy]').textContent = value;
		generate();
	});

	query<HTMLInputElement>('[data-word-count]').addEventListener('input', (event) => {
		const value = (event.currentTarget as HTMLInputElement).value;
		query<HTMLElement>('[data-word-count-value]').textContent = value;
		query<HTMLElement>('[data-word-count-copy]').textContent = value;
		generate();
	});

	for (const control of root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[type="checkbox"], select')) {
		control.addEventListener('change', generate);
	}

	query<HTMLButtonElement>('[data-generate]').addEventListener('click', generate);
	query<HTMLButtonElement>('[data-copy]').addEventListener('click', copySecret);
	query<HTMLButtonElement>('[data-copy-inline]').addEventListener('click', copySecret);

	generate();
</script>

<style>
	.password-tool {
		--navy: #071735;
		--navy-strong: #06132e;
		--blue: #2563eb;
		--blue-soft: #eff6ff;
		--line: #d8e1ef;
		--line-strong: #b9cae2;
		--surface: #ffffff;
		--surface-soft: #f8fafc;
		--text: #0f172a;
		--muted: #64748b;
		color: var(--text);
	}

	.utility-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(340px, .95fr);
		gap: 1.15rem;
		align-items: start;
	}

	.utility-main,
	.utility-side {
		display: grid;
		gap: 1rem;
	}

	.panel {
		border: 1px solid var(--line);
		border-radius: 1rem;
		background: var(--surface);
		box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
	}

	.generator-panel,
	.options-panel,
	.assessment-panel,
	.reason-panel,
	.suitable-panel {
		padding: 1.25rem;
	}

	.mode-tabs {
		display: flex;
		gap: .6rem;
	}

	.mode-tabs button {
		display: inline-flex;
		align-items: center;
		gap: .5rem;
		min-height: 2.75rem;
		border: 1px solid var(--line);
		border-radius: .65rem;
		padding: 0 1rem;
		background: white;
		color: #334155;
		font: inherit;
		font-size: .8rem;
		font-weight: 800;
		cursor: pointer;
	}

	.mode-tabs button.active {
		border-color: #1d4ed8;
		background: linear-gradient(135deg, #2563eb, #1d4ed8);
		color: white;
		box-shadow: 0 8px 18px rgba(37, 99, 235, .2);
	}

	.panel-divider {
		height: 1px;
		margin: 1.05rem -1.25rem;
		background: var(--line);
	}

	.section-label {
		display: block;
		color: var(--blue);
		font-size: .67rem;
		font-weight: 900;
		letter-spacing: .08em;
		text-transform: uppercase;
	}

	.secret-box {
		position: relative;
		margin-top: .85rem;
	}

	.secret-value {
		min-height: 4.5rem;
		display: flex;
		align-items: center;
		padding: 1rem 4rem 1rem 1rem;
		border: 1px solid var(--line-strong);
		border-radius: .75rem;
		background: #f8fbff;
		box-shadow: inset 0 1px 2px rgba(15, 23, 42, .03);
	}

	.secret-value span {
		color: #0f172a !important;
		-webkit-text-fill-color: #0f172a !important;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: clamp(1.05rem, 2vw, 1.55rem);
		font-weight: 500;
		line-height: 1.45;
		letter-spacing: .03em;
		overflow-wrap: anywhere;
	}

	.icon-button {
		position: absolute;
		top: 50%;
		right: .85rem;
		width: 2.35rem;
		height: 2.35rem;
		transform: translateY(-50%);
		border: 1px solid var(--line);
		border-radius: .55rem;
		background: white;
		color: #1e3a8a;
		font-size: 1rem;
		cursor: pointer;
	}

	.secret-actions {
		display: flex;
		gap: .65rem;
		margin-top: .9rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: .5rem;
		min-height: 2.7rem;
		border-radius: .65rem;
		padding: 0 1rem;
		font: inherit;
		font-size: .8rem;
		font-weight: 850;
		cursor: pointer;
	}

	.button-primary {
		border: 1px solid #1d4ed8;
		background: linear-gradient(135deg, #2563eb, #1d4ed8);
		color: white;
	}

	.button-secondary {
		border: 1px solid var(--line);
		background: white;
		color: #1e293b;
	}

	.panel-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.panel-heading h2 {
		margin: .35rem 0 0;
		font-size: 1rem;
	}

	.panel-heading > strong {
		color: #334155;
		font-size: .75rem;
	}

	.range-control {
		display: grid;
		gap: .7rem;
		margin-top: 1.2rem;
		color: #334155;
		font-size: .75rem;
	}

	.range-control input {
		width: 100%;
		accent-color: var(--blue);
	}

	.range-bounds {
		display: flex;
		justify-content: space-between;
		color: var(--muted);
	}

	.option-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: .6rem;
		margin-top: 1rem;
	}

	.option-grid label,
	.toggle {
		display: flex;
		align-items: center;
		gap: .55rem;
		min-height: 2.55rem;
		border: 1px solid var(--line);
		border-radius: .65rem;
		padding: .55rem .65rem;
		background: #fbfdff;
		color: #334155;
		font-size: .72rem;
		font-weight: 700;
	}

	.option-grid label.wide {
		grid-column: span 2;
	}

	.option-grid i {
		display: inline-grid;
		width: 1rem;
		height: 1rem;
		place-items: center;
		margin-left: auto;
		border: 1px solid #94a3b8;
		border-radius: 50%;
		color: #64748b;
		font-size: .6rem;
		font-style: normal;
	}

	input[type="checkbox"] {
		accent-color: var(--blue);
	}

	.ambiguous-box {
		margin-top: 1rem;
		border: 1px solid var(--line);
		border-radius: .75rem;
		padding: .85rem;
		background: var(--surface-soft);
	}

	.ambiguous-box > span {
		color: #475569;
		font-size: .68rem;
		font-weight: 850;
		letter-spacing: .06em;
		text-transform: uppercase;
	}

	.ambiguous-box div {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: .7rem;
	}

	.ambiguous-box code {
		padding: 0;
		background: transparent !important;
		color: #475569 !important;
		font-size: .72rem;
	}

	.passphrase-grid {
		display: grid;
		gap: .65rem;
		margin-top: 1rem;
	}

	.passphrase-grid > label:first-child {
		display: grid;
		gap: .4rem;
		color: #475569;
		font-size: .72rem;
		font-weight: 750;
	}

	select {
		width: 100%;
		border: 1px solid var(--line);
		border-radius: .65rem;
		padding: .75rem;
		background: white;
		color: #0f172a;
		font: inherit;
	}

	.privacy-panel {
		display: flex;
		gap: .85rem;
		padding: 1rem 1.1rem;
	}

	.shield-icon {
		display: grid;
		flex: 0 0 2.6rem;
		height: 2.9rem;
		place-items: center;
		clip-path: polygon(50% 0, 90% 15%, 85% 70%, 50% 100%, 15% 70%, 10% 15%);
		background: var(--blue);
		color: white;
		font-size: 1rem;
		font-weight: 900;
	}

	.shield-icon.small {
		flex-basis: 2.35rem;
		height: 2.6rem;
	}

	.privacy-panel p {
		margin: .2rem 0 0;
		color: #334155;
		font-size: .73rem;
		line-height: 1.45;
	}

	.privacy-panel code {
		padding: 0;
		background: transparent !important;
		color: var(--blue) !important;
		-webkit-text-fill-color: var(--blue) !important;
		font-size: .7rem;
	}

	.strength-title {
		display: flex;
		gap: .85rem;
		margin-top: 1rem;
	}

	.strength-title h2 {
		margin: 0;
		font-size: 1.35rem;
	}

	.strength-title p {
		margin: .8rem 0 .2rem;
		color: #475569;
		font-size: .7rem;
	}

	.strength-title strong {
		color: var(--blue);
		font-size: 1.25rem;
	}

	.strength-segments {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: .35rem;
		margin-top: 1rem;
	}

	.strength-segments span {
		height: .42rem;
		border: 1px solid #cbd5e1;
		border-radius: 999px;
		background: #e2e8f0;
	}

	.strength-segments span.active {
		border-color: #1d4ed8;
		background: #1d4ed8;
	}

	.metric-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: .8rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
	}

	.metric-grid div {
		display: grid;
		gap: .25rem;
	}

	.metric-grid span {
		color: #475569;
		font-size: .66rem;
	}

	.metric-grid strong {
		color: #1d4ed8;
		font-size: .76rem;
	}

	.reason-panel ul {
		display: grid;
		gap: .65rem;
		margin: .85rem 0 0;
		padding: 0;
		list-style: none;
	}

	:global(.reason-panel li) {
		position: relative;
		padding-left: 1.35rem;
		color: #334155;
		font-size: .74rem;
		line-height: 1.45;
	}

	:global(.reason-panel li)::before {
		content: "✓";
		position: absolute;
		top: 0;
		left: 0;
		display: grid;
		width: 1rem;
		height: 1rem;
		place-items: center;
		border-radius: 50%;
		background: #eff6ff;
		color: var(--blue);
		font-size: .65rem;
		font-weight: 900;
	}

	.suitable-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: .6rem;
		margin-top: .85rem;
	}

	:global(.suitable-grid > div) {
		display: flex;
		align-items: center;
		gap: .55rem;
		min-height: 3rem;
		border: 1px solid var(--line);
		border-radius: .65rem;
		padding: .55rem;
		background: #fbfdff;
	}

	:global(.suitable-grid > div span) {
		display: grid;
		width: 1.55rem;
		height: 1.55rem;
		place-items: center;
		border-radius: .45rem;
		background: #eff6ff;
		color: var(--blue);
		font-weight: 900;
	}

	:global(.suitable-grid > div strong) {
		color: #334155;
		font-size: .7rem;
	}

	.best-practices {
		display: grid;

						<span><i class="identity"></i>Identity</span>
						<span><i class="privilege"></i>Privilege</span>
						<span><i class="critical"></i>Critical</span>
					</div>
				</div>

				<div class="graph-scroll">
					<svg class="attack-graph" viewBox="0 0 1120 520" role="img" aria-labelledby="graph-title graph-desc">
						<title id="graph-title">Graphe des relations et chemins d’attaque</title>
						<desc id="graph-desc">Deux chaînes principales relient Internet à un contrôleur de domaine et à une souscription Azure de production.</desc>

						<defs>
							<marker id="arrow-muted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
								<path d="M 0 0 L 10 5 L 0 10 z" fill="#475569"></path>
							</marker>
							<marker id="arrow-active" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
								<path d="M 0 0 L 10 5 L 0 10 z" fill="#fb7185"></path>
							</marker>
							<linearGradient id="critical-flow" x1="0" x2="1">
								<stop offset="0%" stop-color="#f59e0b"></stop>
								<stop offset="100%" stop-color="#fb7185"></stop>
							</linearGradient>
						</defs>

						{edges.map((edge) => {
							const line = edgeLine(edge);
							return (
								<g class="edge" data-edge={edge.id} data-label={edge.label}>
									<line
										x1={line.x1}
										y1={line.y1}
										x2={line.x2}
										y2={line.y2}
										marker-end="url(#arrow-muted)"

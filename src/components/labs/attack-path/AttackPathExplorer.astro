---
const nodes = [
	{ id: 'internet', label: 'INTERNET', type: 'Entry Point', risk: 42, x: 80, y: 245, tone: 'entry' },
	{ id: 'web', label: 'WEB-SRV-01', type: 'Asset', risk: 87, x: 255, y: 130, tone: 'asset' },
	{ id: 'svc', label: 'svc_backup', type: 'Identity', risk: 78, x: 440, y: 130, tone: 'identity' },
	{ id: 'app', label: 'APP-SRV-02', type: 'Asset', risk: 82, x: 625, y: 130, tone: 'asset' },
	{ id: 'da', label: 'Domain Admins', type: 'Privilege', risk: 96, x: 800, y: 130, tone: 'privilege' },
	{ id: 'dc', label: 'DC-PROD-01', type: 'Critical Asset', risk: 100, x: 975, y: 130, tone: 'critical' },

	{ id: 'vpn', label: 'VPN-GW-01', type: 'Asset', risk: 68, x: 255, y: 360, tone: 'asset' },
	{ id: 'user', label: 'j.martin', type: 'Identity', risk: 54, x: 440, y: 360, tone: 'identity' },
	{ id: 'ws', label: 'IT-ADMIN-01', type: 'Asset', risk: 74, x: 625, y: 360, tone: 'asset' },
	{ id: 'azadmin', label: 'Azure Admin', type: 'Privilege', risk: 88, x: 800, y: 360, tone: 'privilege' },
	{ id: 'azure', label: 'AZ-PROD-SUB', type: 'Critical Asset', risk: 93, x: 975, y: 360, tone: 'critical' },
];

const edges = [
	{ id: 'e-inet-web', from: 'internet', to: 'web', label: 'Exploit public' },
	{ id: 'e-web-svc', from: 'web', to: 'svc', label: 'Credential reuse' },
	{ id: 'e-svc-app', from: 'svc', to: 'app', label: 'Local Admin' },
	{ id: 'e-app-da', from: 'app', to: 'da', label: 'Token / Session' },
	{ id: 'e-da-dc', from: 'da', to: 'dc', label: 'Privileged access' },

	{ id: 'e-inet-vpn', from: 'internet', to: 'vpn', label: 'Remote access' },
	{ id: 'e-vpn-user', from: 'vpn', to: 'user', label: 'Valid account' },
	{ id: 'e-user-ws', from: 'user', to: 'ws', label: 'Interactive logon' },
	{ id: 'e-ws-az', from: 'ws', to: 'azadmin', label: 'Cloud token' },
	{ id: 'e-az-sub', from: 'azadmin', to: 'azure', label: 'Owner role' },
	{ id: 'e-app-ws', from: 'app', to: 'ws', label: 'Admin tooling' },
];

const nodeById = Object.fromEntries(nodes.map((node) => [node.id, node]));

const edgeLine = (edge) => {
	const from = nodeById[edge.from];
	const to = nodeById[edge.to];
	const horizontal = Math.abs(from.y - to.y) < 50;
	const labelWidth = Math.max(76, Math.min(136, edge.label.length * 6.2 + 22));

	return {
		x1: from.x + 64,
		y1: from.y + 34,
		x2: to.x - 64,
		y2: to.y + 34,
		tx: (from.x + to.x) / 2,
		ty: horizontal ? from.y - 12 : ((from.y + to.y) / 2) - 14,
		labelWidth,
	};
};
---


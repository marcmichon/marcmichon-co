</section>

<script>
	import { exportAttackPathPdf } from '../../../lib/attack-path/pdf';

	const root = document.querySelector('[data-attack-path-explorer]');

	if (root) {
		const exploreMode = root.querySelector('[data-explore-mode]');
		const builderMode = root.querySelector('[data-builder-mode]');

		root.querySelectorAll('[data-mode]').forEach((button) => {
			button.addEventListener('click', () => {
				const mode = button.dataset.mode;
				root.querySelectorAll('[data-mode]').forEach((candidate) => {
					candidate.classList.toggle('is-active', candidate === button);
				});
				exploreMode.hidden = mode !== 'explore';
				builderMode.hidden = mode !== 'builder';
			});
		});

		const paths = {
			domain: {
				score: 91,
				state: 'Path #1 highlighted · Internet → DC-PROD-01',
				context: 'Privilege escalation chain with direct Tier 0 reachability.',
				chain: 'Internet → WEB-SRV-01 → svc_backup → APP-SRV-02 → Domain Admins → DC-PROD-01',
				nodes: ['internet', 'web', 'svc', 'app', 'da', 'dc'],
				edges: ['e-inet-web', 'e-web-svc', 'e-svc-app', 'e-app-da', 'e-da-dc'],
			},
			azure: {
				score: 76,
				state: 'Path #2 highlighted · VPN-GW-01 → AZ-PROD-SUB',
				context: 'Hybrid identity chain with privileged cloud role reachability.',
				chain: 'Internet → VPN-GW-01 → j.martin → IT-ADMIN-01 → Azure Admin → AZ-PROD-SUB',
				nodes: ['internet', 'vpn', 'user', 'ws', 'azadmin', 'azure'],
				edges: ['e-inet-vpn', 'e-vpn-user', 'e-user-ws', 'e-ws-az', 'e-az-sub'],
			},
			backup: {
				score: 58,
				state: 'Path #3 highlighted · WEB-SRV-01 → IT-ADMIN-01',
				context: 'Administrative tooling creates a secondary route into the backup control plane.',
				chain: 'Internet → WEB-SRV-01 → svc_backup → APP-SRV-02 → IT-ADMIN-01 → Backup Plane',
				nodes: ['internet', 'web', 'svc', 'app', 'ws'],
				edges: ['e-inet-web', 'e-web-svc', 'e-svc-app', 'e-app-ws'],
			},
		};

		const details = {
			internet: { type: 'Entry Point', exposure: 'Public', cves: '—', privilege: 'None', risk: 42 },
			web: { type: 'Asset', exposure: 'Internet-facing', cves: '2', privilege: 'Standard', risk: 87 },
			svc: { type: 'Identity', exposure: 'Internal', cves: '—', privilege: 'Local Admin', risk: 78 },
			app: { type: 'Asset', exposure: 'Internal', cves: '1', privilege: 'Admin tooling', risk: 82 },
			da: { type: 'Privilege', exposure: 'Tier 0', cves: '—', privilege: 'Domain Admin', risk: 96 },
			dc: { type: 'Critical Asset', exposure: 'Tier 0', cves: '0', privilege: 'Domain Control', risk: 100 },
			vpn: { type: 'Asset', exposure: 'Internet-facing', cves: '1', privilege: 'Remote access', risk: 68 },
			user: { type: 'Identity', exposure: 'Hybrid', cves: '—', privilege: 'User', risk: 54 },
			ws: { type: 'Asset', exposure: 'Privileged subnet', cves: '3', privilege: 'IT Admin', risk: 74 },
			azadmin: { type: 'Privilege', exposure: 'Cloud', cves: '—', privilege: 'Owner', risk: 88 },
			azure: { type: 'Critical Asset', exposure: 'Cloud', cves: '0', privilege: 'Production', risk: 93 },
		};

		const nodeLabels = Object.fromEntries(
			[...root.querySelectorAll('[data-node]')].map((node) => [
				node.getAttribute('data-node'),
				node.querySelector('.node-label')?.textContent || '',
			]),
		);

		let activePath = 'domain';
		let remediation = null;

		const tabs = [...root.querySelectorAll('[data-path]')];
		const nodeEls = [...root.querySelectorAll('[data-node]')];
		const edgeEls = [...root.querySelectorAll('[data-edge]')];
		const score = root.querySelector('[data-path-score]');
		const scoreFill = root.querySelector('[data-score-fill]');
		const severity = root.querySelector('[data-path-severity]');
		const pathChain = root.querySelector('[data-path-chain]');
		const pathContext = root.querySelector('[data-path-context]');
		const graphState = root.querySelector('[data-graph-state]');
		const beforeScore = root.querySelector('[data-before-score]');
		const afterScore = root.querySelector('[data-after-score]');
		const pathCount = root.querySelector('[data-path-count]');
		const reduction = root.querySelector('[data-reduction]');
		const impactTitle = root.querySelector('[data-impact-title]');
		const impactMessage = root.querySelector('[data-impact-message]');

		function severityClass(value) {
			if (value >= 85) return 'critical';
			if (value >= 70) return 'high';
			if (value >= 50) return 'medium';
			return 'low';
		}

		function showNode(id) {
			const data = details[id];
			if (!data) return;

			root.querySelector('[data-node-title]').textContent = nodeLabels[id];
			root.querySelector('[data-node-type]').textContent = data.type;
			root.querySelector('[data-node-exposure]').textContent = data.exposure;
			root.querySelector('[data-node-cves]').textContent = data.cves;
			root.querySelector('[data-node-privilege]').textContent = data.privilege;

			const risk = root.querySelector('[data-node-risk]');
			risk.textContent = `${data.risk} / 100`;
			risk.className = `risk-chip ${severityClass(data.risk)}`;

			nodeEls.forEach((node) => node.classList.toggle('is-selected', node.dataset.node === id));
		}

		function render() {
			const path = paths[activePath];
			const baseScore = path.score;
			let currentScore = baseScore;
			let brokenEdge = null;
			let currentPaths = 3;
			let reductionValue = 0;
			let title = 'Ready';
			let message = 'No remediation simulated yet.';

			if (remediation && activePath === 'domain') {
				const impacts = {
					patch: { score: 63, edge: 'e-inet-web', reduction: 31, title: 'Exposure reduced', paths: 3, message: 'Initial exposure is reduced, but the privilege chain still exists behind the entry point.' },
					privilege: { score: 34, edge: 'e-svc-app', reduction: 63, title: 'Attack path disrupted', paths: 2, message: 'The Local Admin relationship is removed. The Tier 0 path can no longer be traversed end-to-end.' },
					segment: { score: 28, edge: 'e-da-dc', reduction: 69, title: 'Critical asset isolated', paths: 2, message: 'The final privileged relationship to the domain controller is blocked by segmentation.' },
				};
				const impact = impacts[remediation];
				currentScore = impact.score;
				brokenEdge = impact.edge;
				currentPaths = impact.paths;
				reductionValue = impact.reduction;
				title = impact.title;
				message = impact.message;
			}

			nodeEls.forEach((node) => {
				const id = node.dataset.node;
				node.classList.toggle('is-path', path.nodes.includes(id));
				node.classList.toggle('is-dimmed', !path.nodes.includes(id));
			});

			edgeEls.forEach((edge) => {
				const id = edge.dataset.edge;
				const active = path.edges.includes(id);
				const isBroken = id === brokenEdge;
				edge.classList.toggle('is-path', active);
				edge.classList.toggle('is-dimmed', !active);
				edge.classList.toggle('is-broken', isBroken);

				const edgeLabel = edge.querySelector('[data-edge-label]');
				if (edgeLabel) edgeLabel.textContent = isBroken ? 'BLOCKED' : edge.dataset.label;
			});

			tabs.forEach((tab) => {
				const selected = tab.dataset.path === activePath;
				tab.classList.toggle('is-active', selected);
				tab.setAttribute('aria-selected', String(selected));
			});

			score.textContent = String(currentScore);
			scoreFill.style.width = `${currentScore}%`;
			severity.textContent = currentScore < 50 ? 'LOW' : currentScore < 70 ? 'MEDIUM' : currentScore < 85 ? 'HIGH' : 'CRITICAL';
			severity.className = `severity ${severityClass(currentScore)}`;
			pathChain.textContent = path.chain;
			pathContext.textContent = path.context;
			graphState.textContent = brokenEdge ? `${title} · relationship blocked` : path.state;
			beforeScore.textContent = String(baseScore);
			afterScore.textContent = String(currentScore);
			pathCount.textContent = String(currentPaths);
			reduction.textContent = `${reductionValue}%`;
			impactTitle.textContent = title;
			impactMessage.textContent = message;

			root.querySelectorAll('[data-remediation]').forEach((button) => {
				button.classList.toggle('is-active', button.dataset.remediation === remediation);
				button.disabled = activePath !== 'domain';
			});

			root.querySelector('[data-impact-panel]').classList.toggle('has-impact', Boolean(remediation && activePath === 'domain'));
		}

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				activePath = tab.dataset.path;
				remediation = null;
				render();
				showNode(paths[activePath].nodes[1] || paths[activePath].nodes[0]);
			});
		});

		nodeEls.forEach((node) => {
			const select = () => showNode(node.dataset.node);
			node.addEventListener('click', select);
			node.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					select();
				}
			});
		});

		root.querySelectorAll('[data-remediation]').forEach((button) => {
			button.addEventListener('click', () => {
				if (activePath !== 'domain') return;
				remediation = button.dataset.remediation;
				render();
			});
		});

		root.querySelector('[data-reset]').addEventListener('click', () => {
			remediation = null;
			render();
		});

		// Guided + Custom builder
		const groups = ['entry', 'asset', 'identity', 'privilege', 'target'];
		let builderView = 'guided';

		function selected(group) {
			return root.querySelector(`[data-choice-group="${group}"] .choice.is-selected`);
		}

		function applyBuilderScore(finalScore) {
			root.querySelector('[data-builder-score]').textContent = String(finalScore);
			root.querySelector('[data-builder-score-fill]').style.width = `${finalScore}%`;

			const severityLabel = finalScore >= 85 ? 'CRITICAL' : finalScore >= 70 ? 'HIGH' : finalScore >= 50 ? 'MEDIUM' : 'LOW';
			const severityEl = root.querySelector('[data-builder-severity]');
			severityEl.textContent = severityLabel;
			severityEl.className = `risk-chip ${severityClass(finalScore)}`;
			root.querySelector('[data-builder-exposure]').textContent =
				severityLabel[0] + severityLabel.slice(1).toLowerCase();
		}

		function renderGeneratedPath(items) {
			const generatedPath = root.querySelector('[data-generated-path]');
			generatedPath.replaceChildren();

			items.forEach((item, index) => {
				const node = document.createElement('div');
				node.className = `generated-node ${item.tone}`;
				const type = document.createElement('span');
				type.textContent = item.type.toUpperCase();
				const name = document.createElement('strong');
				name.textContent = item.name || 'Unnamed node';
				node.append(type, name);
				generatedPath.appendChild(node);

				if (index < items.length - 1) {
					const relation = document.createElement('div');
					relation.className = 'generated-relation';
					const label = document.createElement('span');
					label.textContent = item.relation || 'Relationship';
					const line = document.createElement('i');
					relation.append(label, line);
					generatedPath.appendChild(relation);
				}
			});
		}

		function updateBuilder() {
			const picks = Object.fromEntries(groups.map((group) => [group, selected(group)]));
			const rawScore = groups.reduce((total, group) => total + Number(picks[group]?.dataset.score || 0), 0);
			const finalScore = Math.min(99, Math.max(28, rawScore));

			renderGeneratedPath([
				{ type: 'Entry', name: picks.entry.dataset.choice, relation: picks.entry.dataset.rel, tone: 'entry' },
				{ type: 'Asset', name: picks.asset.dataset.choice, relation: picks.asset.dataset.rel, tone: 'asset' },
				{ type: 'Identity', name: picks.identity.dataset.choice, relation: picks.identity.dataset.rel, tone: 'identity' },
				{ type: 'Privilege', name: picks.privilege.dataset.choice, relation: picks.privilege.dataset.rel, tone: 'privilege' },
				{ type: 'Critical Asset', name: picks.target.dataset.choice, relation: '', tone: 'critical' },
			]);

			applyBuilderScore(finalScore);
			root.querySelector('[data-builder-relations]').textContent = '4';
			root.querySelector('[data-builder-target]').textContent = 'Reachable';

			const choke = `${picks.identity.dataset.choice} → ${picks.privilege.dataset.choice}`;
			root.querySelector('[data-choke-point]').textContent = choke;
			root.querySelector('[data-choke-copy]').textContent =
				`Breaking the ${picks.identity.dataset.rel.toLowerCase()} relationship removes the strongest privilege transition in this generated path.`;
		}

		root.querySelectorAll('[data-choice-group]').forEach((group) => {
			group.querySelectorAll('.choice').forEach((button) => {
				button.addEventListener('click', () => {
					group.querySelectorAll('.choice').forEach((candidate) => candidate.classList.remove('is-selected'));
					button.classList.add('is-selected');
					updateBuilder();
				});
			});
		});

		const customTypes = [
			['Entry Point', 8, 'entry'],
			['Asset', 12, 'asset'],
			['Server', 14, 'asset'],
			['Workstation', 10, 'asset'],
			['Identity', 12, 'identity'],
			['Service Account', 17, 'identity'],
			['Privilege', 18, 'privilege'],
			['Cloud Resource', 15, 'asset'],
			['Network Device', 13, 'asset'],
			['Critical Asset', 22, 'critical'],
		];

		const customRelations = [
			['Exploit public', 16],
			['Remote access', 11],
			['Valid account', 10],
			['Credential exposure', 14],
			['Credential reuse', 13],
			['Has session', 12],
			['Interactive logon', 9],
			['Local Admin', 16],
			['Admin To', 18],
			['Privilege escalation', 18],
			['Privileged access', 20],
			['Cloud privilege', 17],
			['Owner role', 19],
			['Controls', 18],
		];

		let customNodes = [
			{ type: 'Entry Point', name: 'Internet', relation: 'Exploit public' },
			{ type: 'Server', name: 'WEB-SRV-01', relation: 'Credential exposure' },
			{ type: 'Service Account', name: 'svc_backup', relation: 'Local Admin' },
			{ type: 'Privilege', name: 'Domain Admin', relation: 'Privileged access' },
			{ type: 'Critical Asset', name: 'DC-PROD-01', relation: '' },
		];

		const customList = root.querySelector('[data-custom-node-list]');

		function customTypeMeta(type) {
			const match = customTypes.find(([label]) => label === type) || customTypes[1];
			return { score: match[1], tone: match[2] };
		}

		function relationScore(relation) {
			return (customRelations.find(([label]) => label === relation) || ['', 8])[1];
		}

		function renderCustomEditor() {
			customList.replaceChildren();

			customNodes.forEach((item, index) => {
				const row = document.createElement('div');
				row.className = 'custom-node-row';

				const head = document.createElement('div');
				head.className = 'custom-node-head';
				const indexBadge = document.createElement('span');
				indexBadge.textContent = String(index + 1).padStart(2, '0');
				const headText = document.createElement('div');
				const headStrong = document.createElement('strong');
				headStrong.textContent = index === 0 ? 'Entry point' : index === customNodes.length - 1 ? 'Target node' : 'Path node';
				const headSmall = document.createElement('small');
				headSmall.textContent = 'Type + free text label';
				headText.append(headStrong, headSmall);
				head.append(indexBadge, headText);

				if (customNodes.length > 2 && index > 0 && index < customNodes.length - 1) {
					const remove = document.createElement('button');
					remove.type = 'button';
					remove.className = 'remove-node-button';
					remove.textContent = 'REMOVE';
					remove.addEventListener('click', () => {
						customNodes.splice(index, 1);
						renderCustomEditor();
						updateCustomBuilder();
					});
					head.appendChild(remove);
				}

				const fields = document.createElement('div');
				fields.className = 'custom-fields';

				const typeSelect = document.createElement('select');
				typeSelect.setAttribute('aria-label', `Node ${index + 1} type`);
				customTypes.forEach(([label]) => {
					const option = document.createElement('option');
					option.value = label;
					option.textContent = label;
					option.selected = label === item.type;
					typeSelect.appendChild(option);
				});
				typeSelect.addEventListener('change', () => {
					item.type = typeSelect.value;
					updateCustomBuilder();
				});

				const nameInput = document.createElement('input');
				nameInput.type = 'text';
				nameInput.value = item.name;
				nameInput.placeholder = 'Asset, account, role…';
				nameInput.setAttribute('aria-label', `Node ${index + 1} name`);
				nameInput.addEventListener('input', () => {
					item.name = nameInput.value;
					updateCustomBuilder();
				});

				fields.append(typeSelect, nameInput);
				row.append(head, fields);

				if (index < customNodes.length - 1) {
					const relationWrap = document.createElement('div');
					relationWrap.className = 'custom-relation';
					const relationLabel = document.createElement('span');
					relationLabel.textContent = 'RELATIONSHIP';
					const relationSelect = document.createElement('select');
					customRelations.forEach(([label]) => {
						const option = document.createElement('option');
						option.value = label;
						option.textContent = label;
						option.selected = label === item.relation;
						relationSelect.appendChild(option);
					});
					relationSelect.addEventListener('change', () => {
						item.relation = relationSelect.value;
						updateCustomBuilder();
					});
					relationWrap.append(relationLabel, relationSelect);
					row.appendChild(relationWrap);
				}

				customList.appendChild(row);
			});

			root.querySelector('[data-add-custom-node]').disabled = customNodes.length >= 8;
		}

		function updateCustomBuilder() {
			const items = customNodes.map((item) => {
				const meta = customTypeMeta(item.type);
				return { ...item, tone: meta.tone };
			});

			renderGeneratedPath(items);

			const nodeScore = customNodes.reduce((total, item) => total + customTypeMeta(item.type).score, 0);
			const relScore = customNodes.slice(0, -1).reduce((total, item) => total + relationScore(item.relation), 0);
			const finalScore = Math.min(99, Math.max(28, Math.round((nodeScore + relScore) * 0.95)));
			applyBuilderScore(finalScore);

			root.querySelector('[data-builder-relations]').textContent = String(Math.max(0, customNodes.length - 1));
			const lastType = customNodes[customNodes.length - 1]?.type || '';
			root.querySelector('[data-builder-target]').textContent = lastType === 'Critical Asset' ? 'Reachable' : 'Defined';

			let strongestIndex = 0;
			let strongestScore = -1;
			customNodes.slice(0, -1).forEach((item, index) => {
				const value = relationScore(item.relation);
				if (value > strongestScore) {
					strongestScore = value;
					strongestIndex = index;
				}
			});

			const from = customNodes[strongestIndex]?.name || 'Node';
			const to = customNodes[strongestIndex + 1]?.name || 'Node';
			const relation = customNodes[strongestIndex]?.relation || 'relationship';
			root.querySelector('[data-choke-point]').textContent = `${from} → ${to}`;
			root.querySelector('[data-choke-copy]').textContent =
				`Breaking the ${relation.toLowerCase()} relationship removes the strongest transition in this custom path.`;
		}

		root.querySelector('[data-add-custom-node]').addEventListener('click', () => {
			if (customNodes.length >= 8) return;
			const last = customNodes.pop();
			customNodes.push({ type: 'Asset', name: `NODE-${String(customNodes.length + 1).padStart(2, '0')}`, relation: 'Admin To' });
			customNodes.push(last);
			renderCustomEditor();
			updateCustomBuilder();
		});

		root.querySelectorAll('[data-builder-view]').forEach((button) => {
			button.addEventListener('click', () => {
				builderView = button.dataset.builderView;
				root.querySelectorAll('[data-builder-view]').forEach((candidate) => {
					candidate.classList.toggle('is-active', candidate === button);
				});

				const isCustom = builderView === 'custom';
				root.querySelector('[data-guided-builder]').hidden = isCustom;
				root.querySelector('[data-custom-builder]').hidden = !isCustom;
				root.querySelector('[data-builder-kicker]').textContent =
					isCustom ? 'CUSTOM ATTACK PATH BUILDER' : 'GUIDED ATTACK PATH BUILDER';
				root.querySelector('[data-builder-description]').textContent = isCustom
					? 'Définissez librement vos actifs et identités. Le moteur conserve des types et relations structurés pour construire et scorer le chemin.'
					: 'Choisissez simplement les éléments du scénario. Le moteur construit le chemin et calcule automatiquement son niveau d’exposition.';

				if (isCustom) {
					renderCustomEditor();
					updateCustomBuilder();
				} else {
					updateBuilder();
				}
			});
		});


		function normalizePdfTone(type) {
			const normalized = String(type || '').toLowerCase();
			if (normalized.includes('entry')) return 'entry';
			if (normalized.includes('identity') || normalized.includes('account')) return 'identity';
			if (normalized.includes('privilege') || normalized.includes('admin')) return 'privilege';
			if (normalized.includes('critical')) return 'critical';
			return 'asset';
		}

		function scenarioLabel(pathId) {
			if (pathId === 'azure') return 'Azure Production';
			if (pathId === 'backup') return 'Backup Infrastructure';
			return 'Domain Controller';
		}

		function exploreChokePoint(pathId) {
			if (pathId === 'azure') return 'IT-ADMIN-01 → Azure Admin';
			if (pathId === 'backup') return 'APP-SRV-02 → IT-ADMIN-01';
			return 'svc_backup → APP-SRV-02';
		}

		function buildExplorePdfReport() {
			const path = paths[activePath];
			const pdfNodes = path.nodes.map((id) => {
				const info = details[id] || {};
				return {
					type: info.type || 'Asset',
					name: nodeLabels[id] || id,
					tone: normalizePdfTone(info.type),
				};
			});
			const pdfRelations = path.edges.map((id) => {
				const edge = edgeEls.find((item) => item.dataset.edge === id);
				return { label: edge?.dataset.label || 'Relationship' };
			});

			let remediationReport = null;
			if (remediation && activePath === 'domain') {
				const actionButton = root.querySelector(`[data-remediation="${remediation}"]`);
				remediationReport = {
					title: actionButton?.querySelector('strong')?.textContent?.trim() || 'Remediation simulation',
					beforeScore: Number(beforeScore.textContent || path.score),
					afterScore: Number(afterScore.textContent || score.textContent || path.score),
					reduction: Number(String(reduction.textContent || '0').replace('%', '')) || 0,
					remainingPaths: Number(pathCount.textContent || 3),
					message: impactMessage.textContent?.trim() || 'Remediation simulated.',
				};
			}

			return {
				mode: 'Explore scenario',
				scenario: scenarioLabel(activePath),
				score: Number(score.textContent || path.score),
				severity: severity.textContent?.trim() || 'Unknown',
				context: pathContext.textContent?.trim() || path.context,
				chokePoint: exploreChokePoint(activePath),
				nodes: pdfNodes,
				relations: pdfRelations,
				remediation: remediationReport,
			};
		}

		function buildBuilderPdfReport() {
			const nodeElements = [...root.querySelectorAll('[data-generated-path] .generated-node')];
			const relationElements = [...root.querySelectorAll('[data-generated-path] .generated-relation span')];
			const pdfNodes = nodeElements.map((element) => {
				const type = element.querySelector('span')?.textContent?.trim() || 'Asset';
				return {
					type,
					name: element.querySelector('strong')?.textContent?.trim() || 'Unnamed node',
					tone: normalizePdfTone(type),
				};
			});
			const pdfRelations = relationElements.map((element) => ({
				label: element.textContent?.trim() || 'Relationship',
			}));
			const scoreValue = Number(root.querySelector('[data-builder-score]')?.textContent || 0);
			const severityValue = root.querySelector('[data-builder-severity]')?.textContent?.trim() || 'Unknown';
			const targetName = pdfNodes.at(-1)?.name || 'Attack Path';

			return {
				mode: builderView === 'custom' ? 'Custom builder' : 'Guided builder',
				scenario: targetName,
				score: scoreValue,
				severity: severityValue,
				context: builderView === 'custom'
					? 'Chemin construit librement à partir de nodes nommés par l’analyste et de relations structurées.'
					: 'Chemin construit à partir du modèle guidé MM Attack Path Explorer.',
				chokePoint: root.querySelector('[data-choke-point]')?.textContent?.trim() || '',
				nodes: pdfNodes,
				relations: pdfRelations,
				remediation: null,
			};
		}

		root.querySelector('[data-export-explore-pdf]')?.addEventListener('click', () => {
			exportAttackPathPdf(buildExplorePdfReport());
		});

		root.querySelector('[data-export-builder-pdf]')?.addEventListener('click', () => {
			exportAttackPathPdf(buildBuilderPdfReport());
		});

		showNode('web');
		render();
		updateBuilder();
	}
</script>

<style>
	.attack-path-shell { position: relative; isolation: isolate; }
	.attack-path-shell::before {
		content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: .25;
		background-image: linear-gradient(rgba(148,163,184,.018) 1px,transparent 1px), linear-gradient(90deg,rgba(148,163,184,.018) 1px,transparent 1px);
		background-size: 48px 48px; mask-image: linear-gradient(to bottom,black,transparent 80%);
	}
	.hero { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:2rem; align-items:end; padding:2rem 0 2.4rem; border-bottom:1px solid rgba(148,163,184,.14); }
	.eyebrow,.micro-label { margin:0; font-size:.72rem; font-weight:900; letter-spacing:.16em; text-transform:uppercase; color:#60a5fa; }
	h1 { margin:.7rem 0 1rem; font-size:clamp(3rem,7vw,6.4rem); line-height:.92; letter-spacing:-.06em; color:#f8fafc; }
	.lead { max-width:820px; margin:0; font-size:clamp(1rem,2vw,1.25rem); line-height:1.75; color:#cbd5e1; }
	.hero-tags { display:flex; flex-wrap:wrap; gap:.6rem; margin-top:1.5rem; }
	.hero-tags span,.legend span { display:inline-flex; align-items:center; gap:.45rem; padding:.45rem .7rem; border:1px solid rgba(148,163,184,.14); border-radius:999px; background:rgba(15,23,42,.6); color:#94a3b8; font-size:.76rem; font-weight:800; }
	.hero-status { display:flex; align-items:center; gap:.8rem; min-width:180px; padding:.9rem 1rem; border:1px solid rgba(34,197,94,.2); border-radius:16px; background:rgba(5,46,22,.16); }
	.status-orb,.signal-dot { width:10px; height:10px; border-radius:50%; background:#22c55e; box-shadow:0 0 18px rgba(34,197,94,.7); }
	.hero-status span,.hero-status strong { display:block; }
	.hero-status span { font-size:.62rem; letter-spacing:.12em; color:#64748b; }
	.hero-status strong { margin-top:.15rem; color:#bbf7d0; font-size:.83rem; }

	.mode-switch { display:grid; grid-template-columns:1fr 1fr; gap:.8rem; padding:1rem 0 0; }
	.mode-button { display:grid; grid-template-columns:auto 1fr; column-gap:.8rem; row-gap:.15rem; align-items:center; padding:1rem; border:1px solid rgba(148,163,184,.12); border-radius:16px; background:rgba(15,23,42,.35); color:#cbd5e1; text-align:left; cursor:pointer; }
	.mode-button > span { grid-row:1/3; display:grid; place-items:center; width:38px; height:38px; border-radius:10px; background:rgba(59,130,246,.1); color:#60a5fa; font-size:.7rem; font-weight:900; }

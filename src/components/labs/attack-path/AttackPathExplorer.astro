									<g class="relation-badge" transform={`translate(${line.tx} ${line.ty})`}>
										<rect
											x={-line.labelWidth / 2}
											y="-12"
											width={line.labelWidth}
											height="24"
											rx="8"
										></rect>
										<text data-edge-label x="0" y="4">{edge.label}</text>
									</g>
								</g>
							);
						})}

						{nodes.map((node) => (
							<g
								class={`node node-${node.tone}`}
								data-node={node.id}
								transform={`translate(${node.x - 64} ${node.y})`}

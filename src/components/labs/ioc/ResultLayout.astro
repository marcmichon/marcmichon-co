<section class="results" data-ioc-results>
  <div class="empty-state" data-empty-state>
    <span class="pulse"></span>
    <div>
      <strong>Prêt pour l’analyse</strong>
      <p>Collez un contenu dans le moteur ci-dessus pour générer le rapport d’investigation.</p>
    </div>
  </div>

  <div class="result-content" data-result-content hidden>
    <section class="report-header">
      <div>
        <span class="kicker">IOC Intelligence Report</span>
        <div class="title-line">
          <h2 data-report-title>Investigation recommandée</h2>
          <span class="priority-badge">Haute priorité</span>
        </div>
        <p data-report-subtitle>IOC uniques détectés pour investigation.</p>
      </div>

      <div class="export-area">
        <button type="button" class="copy-all" data-copy-all>Copier les IOC</button>
        <button type="button" data-export="json">JSON</button>
        <button type="button" data-export="csv">CSV</button>
        <button type="button" data-export="txt">TXT</button>
        <button type="button" class="pdf-button" data-export-pdf>PDF</button>
      </div>
    </section>

    <div class="report-flow">
      <section class="panel assessment-panel">
        <header>
          <div>
            <span class="phase-label">01 · Understand</span>
            <span class="kicker">Executive Assessment</span>
            <h3>Que dois-je retenir ?</h3>
            <p class="section-intent">Distinguer les faits observés, leur interprétation technique et la décision proposée.</p>
          </div>
          <span class="assessment" data-assessment>Investigation recommandée</span>
        </header>

        <div class="assessment-metrics">
          <article><span>IOC observés</span><div><strong data-metric="unique">0</strong><b>indicateurs uniques</b></div><small data-metric-caption="unique"></small></article>
          <article><span>Couverture</span><div><strong data-metric="types">0</strong><b>familles d’IOC</b></div><small data-metric-caption="types"></small></article>
          <article><span>Contexte interne</span><div><strong data-metric="private">0</strong><b>IP privées</b></div><small data-private-caption>Aucune IP interne détectée</small></article>
          <article><span>Réduction du bruit</span><div><strong data-metric="duplicates">0</strong><b>doublons retirés</b></div><small>Normalisation appliquée avant investigation</small></article>
        </div>

        <div class="assessment-body">
          <section class="analysis-layer observation-block">
            <span class="story-step">Observation</span>
            <h4>Ce qui est présent dans les données</h4>
            <ul class="observation-list" data-observations></ul>
          </section>

          <section class="analysis-layer interpretation-block">
            <span class="story-step">Interprétation</span>
            <h4>Ce que ces éléments permettent de vérifier</h4>
            <div class="narrative" data-summary></div>
          </section>

          <section class="decision-box">
            <div>
              <span>Conclusion</span>
              <strong data-decision>IOC exploitables</strong>
            </div>
            <div>
              <span>Raisonnement</span>
              <p data-rationale></p>
            </div>
          </section>
        </div>

        <p class="processing" data-processing></p>
      </section>

      <section class="panel investigation-panel">
        <header>
          <div>
            <span class="phase-label">02 · Investigate</span>
            <span class="kicker">Investigation Playbook</span>
            <h3>Par quoi commencer ?</h3>
            <p class="section-intent">Chaque étape précise son objectif, les sources à interroger et le résultat attendu.</p>
          </div>
          <div class="generated"><span>Généré</span><strong data-generated></strong></div>
        </header>
        <div class="recommendations" data-recommendations></div>
        <footer><span class="pulse"></span><div><strong>Engineering guidance</strong><p>Les actions proposées doivent être adaptées à votre télémétrie, à votre périmètre et à la criticité des systèmes concernés.</p></div></footer>
      </section>

      <section class="panel details-panel">
        <header>
          <div>
            <span class="phase-label">03 · Evidence</span>
            <span class="kicker">Technical Evidence</span>
            <h3>Sur quoi repose cette analyse ?</h3>
            <p class="section-intent">Examiner, filtrer et exploiter les observables normalisés ayant servi à construire le rapport.</p>
          </div>
          <div class="table-tools">
            <label><span aria-hidden="true">⌕</span><input type="search" data-filter placeholder="Rechercher un IOC…" /></label>
            <select data-type-filter aria-label="Filtrer par type"><option value="">Tous les types</option></select>
          </div>
        </header>
        <div class="ioc-table" role="table">
          <div class="table-head" role="row"><span>Type</span><span>Indicateur</span><span>Contexte</span><span>Statut</span><span>Actions</span></div>
          <div data-ioc-rows></div>
        </div>
        <div class="table-footer"><span data-result-count></span><span>Analyse locale · aucune transmission</span></div>
      </section>

      <section class="report-closing-grid">
        <section class="panel action-panel">
          <span class="phase-label">04 · Act</span>
          <span class="kicker">Continue Investigation</span>
          <h3>Que puis-je faire maintenant ?</h3>
          <p class="section-intent">Prolonger l’investigation dans les outils qui détiennent la télémétrie et le contexte.</p>
          <div class="quick-actions">
            <article><span class="action-icon blue">⌕</span><div><strong>Rechercher dans le SIEM</strong><p>Corréler les IOC dans les logs DNS, proxy et firewall.</p></div><b>›</b></article>
            <article><span class="action-icon green">◇</span><div><strong>Vérifier dans l’EDR</strong><p>Rechercher les IOC dans les activités et processus.</p></div><b>›</b></article>
            <article><span class="action-icon violet">◎</span><div><strong>Analyser le domaine</strong><p>WHOIS, DNS, réputation et historique d’hébergement.</p></div><b>›</b></article>
            <article><span class="action-icon amber">◇</span><div><strong>Soumettre aux Threat Intel</strong><p>Enrichissement et contexte de menace.</p></div><b>›</b></article>
          </div>
        </section>

        <section class="panel metadata-panel">
          <span class="phase-label">05 · Report</span>
          <span class="kicker">Report Traceability</span>
          <h3>Comment partager ou archiver ?</h3>
          <p class="section-intent">Conserver les éléments nécessaires à l’archivage, au partage et à la reproductibilité.</p>
          <dl>
            <div><dt>Généré le</dt><dd data-meta-date></dd></div>
            <div><dt>Outil</dt><dd data-tool-version>MM IOC Analyzer</dd></div>
            <div><dt>Hash du rapport</dt><dd><code data-report-hash></code></dd></div>
            <div><dt>Mode</dt><dd>Analyse locale (aucun envoi)</dd></div>
          </dl>
          <div class="confidential">▣ Rapport confidentiel – Usage interne uniquement</div>
        </section>
      </section>
    </div>
  </div>
</section>

<script>
import type {
  IocAnalysisResult,
  IocItem,
  IocStatus,
  IocType,
  IocTypeCounts,
} from '../../../types/ioc';

import { analyzeIocText } from '../../../lib/ioc/analyzer';
import { downloadIocPdf } from '../../../lib/ioc/iocPdf';
import {
  downloadIocReport,
  serializeIocReportToText,
} from '../../../lib/ioc/serialize';

const TYPES: readonly IocType[] = [
  'IPv4',
  'IPv6',
  'Domain',
  'URL',
  'Email',
  'MD5',
  'SHA-1',
  'SHA-256',
  'SHA-512',
];

function queryElement<T extends Element>(
  selector: string,
  parent: ParentNode = document,
): T {
  const element = parent.querySelector<T>(selector);

  if (!element) {
    throw new Error(`Élément IOC introuvable : ${selector}`);
  }

  return element;
}

const root = queryElement<HTMLElement>('[data-ioc-results]');
const form = queryElement<HTMLFormElement>('[data-ioc-form]');
const input = queryElement<HTMLTextAreaElement>('[data-ioc-input]');
const error = queryElement<HTMLElement>('[data-ioc-error]');

let analysisResult: IocAnalysisResult | null = null;
let displayedItems: IocItem[] = [];

function escapeHtml(value: unknown): string {
  return String(value).replace(
    /[&<>"']/g,
    (character) =>
      ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;',
      })[character] ?? character,
  );
}

function plural(
  count: number,
  singular: string,
  pluralForm = `${singular}s`,
): string {
  return count > 1 ? pluralForm : singular;
}

function createTypeCounts(items: readonly IocItem[]): IocTypeCounts {
  const counts: IocTypeCounts = {};

  for (const item of items) {
    counts[item.type] = (counts[item.type] ?? 0) + 1;
  }

  return counts;
}

/**
 * Produit une copie du rapport tenant compte des éventuelles suppressions
 * réalisées dans le tableau. L'analyse source et son hash restent inchangés.
 */
function getCurrentResult(): IocAnalysisResult | null {
  if (!analysisResult) {
    return null;
  }

  const typeCounts = createTypeCounts(displayedItems);
  const privateIps = displayedItems.filter(
    (item) =>
      (item.type === 'IPv4' || item.type === 'IPv6') &&
      item.status === 'private',
  ).length;

  const extractedDomains = displayedItems.filter(
    (item) => item.type === 'Domain' && item.origin === 'extracted',
  ).length;

  return {
    ...analysisResult,
    items: [...displayedItems],
    typeCounts,
    metrics: {
      ...analysisResult.metrics,
      unique: displayedItems.length,
      privateIps,
      extractedDomains,
      detectedTypes: Object.keys(typeCounts).length,
    },
  };
}

function formatDate(value: string): string {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return new Intl.DateTimeFormat('fr-FR', {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(date);
}

function getStatusLabel(status: IocStatus): string {
  const labels: Record<IocStatus, string> = {
    public: 'PUBLIC',
    private: 'PRIVATE',
    loopback: 'LOOPBACK',
    'link-local': 'LINK-LOCAL',
    reserved: 'RÉSERVÉ',
    known: 'VALIDE',
    unknown: 'INCONNU',
  };

  return labels[status];
}

function getContextLabel(item: IocItem): string {
  if (item.origin === 'extracted') {
    return 'Domaine extrait d’URL';
  }

  if (item.status === 'private') {
    return 'Infrastructure interne';
  }

  if (item.status === 'loopback') {
    return 'Adresse de loopback';
  }

  if (item.status === 'link-local') {
    return 'Adresse link-local';
  }

  if (item.status === 'reserved') {
    return 'Plage réservée / documentation';
  }

  if (item.type === 'URL') {
    return item.metadata.extension
      ? `Ressource .${item.metadata.extension}`
      : 'URL complète';
  }

  if (
    item.type === 'MD5' ||
    item.type === 'SHA-1' ||
    item.type === 'SHA-256' ||
    item.type === 'SHA-512'
  ) {
    return 'Empreinte de fichier';
  }

  if (item.type === 'Email') {
    return 'Identité / messagerie';
  }

  if (item.type === 'Domain') {
    return 'Domaine observable';
  }

  if (item.context) {
    return item.context;
  }

  return 'Infrastructure publique';
}

function createSummaryParagraphs(result: IocAnalysisResult): string[] {
  const types = TYPES.filter((type) => (result.typeCounts[type] ?? 0) > 0);
  const paragraphs: string[] = [];
  const unique = result.items.length;
  const typeCount = types.length;

  paragraphs.push(
    `L’analyse a identifié <strong>${unique} ${plural(unique, 'IOC unique')}</strong> ` +
      `réparti${unique > 1 ? 's' : ''} en <strong>${typeCount} ${plural(typeCount, 'catégorie')}</strong>.`,
  );

  if (types.length > 0) {
    paragraphs.push(
      `Les indicateurs comprennent : <strong>${types.join(', ')}</strong>.`,
    );
  }

  const hasUrl = (result.typeCounts.URL ?? 0) > 0;
  const hasHash = ['MD5', 'SHA-1', 'SHA-256', 'SHA-512'].some(
    (type) => (result.typeCounts[type as IocType] ?? 0) > 0,
  );

  if (hasUrl && hasHash) {
    paragraphs.push(
      'La présence simultanée d’URL et d’empreintes de fichiers fournit une base solide pour rechercher un téléchargement, une exécution ou une distribution de contenu.',
    );
  } else if (hasUrl) {
    paragraphs.push(
      'Les URL conservent le chemin de la ressource contactée et apportent davantage de contexte que le domaine seul.',
    );
  }

  if (result.metrics.privateIps > 0) {
    paragraphs.push(
      `<strong>${result.metrics.privateIps} ${plural(result.metrics.privateIps, 'adresse IP privée')}</strong> ` +
        `${result.metrics.privateIps > 1 ? 'ont' : 'a'} été détectée${result.metrics.privateIps > 1 ? 's' : ''}. ` +
        'Elles doivent être rapprochées de l’inventaire interne.',
    );
  }

  if (result.metrics.duplicatesRemoved > 0) {
    paragraphs.push(
      `${result.metrics.duplicatesRemoved} ${plural(result.metrics.duplicatesRemoved, 'doublon')} ` +
        `${result.metrics.duplicatesRemoved > 1 ? 'ont' : 'a'} été supprimé${result.metrics.duplicatesRemoved > 1 ? 's' : ''}, réduisant le bruit avant investigation.`,
    );
  }

  paragraphs.push(
    'Cette analyse constitue une <strong>aide à la qualification</strong>, pas un verdict de malveillance.',
  );

  return paragraphs;
}

function createObservationItems(result: IocAnalysisResult): string[] {
  const types = TYPES.filter((type) => (result.typeCounts[type] ?? 0) > 0);
  const observations = [
    `${result.items.length} ${plural(result.items.length, 'indicateur unique')} après normalisation.`,
    `${types.length} ${plural(types.length, 'famille')} représentée${types.length > 1 ? 's' : ''} : ${types.join(', ') || 'aucune'}.`,
  ];

  if (result.metrics.privateIps > 0) {
    observations.push(
      `${result.metrics.privateIps} ${plural(result.metrics.privateIps, 'adresse IP privée')} à rapprocher de l’inventaire interne.`,
    );
  }

  if (result.metrics.duplicatesRemoved > 0) {
    observations.push(
      `${result.metrics.duplicatesRemoved} ${plural(result.metrics.duplicatesRemoved, 'doublon')} retiré${result.metrics.duplicatesRemoved > 1 ? 's' : ''} avant investigation.`,
    );
  }

  return observations;
}

function getRecommendationPlaybook(title: string, description: string): {
  domain: string;
  objective: string;
  sources: string[];
  expected: string;
} {
  const text = `${title} ${description}`.toLowerCase();

  if (/siem|dns|proxy|firewall|réseau|network/.test(text)) {
    return {
      domain: 'NETWORK',
      objective: 'Identifier les communications associées aux observables et les systèmes concernés.',
      sources: ['DNS', 'Proxy', 'Firewall', 'NetFlow'],
      expected: 'Hôtes sources, premières et dernières occurrences, volume et direction des communications.',
    };
  }

  if (/edr|endpoint|process|fichier|hash|exécution/.test(text)) {
    return {
      domain: 'ENDPOINT',
      objective: 'Déterminer si un fichier, un processus ou une activité liée aux IOC est présent sur les postes.',
      sources: ['EDR', 'Process events', 'File events', 'Device timeline'],
      expected: 'Machines impactées, chaîne d’exécution, utilisateur associé et mécanisme de persistance éventuel.',
    };
  }

  if (/threat|intel|réputation|whois|domaine|enrich/.test(text)) {
    return {
      domain: 'THREAT INTEL',
      objective: 'Qualifier la réputation, l’historique et les relations connues des observables publics.',
      sources: ['Threat Intel', 'WHOIS', 'Passive DNS', 'Sandbox'],
      expected: 'Contexte de menace, infrastructure liée, ancienneté et niveau de confiance des sources.',
    };
  }

  return {
    domain: 'VALIDATION',
    objective: 'Confirmer le contexte technique avant de conclure ou d’engager une action de réponse.',
    sources: ['SIEM', 'EDR', 'Inventaire', 'Tickets'],
    expected: 'Éléments factuels permettant de confirmer, infirmer ou requalifier l’hypothèse.',
  };
}

function renderRecommendations(result: IocAnalysisResult): void {
  const container = queryElement<HTMLElement>('[data-recommendations]', root);

  container.innerHTML = result.recommendations
    .map((recommendation, index) => {
      const playbook = getRecommendationPlaybook(
        recommendation.title,
        recommendation.description,
      );

      return `
        <article class="recommendation">
          <div class="recommendation-rail">
            <span>${String(index + 1).padStart(2, '0')}</span>
            <small>P${Math.min(recommendation.order, 2)}</small>
          </div>
          <div class="recommendation-content">
            <div class="recommendation-heading">
              <span class="domain-badge">${escapeHtml(playbook.domain)}</span>
              <strong>${escapeHtml(recommendation.title)}</strong>
            </div>
            <p class="recommendation-description">${escapeHtml(recommendation.description)}</p>
            <div class="playbook-grid">
              <div><small>Pourquoi</small><p>${escapeHtml(playbook.objective)}</p></div>
              <div><small>Sources</small><p class="source-list">${playbook.sources.map((source) => `<b>${escapeHtml(source)}</b>`).join('')}</p></div>
              <div><small>Résultat attendu</small><p>${escapeHtml(playbook.expected)}</p></div>
            </div>
          </div>
        </article>
      `;
    })
    .join('');
}

function renderTypeFilter(result: IocAnalysisResult): void {
  const select = queryElement<HTMLSelectElement>('[data-type-filter]', root);
  const previousValue = select.value;
  const availableTypes = TYPES.filter(
    (type) => (result.typeCounts[type] ?? 0) > 0,
  );

  select.innerHTML = [
    '<option value="">Tous les types</option>',
    ...availableTypes.map(
      (type) => `<option value="${escapeHtml(type)}">${escapeHtml(type)}</option>`,
    ),
  ].join('');

  if (availableTypes.includes(previousValue as IocType)) {
    select.value = previousValue;
  }
}

function renderRows(): void {
  const currentResult = getCurrentResult();

  if (!currentResult) {
    return;
  }

  const searchValue = queryElement<HTMLInputElement>('[data-filter]', root)
    .value.trim()
    .toLowerCase();

  const selectedType = queryElement<HTMLSelectElement>(
    '[data-type-filter]',
    root,
  ).value;

  const rows = currentResult.items.filter((item) => {
    const matchesSearch =
      !searchValue ||
      item.value.toLowerCase().includes(searchValue) ||
      item.rawValue.toLowerCase().includes(searchValue) ||
      item.type.toLowerCase().includes(searchValue) ||
      getContextLabel(item).toLowerCase().includes(searchValue);

    const matchesType = !selectedType || item.type === selectedType;

    return matchesSearch && matchesType;
  });

  queryElement<HTMLElement>('[data-ioc-rows]', root).innerHTML = rows
    .map((item) => {
      const typeClass = item.type.replace(/[^a-z0-9]/gi, '').toLowerCase();
      const statusClass = item.status.replace(/[^a-z0-9-]/gi, '').toLowerCase();

      return `
        <div class="table-row" role="row" data-row-id="${escapeHtml(item.id)}">
          <span><b class="type-badge type-${typeClass}">${escapeHtml(item.type)}</b></span>
          <code>${escapeHtml(item.value)}</code>
          <span class="context">${escapeHtml(getContextLabel(item))}</span>
          <span><b class="status ${statusClass}">${escapeHtml(getStatusLabel(item.status))}</b></span>
          <span class="row-actions">
            <button type="button" data-action="copy" title="Copier" aria-label="Copier">□</button>
            <button type="button" data-action="defang" title="Defang" aria-label="Defang">◇</button>
            <button type="button" data-action="delete" title="Supprimer" aria-label="Supprimer">⌫</button>
          </span>
        </div>
      `;
    })
    .join('');

  queryElement<HTMLElement>('[data-result-count]', root).textContent =
    `Affichage de ${rows.length} ${plural(rows.length, 'résultat')}`;
}

function renderReport(): void {
  const currentResult = getCurrentResult();

  if (!currentResult) {
    return;
  }

  queryElement<HTMLElement>('[data-empty-state]', root).hidden = true;
  queryElement<HTMLElement>('[data-result-content]', root).hidden = false;

  queryElement<HTMLElement>('[data-report-title]', root).textContent =
    currentResult.assessment.title;

  queryElement<HTMLElement>('.priority-badge', root).textContent =
    currentResult.assessment.priorityLabel;

  queryElement<HTMLElement>('[data-report-subtitle]', root).textContent =
    `${currentResult.items.length} ${plural(currentResult.items.length, 'IOC unique')} détecté${currentResult.items.length > 1 ? 's' : ''} pour investigation.`;

  queryElement<HTMLElement>('[data-assessment]', root).textContent =
    currentResult.assessment.title;

  queryElement<HTMLElement>('[data-observations]', root).innerHTML =
    createObservationItems(currentResult)
      .map((observation) => `<li>${escapeHtml(observation)}</li>`)
      .join('');

  queryElement<HTMLElement>('[data-summary]', root).innerHTML =
    createSummaryParagraphs(currentResult)
      .slice(2)
      .map((paragraph) => `<p>${paragraph}</p>`)
      .join('');

  queryElement<HTMLElement>('[data-decision]', root).textContent =
    currentResult.assessment.decision;

  queryElement<HTMLElement>('[data-rationale]', root).textContent =
    currentResult.assessment.rationale;

  queryElement<HTMLElement>('[data-metric="unique"]', root).textContent =
    String(currentResult.metrics.unique);

  queryElement<HTMLElement>('[data-metric-caption="unique"]', root).textContent =
    `Sur ${currentResult.metrics.rawDetected} détectés`;

  queryElement<HTMLElement>('[data-metric="types"]', root).textContent =
    String(currentResult.metrics.detectedTypes);

  queryElement<HTMLElement>('[data-metric-caption="types"]', root).textContent =
    TYPES.filter((type) => (currentResult.typeCounts[type] ?? 0) > 0).join(', ') ||
    'Aucun type';

  queryElement<HTMLElement>('[data-metric="private"]', root).textContent =
    String(currentResult.metrics.privateIps);

  const privateCaption = root.querySelector<HTMLElement>('[data-private-caption]');
  if (privateCaption) {
    privateCaption.textContent = currentResult.metrics.privateIps > 0
      ? 'À corréler avec les actifs et zones internes'
      : 'Aucune adresse interne détectée';
  }

  queryElement<HTMLElement>('[data-metric="duplicates"]', root).textContent =
    String(currentResult.metrics.duplicatesRemoved);

  queryElement<HTMLElement>('[data-processing]', root).textContent =
    `${currentResult.metrics.normalized} normalisé${currentResult.metrics.normalized > 1 ? 's' : ''} · ` +
    `${currentResult.metrics.extractedDomains} domaine${currentResult.metrics.extractedDomains > 1 ? 's' : ''} extrait${currentResult.metrics.extractedDomains > 1 ? 's' : ''} · ` +
    `${currentResult.metrics.ignored} ignoré${currentResult.metrics.ignored > 1 ? 's' : ''}`;

  const generatedAt = formatDate(currentResult.metadata.generatedAt);

  queryElement<HTMLElement>('[data-generated]', root).textContent = generatedAt;
  queryElement<HTMLElement>('[data-meta-date]', root).textContent = generatedAt;
  queryElement<HTMLElement>('[data-report-hash]', root).textContent =
    `${currentResult.metadata.reportHash.slice(0, 12)}…`;

  const toolVersion = root.querySelector<HTMLElement>('[data-tool-version]');

  if (toolVersion) {
    toolVersion.textContent = `MM IOC Analyzer v${currentResult.metadata.toolVersion}`;
  }

  renderRecommendations(currentResult);
  renderTypeFilter(currentResult);
  renderRows();
}

async function runAnalysis(rawSource: string): Promise<void> {
  const submitButton = form.querySelector<HTMLButtonElement>('[type="submit"]');

  try {
    submitButton?.setAttribute('disabled', '');
    form.setAttribute('aria-busy', 'true');

    analysisResult = await analyzeIocText(rawSource);
    displayedItems = [...analysisResult.items];

    renderReport();

    root.scrollIntoView({
      behavior: 'smooth',
      block: 'start',
    });
  } catch (caughtError) {
    console.error('MM IOC Analyzer:', caughtError);

    error.hidden = false;
    error.textContent =
      caughtError instanceof Error
        ? caughtError.message
        : 'Une erreur est survenue pendant l’analyse.';
  } finally {
    submitButton?.removeAttribute('disabled');
    form.removeAttribute('aria-busy');
  }
}

form.addEventListener('submit', async (event) => {
  event.preventDefault();

  const rawSource = input.value.trim();

  if (!rawSource) {
    error.hidden = false;
    input.focus();
    return;
  }

  error.hidden = true;

  await runAnalysis(rawSource);
});

queryElement<HTMLInputElement>('[data-filter]', root).addEventListener(
  'input',
  renderRows,
);

queryElement<HTMLSelectElement>('[data-type-filter]', root).addEventListener(
  'change',
  renderRows,
);

root.addEventListener('click', async (event) => {
  if (!(event.target instanceof Element)) {
    return;
  }

  const button = event.target.closest<HTMLButtonElement>('button');

  if (!button) {
    return;
  }

  const currentResult = getCurrentResult();

  if (!currentResult) {
    return;
  }

  if (button.hasAttribute('data-copy-all')) {
    await navigator.clipboard.writeText(
      serializeIocReportToText(currentResult, {
        valueMode: 'defanged',
        includeContext: false,
        includeMetadata: false,
        includeRecommendations: false,
      }),
    );

    return;
  }

  const exportFormat = button.dataset.export;

  if (
    exportFormat === 'json' ||
    exportFormat === 'csv' ||
    exportFormat === 'txt'
  ) {
    downloadIocReport(currentResult, exportFormat, {
      valueMode: exportFormat === 'txt' ? 'defanged' : 'normalized',
    });

    return;
  }

  if (button.hasAttribute('data-export-pdf')) {
    downloadIocPdf(currentResult, {
      valueMode: 'defanged',
      includeContext: true,
      includeMetadata: false,
      includeRecommendations: true,
      includeSourceText: false,
    });

    return;
  }

  const row = button.closest<HTMLElement>('[data-row-id]');
  const itemId = row?.dataset.rowId;

  if (!itemId) {
    return;
  }

  const item = displayedItems.find((candidate) => candidate.id === itemId);

  if (!item) {
    return;
  }

  if (button.dataset.action === 'copy') {
    await navigator.clipboard.writeText(item.value);
    return;
  }

  if (button.dataset.action === 'defang') {
    await navigator.clipboard.writeText(item.defangedValue);
    return;
  }

  if (button.dataset.action === 'delete') {
    displayedItems = displayedItems.filter(
      (candidate) => candidate.id !== item.id,
    );

    renderReport();
  }
});
</script>


<script>
  const input = document.querySelector('[data-ioc-input]');
  const lineCount = document.querySelector('[data-line-count]');
  const characterCount = document.querySelector('[data-character-count]');
  const lineNumbers = document.querySelector('[data-line-numbers]');

  const examples = {
    incident: `Incident report — Suspicious activity detected\nSource IP: 198.51.100.44\nInternal pivot: 192.168.10.25\nC2 domain: incident.example[.]com\nObserved URL: hxxps://incident.example[.]com/payload.bin\nSHA256: 7a6f4c2e8d1b3095f4a6c8e2d7b1f0953c8a4e6d2f1b7095c3e8a6d4b2f10795`,
    phishing: `Phishing alert\nSender: security-update[@]example[.]org\nLink: hxxps://login.example[.]org/auth/session\nObserved IP: 203.0.113.101\nDomain: login.example[.]org\nSHA1: 7c4a8d09ca3762af61e59520943dc26494f8941b`,
    raw: `192.0.2.10\n192.168.1.25\nportal.example[.]net\nhxxps://portal.example[.]net/dropper.js\n0123456789abcdef0123456789abcdef`,
  };

  const pluralize = (value, singular, plural = `${singular}s`) =>
    value > 1 ? plural : singular;

  const updateEditorMetadata = () => {
    if (!(input instanceof HTMLTextAreaElement)) return;

    const lines = input.value ? input.value.split(/\r?\n/) : [];
    const totalLines = lines.length;
    const totalCharacters = input.value.length;

    if (lineCount) {
      lineCount.textContent = `${totalLines} ${pluralize(totalLines, 'ligne')}`;
    }

    if (characterCount) {
      characterCount.textContent = `${totalCharacters} ${pluralize(totalCharacters, 'caractère')}`;
    }

    if (lineNumbers) {
      lineNumbers.textContent = totalLines
        ? Array.from({ length: totalLines }, (_, index) => index + 1).join('\n')
        : '1';
    }
  };

  input?.addEventListener('input', updateEditorMetadata);

  document.querySelectorAll('[data-example]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(input instanceof HTMLTextAreaElement)) return;

      const exampleKey = button.getAttribute('data-example');
      input.value = exampleKey && exampleKey in examples
        ? examples[exampleKey]
        : '';

      updateEditorMetadata();
      input.focus();
    });
  });

  updateEditorMetadata();
</script>

---
interface Props {
	eyebrow?: string;
	title?: string;
	lead?: string;
	closing?: string;
}

const {
	eyebrow = 'UNE AUTRE PARTIE DU SITE',
	title = 'EN OFF',
	lead = 'Parce qu’il n’y a pas que les projets sérieux.',
	closing = 'Bienvenue dans le reste.',
} = Astro.props;
---

<section class="off-hero">
	<p class="eyebrow">{eyebrow}</p>
	<h1>{title}</h1>
	<p class="lead">{lead}</p>
	<p class="closing">{closing}</p>
</section>

<style>
	.off-hero {
		position: relative;
		min-height: 360px;
		padding: clamp(2rem, 7vw, 5rem);
		overflow: hidden;
		color: #ffffff;
		background:
			radial-gradient(circle at 78% 22%, rgba(124, 58, 237, 0.18), transparent 28%),
			radial-gradient(circle at 96% 92%, rgba(37, 99, 235, 0.2), transparent 28%),
			linear-gradient(135deg, #020817 0%, #07142c 58%, #11113a 100%);
		border-radius: 28px;
		box-shadow: 0 24px 58px rgba(2, 8, 23, 0.18);
	}

	.off-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
		background-size: 44px 44px;
		mask-image: linear-gradient(to right, transparent, black);
		pointer-events: none;
	}

	.off-hero > * {
		position: relative;
		z-index: 1;
	}

	.eyebrow {
		margin: 0;
		color: #60a5fa;
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.75rem 0 0;
		color: #ffffff;
		font-size: clamp(4rem, 12vw, 8.5rem);
		line-height: 0.86;
		letter-spacing: -0.075em;
	}

	.lead {
		margin: 2rem 0 0;
		color: #e2e8f0;
		font-size: clamp(1.15rem, 2.5vw, 1.65rem);
		font-weight: 750;
	}

	.closing {
		margin: 0.35rem 0 0;
		color: #ffffff;
		font-size: clamp(1.4rem, 3.2vw, 2.25rem);
		font-weight: 850;
		letter-spacing: -0.03em;
	}

	@media (max-width: 760px) {
		.off-hero {
			min-height: 300px;
			border-radius: 22px;
		}
	}
</style>

---
import { Image } from 'astro:assets';
import heroPortrait from '../assets/home/site-moi2.png';
---

<section class="hero-premium">
	<div class="hero-grid">
		<div class="hero-text">
			<h1>Marc Michon</h1>

			<p class="role">Cybersecurity Engineer</p>

			<div class="champion">
				<img src="/Images/R7.svg" alt="Rapid7" />
				<span>Rapid7 Tech Champion</span>
			</div>

			<p class="intro">
				Architecture, intégration et exploitation de plateformes de cybersécurité
				pour améliorer la visibilité, la détection et la réduction de la surface d’attaque.
			</p>

			<div class="actions" aria-label="Accès rapides">
				<a href="/notes-de-terrain" class="primary">Notes de terrain</a>
<a href="/carnet-de-terrain" class="carnet">
					Recevoir le Carnet de Terrain
				</a>
				<a href="mailto:michon.marc@gmail.com" class="secondary">
					Me contacter
				</a>

				
			</div>
		</div>

		<div class="hero-photo">
			<Image
                src={heroPortrait}
                alt="Marc Michon"
                width={260}
                densities={[1, 2]}
                quality={82}
                priority
            />
		</div>

		<div class="hero-domains" aria-label="Domaines d’expertise">
			<div>Vulnerability<br />Management</div>
			<div>Exposure<br />Management</div>
			<div>Security<br />Operations</div>
			<div>Threat<br />Intelligence</div>
		</div>
	</div>
</section>

<style>
	.hero-premium {
		position: relative;
		overflow: hidden;
		padding: 5rem 4rem 6.5rem;
		color: white;
		background:
			radial-gradient(circle at 35% 40%, rgba(37, 99, 235, 0.35), transparent 30%),
			linear-gradient(135deg, #020817 0%, #06142d 45%, #031b4d 100%);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(230px, 0.72fr) minmax(190px, 0.72fr);
		align-items: center;
		gap: 3rem;
		max-width: 1320px;
		margin: 0 auto;
	}

	.hero-text {
		min-width: 0;
		color: white;
	}

	h1 {
		margin: 0;
		color: white;
		font-size: clamp(4.6rem, 6.6vw, 5.7rem);
		font-weight: 900;
		line-height: 0.95;
		letter-spacing: -0.05em;
		white-space: nowrap;
	}

	.role {
		margin: 0.8rem 0 1.4rem;
		color: #3b82f6;
		font-size: 2.65rem;
		font-weight: 800;
		line-height: 1.1;
	}

	.champion {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0 0 2.35rem;
		color: #60a5fa;
		font-size: 1.35rem;
		font-weight: 800;
	}

	.champion img {
		display: block;
		width: auto;
		height: 25px;
	}

	.intro {
		max-width: 660px;
		margin: 0;
		color: #dbeafe;
		font-size: 1.12rem;
		line-height: 1.85;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2.5rem;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0.78rem 1.05rem;
		color: white;
		font-size: 0.86rem;
		font-weight: 800;
		line-height: 1.25;
		text-align: center;
		text-decoration: none;
		border: 1px solid transparent;
		border-radius: 11px;
		transition:
			transform 0.18s ease,
			background 0.18s ease,
			border-color 0.18s ease,
			box-shadow 0.18s ease;
	}

	.actions a:hover {
		transform: translateY(-2px);
	}

	.actions .primary {
		background: #2563eb;
		box-shadow: 0 12px 26px rgba(37, 99, 235, 0.24);
	}

	.actions .primary:hover {
		background: #1d4ed8;
		box-shadow: 0 16px 30px rgba(37, 99, 235, 0.3);
	}

	.actions .secondary {
		background: rgba(255, 255, 255, 0.025);
		border-color: rgba(255, 255, 255, 0.28);
	}

	.actions .secondary:hover {
		background: rgba(255, 255, 255, 0.07);
		border-color: rgba(255, 255, 255, 0.48);
	}

	.actions .carnet {
		background: rgba(37, 99, 235, 0.08);
		border-color: #60a5fa;
		box-shadow: inset 0 0 0 1px rgba(96, 165, 250, 0.18);
	}

	.actions .carnet:hover {
		background: rgba(37, 99, 235, 0.18);
		border-color: #93c5fd;
	}

	.hero-photo {
		display: flex;
		justify-content: center;
		min-width: 0;
	}

	.hero-photo img {
		display: block;
		width: 260px;
		height: auto;
		aspect-ratio: 17 / 21;
		object-fit: cover;
		object-position: center;
		border-radius: 24px;
		box-shadow: 0 28px 58px rgba(0, 0, 0, 0.35);
	}

	.hero-domains {
		display: grid;
		gap: 1rem;
		color: #e5edff;
		font-size: 0.84rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.hero-domains div {
		padding: 1rem;
		background: rgba(255, 255, 255, 0.04);
		border-left: 2px solid #2563eb;
		border-radius: 13px;
	}

	@media (max-width: 1180px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr) minmax(230px, 0.65fr);
		}

		.hero-domains {
			display: none;
		}

		h1 {
			font-size: 4.7rem;
		}
	}

	@media (max-width: 900px) {
		.hero-premium {
			padding: 4rem 1.5rem;
		}

		.hero-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		h1 {
			font-size: 3.4rem;
			white-space: normal;
		}

		.role {
			font-size: 2rem;
		}

		.hero-photo {
			justify-content: flex-start;
		}

		.hero-photo img {
			width: min(260px, 72vw);
		}
	}

	@media (max-width: 560px) {
		.hero-premium {
			padding: 3.25rem 1.25rem;
		}

		h1 {
			font-size: 2.85rem;
		}

		.role {
			font-size: 1.7rem;
		}

		.champion {
			font-size: 1.08rem;
		}

		.intro {
			font-size: 1rem;
			line-height: 1.7;
		}

		.actions {
			display: grid;
			grid-template-columns: 1fr;
		}

		.actions a {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.actions a {
			transition: none;
		}

		.actions a:hover {
			transform: none;
		}
	}
</style>
